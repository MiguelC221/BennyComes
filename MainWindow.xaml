                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding CloseEqualizerCommand}">
                            <TextBlock Text="Listo" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

