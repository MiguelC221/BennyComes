<ui:FluentWindow x:Class="BenyComes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:BenyComes.ViewModels"
        xmlns:views="clr-namespace:BenyComes.Views"
        xmlns:models="clr-namespace:BenyComes.Models"
        mc:Ignorable="d"
        Title="BennyComes"
        Height="820" Width="1240" MinHeight="500" MinWidth="480"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="OnWindowDrop"
        SizeChanged="OnWindowSizeChanged"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Reusable Track Context Menu -->
        <ContextMenu x:Key="TrackContextMenu" Opened="OnTrackContextMenuOpened">
            <MenuItem Header="Reproducir ahora"
                      Command="{Binding PlayTrackNowCommand, Source={x:Static vm:MainViewModel.Instance}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Reproducir siguiente (Play Next)"
                      Command="{Binding PlayNextCommand, Source={x:Static vm:MainViewModel.Instance}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="ArrowRight24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Ir a artista"
                      Command="{Binding NavigateToArtistCommand, Source={x:Static vm:MainViewModel.Instance}}"
                      CommandParameter="{Binding Artist}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Person24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Ir a álbum"
                      Command="{Binding NavigateToAlbumCommand, Source={x:Static vm:MainViewModel.Instance}}"
                      CommandParameter="{Binding Album}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Album24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Agregar a la cola"
                      Command="{Binding AddTrackToQueueCommand, Source={x:Static vm:MainViewModel.Instance}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Añadir a lista de reproducción" SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="List24" />
                </MenuItem.Icon>
                <MenuItem Header="+ Nueva lista de reproducción..." />
            </MenuItem>
            <Separator />
            <MenuItem Header="Marcar / Desmarcar Favorito ♥"
                      Command="{Binding ToggleFavoriteCommand, Source={x:Static vm:MainViewModel.Instance}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Heart24" Foreground="#E81123" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Ver información de la pista (Propiedades)"
                      Command="{Binding ShowTrackPropertiesCommand, Source={x:Static vm:MainViewModel.Instance}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Info24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Eliminar pista"
                      Command="{Binding DeleteTrackCommand, Source={x:Static vm:MainViewModel.Instance}}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" Foreground="#E81123" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Vertical Graphic Equalizer Slider Style (Physical Studio Console aesthetic) -->
        <Style x:Key="VerticalEqSliderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="160" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid HorizontalAlignment="Center" Width="36" Background="Transparent">
                            <!-- Track line in center -->
                            <Border Width="4" CornerRadius="2" Height="140" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.45" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- PART_Track with custom circular Thumb -->
                            <Track x:Name="PART_Track" HorizontalAlignment="Center" VerticalAlignment="Stretch">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="22" Height="22">
                                                    <!-- Outer White Circle with subtle depth shadow -->
                                                    <Ellipse Fill="#FFFFFF" Width="20" Height="20" Stroke="#E0E0E0" StrokeThickness="1">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.45" ShadowDepth="2" />
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <!-- Inner Accent Dot -->
                                                    <Ellipse Fill="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Custom Window TitleBar (collapses in NowPlaying) -->
            <RowDefinition Height="*" />    <!-- Main Shell (NavPane + ContentFrame + Overlay) -->
            <RowDefinition Height="Auto" /> <!-- Persistent Bottom MiniPlayerBar -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: CUSTOM TITLEBAR (TRANSPARENT IN NOWPLAYING WITH — □ ✕)  -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Height="38" Panel.ZIndex="200" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Top-Left Back Button (Full Height of TitleBar) + BennyComes Brand Header (Hidden in Reproducción en curso) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Stretch">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNowPlayingActive}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- Full-Height Back Button (<-) -->
                <Button Command="{Binding GoBackCommand}"
                        IsEnabled="{Binding CanGoBack}"
                        Width="46" Height="38" VerticalAlignment="Stretch"
                        Cursor="Hand" ToolTip="Regresar a la pantalla anterior">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BackBtnBorder" Background="Transparent" Width="46" Height="38">
                                <ui:SymbolIcon x:Name="BackBtnIcon" Symbol="ArrowLeft24" FontSize="16"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="BackBtnIcon" Property="Opacity" Value="0.28" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsEnabled" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="BackBtnBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                </MultiTrigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BackBtnBorder" Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- BennyComes Logo & Name -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,12,0">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="BennyComes" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Top-Left "Volver" Button in TitleBar (Visible ONLY in Reproducción en curso, cubre toda la altura de la barra) -->
            <Grid Grid.Column="0" VerticalAlignment="Stretch">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNowPlayingActive}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Button Command="{Binding CloseNowPlayingCommand}"
                        Cursor="Hand" ToolTip="Volver a la biblioteca"
                        Height="38" VerticalAlignment="Stretch">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="#26FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="0,0,1,0"
                                    Padding="18,0" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="BtnIcon" Symbol="ArrowLeft24" FontSize="16" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon.RenderTransform>
                                            <TranslateTransform X="0" />
                                        </ui:SymbolIcon.RenderTransform>
                                    </ui:SymbolIcon>
                                    <TextBlock x:Name="BtnText" Text="Volver" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#4DFFFFFF" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtnIcon"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="-3" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="BtnIcon"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                 To="0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#66FFFFFF" />
                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Center Draggable Area -->
            <Border Grid.Column="1" Background="Transparent" />

            <!-- Window Controls (Minimize, Maximize, Close - always accessible including in Reproducción en curso) -->
            <!-- Con Effect de sombra sutil para legibilidad en modo claro o fondos luminosos sin alterar pantalla completa -->
            <ui:TitleBar Grid.Column="2" VerticalAlignment="Top" Background="Transparent">
                <ui:TitleBar.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.32" />
                </ui:TitleBar.Effect>
            </ui:TitleBar>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 1: MAIN SHELL AREA (NAV PANE + CONTENT FRAME + OVERLAYS)  -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" /> <!-- Navigation Sidebar Column (Dinámico: 240/48 en desktop, 48 en móvil) -->
                <ColumnDefinition Width="*" />  <!-- Content Pages -->
            </Grid.ColumnDefinitions>

            <!-- ========================================================== -->
            <!-- 1. NAVIGATION SIDEBAR (GROOVE MUSIC STYLE WITH MICA)       -->
            <!-- ========================================================== -->
            <!-- Backdrop Click-Away (Solo visible en modo móvil cuando está expandido) -->
            <Border x:Name="NavPaneBackdrop" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="40"
                    Background="#66000000" Opacity="0" Visibility="Collapsed"
                    MouseDown="OnNavPaneBackdropMouseDown" />

            <Border x:Name="SidebarBorder" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="50"
                    Background="{DynamicResource NavPaneBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0"
                    HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect x:Name="SidebarShadow" BlurRadius="24" ShadowDepth="4" Direction="0" Color="#000000" Opacity="0" />
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="240" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNavPaneOpen}" Value="False">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="48" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                                             To="240" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Width="240" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Hamburger & SearchBox -->
                        <RowDefinition Height="*" />    <!-- Main Nav Items & Playlists -->
                        <RowDefinition Height="Auto" /> <!-- Footer: Configuración -->
                    </Grid.RowDefinitions>

                    <!-- Hamburger Button & SearchBox -->
                    <StackPanel Grid.Row="0" Margin="4,8,4,8">
                        <!-- Hamburger Toggle Button (Aligned with 48px slot: Left 0, Width 40) -->
                        <Button Width="40" Height="40" Cursor="Hand" Margin="0,0,0,4"
                                Command="{Binding ToggleNavPaneCommand}"
                                ToolTip="Colapsar / Expandir panel de navegación"
                                HorizontalAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="6" Background="Transparent" Width="40" Height="40">
                                        <Path Data="M 0,0 H 18 V 2 H 0 Z M 0,5 H 18 V 7 H 0 Z M 0,10 H 18 V 12 H 0 Z"
                                              Fill="{DynamicResource TextPrimaryBrush}"
                                              Width="18" Height="12"
                                              Stretch="Fill"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Opacity" Value="0.7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- SearchBox (AutoSuggestBox style) -->
                        <Grid Margin="4,0,4,0" Visibility="{Binding IsNavPaneOpen, Converter={StaticResource BoolToVisConverter}}">
                            <ui:TextBox x:Name="SidebarSearchBox"
                                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Buscar música..."
                                        Background="{DynamicResource SurfaceCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                                        Padding="8,5"
                                        GotFocus="OnSidebarSearchBoxGotFocus"
                                        PreviewKeyDown="OnSidebarSearchBoxPreviewKeyDown" />

                            <Popup x:Name="SidebarSearchSuggestionsPopup"
                                   PlacementTarget="{Binding ElementName=SidebarSearchBox}"
                                   Placement="Bottom"
                                   IsOpen="{Binding Search.IsSidebarSuggestionsOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Width="230"
                                   VerticalOffset="4">
                                <Border Background="#F21C1D26" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="4">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.5" ShadowDepth="4" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Search.Suggestions}">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:SearchSuggestionItem}">
                                                    <Button Padding="8,6" Margin="0,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Cursor="Hand"
                                                            Command="{Binding DataContext.Search.SelectSuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="BtnBrd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" HorizontalAlignment="Stretch">
                                                                    <Grid HorizontalAlignment="Stretch">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- Thumbnail / Icon Area (28x28) -->
                                                                        <Grid Grid.Column="0" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                            <!-- 1. Fallback Icon for Search / Default -->
                                                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="15"
                                                                                           Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                                                                            <!-- 2. Artist Silhouette Circle -->
                                                                            <Border Width="28" Height="28" CornerRadius="14" Background="#1F1F28"
                                                                                    Visibility="{Binding IsArtist, Converter={StaticResource BoolToVisConverter}}">
                                                                                <ui:SymbolIcon Symbol="Person24" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Border>

                                                                            <!-- 3. Album / Track Cached Artwork -->
                                                                            <Border Width="28" Height="28" CornerRadius="4" ClipToBounds="True"
                                                                                    Visibility="{Binding HasCoverImage, Converter={StaticResource BoolToVisConverter}}">
                                                                                <Image Source="{Binding CoverImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" />
                                                                            </Border>
                                                                        </Grid>

                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="BtnBrd" Property="Background" Value="#26FFFFFF" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter TargetName="BtnBrd" Property="Background" Value="#33FFFFFF" />
                                                                        <Setter TargetName="BtnBrd" Property="BorderBrush" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                        <Setter TargetName="BtnBrd" Property="BorderThickness" Value="1.5" />
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="BtnBrd" Property="Background" Value="#40FFFFFF" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <!-- Main Navigation Items & Playlists Section -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,0,4,0">
                            <!-- 0. Inicio -->
                            <Button Margin="0,2" Padding="10,9" HorizontalContentAlignment="Left" Cursor="Hand"
                                    Command="{Binding NavigateToCommand}" CommandParameter="Home">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Home24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentView}" Value="Home">
                                                                    <Setter Property="Foreground" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock Text="Inicio" FontSize="13" VerticalAlignment="Center"
                                                           Visibility="{Binding DataContext.IsNavPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentView}" Value="Home">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="Home">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 1. Mi música -->
                            <Button Margin="0,2" Padding="10,9" HorizontalContentAlignment="Left" Cursor="Hand"
                                    Command="{Binding NavigateToCommand}" CommandParameter="MyMusic">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="MusicNote224" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentView}" Value="MyMusic">
                                                                    <Setter Property="Foreground" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock Text="Mi música" FontSize="13" VerticalAlignment="Center"
                                                           Visibility="{Binding DataContext.IsNavPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentView}" Value="MyMusic">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="MyMusic">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 2. Reproducciones recientes -->
                            <Button Margin="0,2" Padding="10,9" HorizontalContentAlignment="Left" Cursor="Hand"
                                    Command="{Binding NavigateToCommand}" CommandParameter="RecentPlays">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="History24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <ui:SymbolIcon.Style>
                                                        <Style TargetType="ui:SymbolIcon">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentView}" Value="RecentPlays">
                                                                    <Setter Property="Foreground" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:SymbolIcon.Style>
                                                </ui:SymbolIcon>
                                                <TextBlock Text="Reproducciones recientes" FontSize="13" VerticalAlignment="Center"
                                                           Visibility="{Binding DataContext.IsNavPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CurrentView}" Value="RecentPlays">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentView}" Value="RecentPlays">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- 3. Reproducción en curso (Abre pantalla inmersiva) -->
                            <Button Margin="0,2" Padding="10,9" HorizontalContentAlignment="Left" Cursor="Hand"
                                    Command="{Binding OpenNowPlayingCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="SoundSource24" FontSize="18" Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="0,0,14,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Reproducción en curso" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding DataContext.IsNavPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisConverter}}" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Subtle Divider (espacio reducido entre Reproducción en curso y Listas de reproducción) -->
                            <Separator Background="{DynamicResource DividerBrush}" Margin="6,5" />

                            <!-- Playlists Button / Header in Sidebar -->
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Interactive Navigation Button for Listas de reproducción -->
                                <Button Grid.Column="0" Grid.ColumnSpan="2" Margin="0" Padding="10,9" HorizontalContentAlignment="Left" Cursor="Hand"
                                        Command="{Binding NavigateToPlaylistsViewCommand}" ToolTip="Listas de reproducción">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ui:SymbolIcon Grid.Column="0" Symbol="List24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CurrentView}" Value="PlaylistDetail">
                                                                        <Setter Property="Foreground" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>

                                                    <TextBlock Grid.Column="1" Text="Listas de reproducción" FontSize="13" VerticalAlignment="Center"
                                                               Visibility="{Binding DataContext.IsNavPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisConverter}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CurrentView}" Value="PlaylistDetail">
                                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentView}" Value="PlaylistDetail">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- (+) Quick Add Button -->
                                <ui:Button Grid.Column="1" Appearance="Transparent" Width="28" Height="28" Padding="0" Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           Command="{Binding CreatePlaylistQuickCommand}"
                                           ToolTip="Crear nueva lista"
                                           Visibility="{Binding IsNavPaneOpen, Converter={StaticResource BoolToVisConverter}}">
                                    <ui:SymbolIcon Symbol="Add24" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </ui:Button>
                            </Grid>

                            <!-- Playlists Sub-items (Si hay listas) -->
                            <ItemsControl ItemsSource="{Binding Playlists.Playlists}"
                                          Visibility="{Binding IsNavPaneOpen, Converter={StaticResource BoolToVisConverter}}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="{Binding IsNavPaneOpen, Converter={StaticResource BoolToVisConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Playlists.Playlists.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Playlist}">
                                        <Grid Margin="0,1">
                                            <Grid.Resources>
                                                <ContextMenu x:Key="PlaylistItemContextMenu" Opened="OnPlaylistContextMenuOpened">
                                                    <MenuItem Header="Reproducir ahora"
                                                              Command="{Binding PlayPlaylistDirectCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="Play24" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Abrir lista de reproducción"
                                                              Command="{Binding OpenPlaylistDetailCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="FolderOpen24" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Editar lista"
                                                              Command="{Binding OpenEditPlaylistDialogCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="Edit24" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Eliminar"
                                                              Command="{Binding DeletePlaylistWithNavigationCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <ui:SymbolIcon Symbol="Delete24" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Grid.Resources>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Main Playlist Button (Click opens detail, Right click opens ContextMenu) -->
                                            <Button Grid.Column="0" Margin="0" Padding="10,6" HorizontalContentAlignment="Left" Cursor="Hand"
                                                    ContextMenu="{StaticResource PlaylistItemContextMenu}"
                                                    Command="{Binding DataContext.OpenPlaylistDetailCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent" />
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Three-Dots Button (...) -->
                                            <ui:Button Grid.Column="1" Appearance="Transparent" Width="26" Height="26" Padding="0" Margin="0,0,4,0"
                                                       VerticalAlignment="Center"
                                                       ContextMenu="{StaticResource PlaylistItemContextMenu}"
                                                       Click="OnPlaylistMoreOptionsClick"
                                                       ToolTip="Opciones de la lista">
                                                <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State: Cuando no hay listas creadas -->
                            <Border Margin="6,4,6,6" Padding="12,10" CornerRadius="8" Background="{DynamicResource SurfaceCardBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNavPaneOpen}" Value="True" />
                                                    <Condition Binding="{Binding Playlists.Playlists.Count}" Value="0" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="No tienes listas aún" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,2" />
                                    <TextBlock Text="Crea tu primera lista para agrupar tu música favorita." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    
                                    <Button Margin="0,2" Padding="8,5" HorizontalAlignment="Stretch" Cursor="Hand"
                                            Command="{Binding CreatePlaylistQuickCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{DynamicResource SurfaceCardHoverBrush}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="0,0,6,0" />
                                                        <TextBlock Text="Crear lista" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.85" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Sugerencia rápida -->
                                    <Button Margin="0,3,0,0" Padding="8,4" HorizontalAlignment="Stretch" Cursor="Hand"
                                            Command="{Binding CreateSuggestedPlaylistCommand}" CommandParameter="Favorites">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Sparkle24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,5,0" />
                                                        <TextBlock Text="Sugerir: Favoritas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer: Configuración -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="6,8">
                        <Button Padding="10,8" HorizontalContentAlignment="Left" Cursor="Hand"
                                Command="{Binding NavigateToCommand}" CommandParameter="Settings">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,14,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                                                <Setter Property="Foreground" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock Text="Configuración" FontSize="13" VerticalAlignment="Center"
                                                       Visibility="{Binding DataContext.IsNavPaneOpen, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================================== -->
            <!-- 2. CENTRAL CONTENT AREA (PAGES CONTAINER WITH 0.3S EASE)   -->
            <!-- ========================================================== -->
            <Grid Grid.Column="1">
                <!-- Page: Inicio -->
                <views:HomePage>
                    <views:HomePage.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:HomePage.RenderTransform>
                    <views:HomePage.Style>
                        <Style TargetType="views:HomePage">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Home">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="15" To="0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:HomePage.Style>
                </views:HomePage>

                <!-- Page: Mi Música -->
                <views:MyMusicPage>
                    <views:MyMusicPage.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:MyMusicPage.RenderTransform>
                    <views:MyMusicPage.Style>
                        <Style TargetType="views:MyMusicPage">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="MyMusic">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="15" To="0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:MyMusicPage.Style>
                </views:MyMusicPage>

                <!-- Page: Reproducciones Recientes -->
                <views:RecentPlaysPage>
                    <views:RecentPlaysPage.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:RecentPlaysPage.RenderTransform>
                    <views:RecentPlaysPage.Style>
                        <Style TargetType="views:RecentPlaysPage">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="RecentPlays">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="15" To="0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:RecentPlaysPage.Style>
                </views:RecentPlaysPage>

                <!-- Page: Detalle de Playlist -->
                <views:PlaylistDetailPage>
                    <views:PlaylistDetailPage.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:PlaylistDetailPage.RenderTransform>
                    <views:PlaylistDetailPage.Style>
                        <Style TargetType="views:PlaylistDetailPage">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="PlaylistDetail">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="15" To="0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:PlaylistDetailPage.Style>
                </views:PlaylistDetailPage>

                <!-- Page: Búsqueda Unificada (Canciones, Artistas y Álbumes) -->
                <views:SearchPage>
                    <views:SearchPage.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:SearchPage.RenderTransform>
                    <views:SearchPage.Style>
                        <Style TargetType="views:SearchPage">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Search">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="15" To="0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SearchPage.Style>
                </views:SearchPage>

                <!-- Page: Configuración -->
                <views:SettingsPage>
                    <views:SettingsPage.RenderTransform>
                        <TranslateTransform Y="0" />
                    </views:SettingsPage.RenderTransform>
                    <views:SettingsPage.Style>
                        <Style TargetType="views:SettingsPage">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentView}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="0.0" To="1.0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 From="15" To="0" Duration="0:0:1.0">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:SettingsPage.Style>
                </views:SettingsPage>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- FULL-WINDOW NOWPLAYINGVIEW INMERSIVE SCREEN (EDGE-TO-EDGE)     -->
        <!-- ============================================================== -->
        <views:NowPlayingView Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="100">
            <views:NowPlayingView.RenderTransform>
                <TranslateTransform Y="0" />
            </views:NowPlayingView.RenderTransform>
            <views:NowPlayingView.Style>
                <Style TargetType="views:NowPlayingView">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNowPlayingActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="120" To="0" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <!-- Tipo persiana que baja al volver a la biblioteca (animación simétrica e inversa) -->
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="120" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:NowPlayingView.Style>
        </views:NowPlayingView>

        <!-- ============================================================== -->
        <!-- ROW 2: PERSISTENT BOTTOM MINIPLAYERBAR (GROOVE MUSIC EXACT LAYOUT) -->
        <!-- ============================================================== -->
        <Border x:Name="MiniPlayerBar" Grid.Row="2" Height="100" Background="{DynamicResource MiniPlayerBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"
                PreviewMouseWheel="OnMiniPlayerBarPreviewMouseWheel">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNowPlayingActive}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid Margin="0,0,16,0">
                <Grid.ColumnDefinitions>
                    <!-- Columna 0: Carátula e info canción (Izquierda con peso 1*) -->
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <!-- Columna 1: Centro fijo matemático con Controles de transporte y Seekbar abajo -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Columna 2: Derecha con Volumen, Mini-player / DAC, Más opciones (Mismo peso 1*) -->
                    <ColumnDefinition Width="*" MinWidth="220" />
                </Grid.ColumnDefinitions>

                <!-- ====================================================== -->
                <!-- COLUMNA 0: CARÁTULA CUADRADA + TÍTULO Y ARTISTA        -->
                <!-- ====================================================== -->
                <Button x:Name="MiniPlayerBigButton" Grid.Column="0" Command="{Binding OpenNowPlayingCommand}"
                        HorizontalAlignment="Left" MaxWidth="380"
                        HorizontalContentAlignment="Left" VerticalContentAlignment="Stretch"
                        VerticalAlignment="Stretch" Padding="0" Margin="0" BorderThickness="0" Background="Transparent"
                        Cursor="Hand" ToolTip="Clic izquierdo: Abrir vista inmersiva | Clic derecho: Opciones de pista">
                    <Button.ContextMenu>
                        <ContextMenu Opened="OnMiniPlayerContextMenuOpened">
                            <MenuItem Header="Ir a artista"
                                      Command="{Binding ViewCurrentArtistCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Person24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Ir a álbum"
                                      Command="{Binding ViewCurrentAlbumCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Album24" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Añadir a lista de reproducción" SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="List24" />
                                </MenuItem.Icon>
                                <MenuItem Header="+ Nueva lista de reproducción..." />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Ver información de la pista (Propiedades)"
                                      Command="{Binding ShowCurrentTrackPropertiesCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                <MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Info24" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BigButtonBorder" Background="Transparent" VerticalAlignment="Stretch" Padding="0,0,12,0">
                                <Grid x:Name="MiniPlayerTrackInfoContainer" VerticalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Carátula cuadrada a ras de la barra (100x100 ocupando todo el alto) -->
                                    <Border Grid.Column="0" Width="100" Height="100" Background="#26FFFFFF"
                                            VerticalAlignment="Stretch" HorizontalAlignment="Left" SnapsToDevicePixels="True">
                                        <Image Source="{Binding NowPlaying.AlbumArt}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <!-- Título y Artista con tamaños legibles y armoniosos -->
                                    <StackPanel x:Name="MiniTrackInfoPanel" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0" ClipToBounds="True">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="MiniTrackInfoTranslate" X="0" />
                                        </StackPanel.RenderTransform>

                                        <TextBlock Text="{Binding NowPlaying.Title}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding NowPlaying.Artist}" FontSize="13" FontWeight="Normal"
                                                   Foreground="#D0FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BigButtonBorder" Property="Background" Value="#1AFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- ====================================================== -->
                <!-- COLUMNA 1: CONTROLES DE TRANSPORTE Y SEEKBAR ALINEADA  -->
                <!-- ====================================================== -->
                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Fila 0: Botones de transporte estilo NowPlayingView (Shuffle, Prev, Play Circular, Next, Repeat) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                        <!-- Shuffle Button -->
                        <Button Command="{Binding NowPlaying.ToggleShuffleCommand}" Cursor="Hand" Padding="0" Margin="0,0,10,0" ToolTip="Reproducción aleatoria">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="8,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="ArrowShuffle24" FontSize="18" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Previous Button -->
                        <ui:Button Appearance="Transparent" Padding="9" Margin="0,0,4,0" Command="{Binding NowPlaying.PreviousCommand}" ToolTip="Anterior">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="20" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <!-- Circular Play/Pause Button (Estilo exacto de NowPlayingView) -->
                        <Button Style="{StaticResource CircularPlayPauseButtonStyle}"
                                Command="{Binding NowPlaying.PlayPauseCommand}"
                                Margin="4,0,8,0" />

                        <!-- Next Button -->
                        <ui:Button Appearance="Transparent" Padding="9" Margin="0,0,4,0" Command="{Binding NowPlaying.NextCommand}" ToolTip="Siguiente">
                            <ui:SymbolIcon Symbol="Next24" FontSize="20" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <!-- Repeat Button -->
                        <Button Command="{Binding NowPlaying.CycleRepeatCommand}" Cursor="Hand" Padding="0" Margin="0,0,10,0" ToolTip="Modo de repetición">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="8,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="{Binding NowPlaying.RepeatMode, Converter={StaticResource RepeatModeToSymbolConverter}}" FontSize="18" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="All">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="One">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Fila 1: Seekbar compacta y bien visible con tiempos a los lados y Donut Thumb de Groove -->
                    <Grid Grid.Row="1" Width="480" Height="30" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Tiempo actual -->
                        <TextBlock Grid.Column="0" Text="{Binding NowPlaying.CurrentTimeText}" FontSize="11" Foreground="#C0FFFFFF"
                                   VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False" />

                        <!-- Slider con riel de alto contraste visible y barra de progreso rellena estilo NowPlayingView -->
                        <Slider x:Name="MiniSeekSlider" Grid.Column="1" Height="30" VerticalAlignment="Center" Margin="0"
                                Minimum="0" Maximum="{Binding NowPlaying.TotalDurationSeconds}"
                                Value="{Binding NowPlaying.CurrentPositionSeconds, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                PreviewMouseLeftButtonDown="OnSeekSliderPreviewMouseDown"
                                PreviewMouseMove="OnSeekSliderPreviewMouseMove"
                                PreviewMouseLeftButtonUp="OnSeekSliderPreviewMouseUp"
                                ValueChanged="OnSeekSliderValueChanged">
                            <Slider.Template>
                                <ControlTemplate TargetType="Slider">
                                    <Border Background="Transparent" VerticalAlignment="Center" Height="30">
                                        <Grid Background="Transparent" Height="30" VerticalAlignment="Center">
                                            <Track x:Name="PART_Track" Height="30" VerticalAlignment="Center">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource ModernSliderDecreaseRepeatButtonStyle}" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ModernSliderThumbStyle}" VerticalAlignment="Center" />
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource ModernSliderIncreaseRepeatButtonStyle}" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Slider.Template>
                        </Slider>

                        <!-- Tiempo total -->
                        <TextBlock Grid.Column="2" Text="{Binding NowPlaying.TotalTimeText}" FontSize="11" Foreground="#C0FFFFFF"
                                   VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </Grid>

                <!-- ====================================================== -->
                <!-- COLUMNA 2: VOLUMEN VISIBLE, SELECTOR DAC (PARLANTE) Y MÁS -->
                <!-- ====================================================== -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- Icono de Volumen -->
                    <Button Command="{Binding NowPlaying.ToggleMuteCommand}" Cursor="Hand" Width="34" Height="34" Padding="0"
                            Background="Transparent" BorderThickness="0" ToolTip="Silenciar / Activar sonido" Margin="0,0,4,0">
                        <ui:SymbolIcon FontSize="18" Foreground="#E0FFFFFF" HorizontalAlignment="Center">
                            <ui:SymbolIcon.Symbol>
                                <MultiBinding Converter="{StaticResource VolumeToSymbolConverter}">
                                    <Binding Path="NowPlaying.Volume" />
                                    <Binding Path="NowPlaying.IsMuted" />
                                </MultiBinding>
                            </ui:SymbolIcon.Symbol>
                        </ui:SymbolIcon>
                    </Button>

                    <!-- Slider de Volumen con riel relleno estilo NowPlayingView -->
                    <Border Background="Transparent" Padding="0" Margin="0,0,14,0" Cursor="Hand" VerticalAlignment="Center">
                        <Slider Width="105" Height="30" Minimum="0" Maximum="1"
                                IsMoveToPointEnabled="True"
                                Value="{Binding NowPlaying.Volume, Mode=TwoWay}"
                                PreviewMouseLeftButtonDown="OnVolumeSliderPreviewMouseDown"
                                PreviewMouseMove="OnVolumeSliderPreviewMouseMove"
                                PreviewMouseLeftButtonUp="OnVolumeSliderPreviewMouseUp"
                                VerticalAlignment="Center">
                            <Slider.Template>
                                <ControlTemplate TargetType="Slider">
                                    <Border Background="Transparent" VerticalAlignment="Center" Height="30">
                                        <Grid Background="Transparent" Height="30" VerticalAlignment="Center">
                                            <Track x:Name="PART_Track" Height="30" VerticalAlignment="Center">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource ModernSliderDecreaseRepeatButtonStyle}" />
                                                </Track.DecreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{StaticResource ModernSliderThumbStyle}" VerticalAlignment="Center" />
                                                </Track.Thumb>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource ModernSliderIncreaseRepeatButtonStyle}" />
                                                </Track.IncreaseRepeatButton>
                                            </Track>
                                        </Grid>
                                    </Border>
                                </ControlTemplate>
                            </Slider.Template>
                        </Slider>
                    </Border>

                    <!-- Selector DAC con icono vectorial de parlante/bafle idéntico al de NowPlayingView -->
                    <Button Command="{Binding ToggleDeviceSelectorCommand}" Cursor="Hand" Padding="0" Margin="0,0,8,0"
                            ToolTip="Dispositivo de salida / WASAPI Exclusive Bit-Perfect">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" CornerRadius="8" Padding="7,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Hi-Fi Speaker Minicomponente / Bafle Vector Icon -->
                                        <Grid Width="16" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="14" Height="17.5" RadiusX="2.5" RadiusY="2.5" Stroke="#D9FFFFFF" StrokeThickness="1.5" Fill="#1AFFFFFF" />
                                            <Ellipse Width="3.5" Height="3.5" Fill="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3.5,0,0" />
                                            <Ellipse Width="7.5" Height="7.5" Stroke="#D9FFFFFF" StrokeThickness="1.2" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2.5" />
                                            <Ellipse Width="2.5" Height="2.5" Fill="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                        </Grid>
                                        <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDeviceSelectorOpen}" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                        <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Botón de Pantalla Completa (Redirige a Reproducción en curso en Fullscreen) -->
                    <ui:Button Appearance="Transparent" Padding="7" Margin="0,0,6,0"
                               Command="{Binding EnterFullscreenAndNowPlayingCommand}"
                               ToolTip="Pantalla completa (F11)">
                        <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="17" Foreground="#E0FFFFFF" />
                    </ui:Button>

                    <!-- Más opciones (...) -->
                    <ui:Button Appearance="Transparent" Padding="6"
                               Click="OnMoreOptionsButtonClick"
                               ToolTip="Más opciones">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Dispositivo de audio / DAC..."
                                          Command="{Binding ToggleDeviceSelectorCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Speaker224" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Silenciar / Activar sonido"
                                          Command="{Binding NowPlaying.ToggleMuteCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="SpeakerMute24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Lista actual"
                                          Command="{Binding OpenCurrentQueueCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Añadir a lista de reproducción" SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="List24" />
                                    </MenuItem.Icon>
                                    <MenuItem Header="+ Nueva lista de reproducción..." />
                                </MenuItem>
                                <MenuItem Header="Ver álbum"
                                          Command="{Binding ViewCurrentAlbumCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Album24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Ver artista"
                                          Command="{Binding ViewCurrentArtistCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Person24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Añadir pistas relacionadas"
                                          Command="{Binding AddRelatedTracksCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Sparkle24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Ecualizador"
                                          Command="{Binding ToggleEqualizerCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Options24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Parar / Detener música"
                                          Command="{Binding StopMusicCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Stop24" Foreground="#E81123" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Añadir Archivos..."
                                          Command="{Binding Queue.AddFilesCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="DocumentAdd24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Añadir Carpeta..."
                                          Command="{Binding Queue.AddFolderCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="FolderAdd24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" Foreground="#E0FFFFFF" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- DIALOGS & POPUPS                                               -->
        <!-- ============================================================== -->

        <!-- DAC & OUTPUT SELECTOR DIALOG -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1050" Visibility="{Binding IsDeviceSelectorOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#66000000" MouseLeftButtonDown="OnDismissDialogClick" />
            <Border Style="{StaticResource GlassPanelStyle}" HorizontalAlignment="Stretch" MaxWidth="760" Margin="48,24" MaxHeight="580" VerticalAlignment="Center">
                <Grid Margin="24" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Hi-Fi Minicomponente / Bafle Vector Header Icon -->
                            <Grid Width="18" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Rectangle Width="16" Height="20" RadiusX="3" RadiusY="3" Stroke="{Binding Theme.CurrentAccentBrush}" StrokeThickness="1.5" Fill="#1AFFFFFF" />
                                <Ellipse Width="4" Height="4" Fill="{Binding Theme.CurrentAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" />
                                <Ellipse Width="8.5" Height="8.5" Stroke="{Binding Theme.CurrentAccentBrush}" StrokeThickness="1.2" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                                <Ellipse Width="3" Height="3" Fill="{Binding Theme.CurrentAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5.7" />
                            </Grid>
                            <TextBlock Text="Salida de Audio &amp; DAC" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        </StackPanel>
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Right" Command="{Binding ToggleDeviceSelectorCommand}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="#99FFFFFF" />
                        </ui:Button>
                    </Grid>

                    <Border Grid.Row="1" Background="#22FFFFFF" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="WASAPI Exclusive (Bit-Perfect)" FontSize="14" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush}" />
                                <TextBlock Text="Control exclusivo del DAC sin remuestreo ni mezclador de Windows" FontSize="11" Foreground="#99FFFFFF" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding DeviceSelector.IsExclusiveMode, Mode=TwoWay}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="#1400D26A" BorderBrush="#3300FF85" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding DeviceSelector.StatusDescription}" FontSize="11" Foreground="#DDFFFFFF" TextWrapping="Wrap" LineHeight="16" />
                    </Border>

                    <Grid Grid.Row="3" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Dispositivos de Audio Detectados:" FontSize="12" FontWeight="SemiBold" Foreground="#99FFFFFF" Margin="0,0,0,8" />
                        <ListView Grid.Row="1" ItemsSource="{Binding DeviceSelector.Devices}"
                                  SelectedItem="{Binding DeviceSelector.SelectedDevice, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  Background="Transparent" BorderThickness="0" MaxHeight="220">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:AudioOutputDeviceInfo}">
                                    <Border CornerRadius="8" Padding="14,10" Margin="0,3" BorderThickness="1.5" HorizontalAlignment="Stretch">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#14FFFFFF" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#2200D26A" />
                                                        <Setter Property="BorderBrush" Value="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Vector Speaker Icon -->
                                            <Grid Grid.Column="0" Width="14" Height="17" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Rectangle Width="13" Height="16" RadiusX="2" RadiusY="2" Stroke="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}" StrokeThickness="1.2" Fill="#14FFFFFF" />
                                                <Ellipse Width="3" Height="3" Fill="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" />
                                                <Ellipse Width="6.5" Height="6.5" Stroke="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}" StrokeThickness="1" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                                <Ellipse Width="2" Height="2" Fill="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4.2" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#88FFFFFF" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- Device Action: Checkmark badge if IsSelected, Elegir button if inactive -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                                                <!-- Active Checkmark Badge -->
                                                <Border Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisConverter}}"
                                                        Background="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}"
                                                        CornerRadius="12" Padding="10,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Foreground="#0A0A0E" Margin="0,0,4,0" FontWeight="Bold" />
                                                        <TextBlock Text="Activo" FontSize="11" FontWeight="Bold" Foreground="#0A0A0E" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Inactive "Elegir" Button -->
                                                <ui:Button Visibility="{Binding IsSelected, Converter={StaticResource InverseBoolToVisConverter}}"
                                                           Appearance="Secondary" Padding="12,5"
                                                           Command="{Binding DeviceSelector.SelectDeviceCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                           CommandParameter="{Binding}">
                                                    <TextBlock Text="Elegir" FontSize="11" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <ui:Button Grid.Row="4" Appearance="Primary" HorizontalAlignment="Right" Margin="0,14,0,0"
                               Background="{Binding Theme.CurrentAccentBrush}"
                               Command="{Binding ToggleDeviceSelectorCommand}">
                        <TextBlock Text="Cerrar" FontWeight="Bold" Foreground="#0A0A0E" />
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <!-- NOTIFICATION TOAST BANNER -->
        <Border Grid.Row="1" Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVisConverter}}"
                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                Style="{StaticResource GlassPanelStyle}" Padding="16,12" Width="520">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="Info24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NotificationTitle}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                    <TextBlock Text="{Binding NotificationMessage}" FontSize="11" Foreground="#CCFFFFFF" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="2" Appearance="Transparent" Padding="4" Command="{Binding DismissNotificationCommand}" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" Foreground="#99FFFFFF" />
                </ui:Button>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ASYNC SCAN & INDEXING FLOATING BANNER (NON-BLOCKING TOAST)     -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Panel.ZIndex="999"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,20"
                CornerRadius="12" Background="#E61C1D26" BorderBrush="#33FFFFFF" BorderThickness="1"
                Padding="16,12" MaxWidth="380"
                Visibility="{Binding IsScanningOverlayVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Color="#000000" Opacity="0.6" ShadowDepth="4" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Rotating Progress Ring / Spinner -->
                <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="26" Height="26"
                                 Foreground="{Binding Theme.CurrentAccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,14,0" />

                <!-- Text and Progress -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScanOverlayTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ScanOverlayCountText}" FontSize="11" Foreground="{Binding Theme.CurrentAccentBrush}"
                               FontWeight="Normal" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Height="3" Value="{Binding ScanOverlayProgress}" Maximum="100"
                                 Background="#26FFFFFF" Foreground="{Binding Theme.CurrentAccentBrush}"
                                 BorderThickness="0" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- TRACK PROPERTIES / FILE INSPECTOR MODAL                        -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1000"
              Background="#99000000"
              Visibility="{Binding IsTrackPropertiesModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="560" MaxHeight="660"
                    CornerRadius="14" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                    Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.7" ShadowDepth="6" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Content -->
                        <RowDefinition Height="Auto" /> <!-- Actions Footer -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Propiedades del archivo de audio" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Appearance="Transparent" Padding="4" Command="{Binding CloseTrackPropertiesCommand}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Cover & Title/Artist Header -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="90" Height="90" CornerRadius="8" ClipToBounds="True" Background="#20FFFFFF">
                                    <Image Source="{Binding SelectedTrackForProperties.CoverImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{Binding SelectedTrackForProperties.Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedTrackForProperties.Artist}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding SelectedTrackForProperties.Album}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                            <!-- Technical Specs Table -->
                            <TextBlock Text="ESPECIFICACIONES TÉCNICAS" FontSize="11" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Formato de audio:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTrackForProperties.FileFormat}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Frecuencia de muestreo:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTrackForProperties.SampleRateFormatted}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Profundidad de bits:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTrackForProperties.BitDepthFormatted}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bitrate:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTrackForProperties.Bitrate, StringFormat='{}{0} kbps'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Canales:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTrackForProperties.Channels, StringFormat='{}{0} canales'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Duración:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTrackForProperties.DurationFormatted}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,14" />

                            <!-- Location & Metadata -->
                            <TextBlock Text="UBICACIÓN Y METADATOS" FontSize="11" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Género:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTrackForProperties.Genre}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Año:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTrackForProperties.Year}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ruta del archivo:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTrackForProperties.FilePath}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions Footer -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Appearance="Secondary" Padding="14,7"
                                   Command="{Binding OpenTrackInExplorerCommand}"
                                   CommandParameter="{Binding SelectedTrackForProperties}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,8,0" />
                                <TextBlock Text="Abrir ubicación del archivo" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Grid.Column="1" Appearance="Primary" Padding="18,7"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding CloseTrackPropertiesCommand}">
                            <TextBlock Text="Cerrar" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- FLOATING PARAMETRIC EQUALIZER & DSP PANEL                      -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="1060"
              Visibility="{Binding IsEqualizerOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#77000000" MouseLeftButtonDown="OnDismissEqualizerClick" />

            <Border Width="780" MaxHeight="660" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="16" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.7" ShadowDepth="10" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header + Enable Switch + Preset -->
                        <RowDefinition Height="Auto" /> <!-- DSP Preamp, Bass Boost, Stereo Width -->
                        <RowDefinition Height="*" />    <!-- 10-Band Parametric Equalizer -->
                        <RowDefinition Height="Auto" /> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Options24" FontSize="22" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="Ecualizador Paramétrico &amp; Motor DSP" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Procesamiento BiQuad de 10 bandas en tiempo real (31 Hz – 16 kHz)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <CheckBox Content="DSP Activo" IsChecked="{Binding Equalizer.IsEnabled, Mode=TwoWay}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Width="210" ItemsSource="{Binding Equalizer.Presets}"
                                      SelectedItem="{Binding Equalizer.SelectedPreset, Mode=TwoWay}" />
                        </StackPanel>

                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6"
                                   Command="{Binding CloseEqualizerCommand}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <!-- Row 1: DSP Controls (Preamp, Bass Boost, Stereo Width) -->
                    <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource SurfaceCardHoverBrush}" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Preamp -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Pre-Amplificador" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Equalizer.PreampFormatted}" FontSize="11" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="-12" Maximum="12" Value="{Binding Equalizer.PreampDb, Mode=TwoWay}" IsMoveToPointEnabled="True" />
                            </StackPanel>

                            <!-- Bass Boost -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Refuerzo de Graves (80Hz)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Equalizer.BassBoostFormatted}" FontSize="11" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="0" Maximum="12" Value="{Binding Equalizer.BassBoostDb, Mode=TwoWay}" IsMoveToPointEnabled="True" />
                            </StackPanel>

                            <!-- Stereo Width -->
                            <StackPanel Grid.Column="4">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="Amplitud Estéreo" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Equalizer.StereoWidthFormatted}" FontSize="11" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Minimum="0.5" Maximum="1.6" Value="{Binding Equalizer.StereoWidth, Mode=TwoWay}" IsMoveToPointEnabled="True" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: 10-Band Equalizer Sliders (Vertical Studio Layout) -->
                    <Border Grid.Row="2" CornerRadius="12" Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                            Padding="16,14" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: dB Scale Indicators -->
                            <Grid Grid.Column="0" Margin="0,22,10,24">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" /> <!-- +12 dB -->
                                    <RowDefinition Height="*" /> <!-- +6 dB -->
                                    <RowDefinition Height="*" /> <!-- 0 dB -->
                                    <RowDefinition Height="*" /> <!-- -6 dB -->
                                    <RowDefinition Height="*" /> <!-- -12 dB -->
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="+12 dB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="+6 dB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2" Text="0 dB" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="3" Text="-6 dB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="4" Text="-12 dB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                            </Grid>

                            <!-- Background Reference Grid Lines across the sliders area -->
                            <Grid Grid.Column="1" Margin="0,27,0,29" IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- +12 dB Top Line -->
                                <Border Grid.Row="0" BorderBrush="{DynamicResource TextSecondaryBrush}" Opacity="0.40" BorderThickness="0,1,0,0" VerticalAlignment="Top" />
                                <!-- +6 dB Line -->
                                <Border Grid.Row="0" BorderBrush="{DynamicResource TextSecondaryBrush}" Opacity="0.40" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
                                <!-- 0 dB Center Line (highlighted) -->
                                <Border Grid.Row="1" BorderBrush="{DynamicResource TextSecondaryBrush}" Opacity="0.75" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
                                <!-- -6 dB Line -->
                                <Border Grid.Row="2" BorderBrush="{DynamicResource TextSecondaryBrush}" Opacity="0.40" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
                                <!-- -12 dB Bottom Line -->
                                <Border Grid.Row="3" BorderBrush="{DynamicResource TextSecondaryBrush}" Opacity="0.40" BorderThickness="0,0,0,1" VerticalAlignment="Bottom" />
                            </Grid>

                            <!-- Right: 10 Vertical Sliders -->
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Equalizer.Bands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /> <!-- Gain readout -->
                                                <RowDefinition Height="165" />  <!-- Vertical Slider -->
                                                <RowDefinition Height="Auto" /> <!-- Frequency label -->
                                            </Grid.RowDefinitions>

                                            <!-- Gain Text -->
                                            <TextBlock Grid.Row="0" Text="{Binding GainFormatted}"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,6" />

                                            <!-- Vertical Slider -->
                                            <Slider Grid.Row="1" Style="{StaticResource VerticalEqSliderStyle}"
                                                    Minimum="-12" Maximum="12" Height="160"
                                                    Value="{Binding Gain, Mode=TwoWay}"
                                                    HorizontalAlignment="Center" />

                                            <!-- Frequency Label -->
                                            <TextBlock Grid.Row="2" Text="{Binding DisplayFrequency}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Row 3: Footer -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Appearance="Secondary" Padding="14,7"
                                   Command="{Binding Equalizer.ResetEqualizerCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowReset24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Restablecer a Plano (0 dB)" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Grid.Column="2" Appearance="Primary" Padding="20,7"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding CloseEqualizerCommand}">
                            <TextBlock Text="Listo" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

