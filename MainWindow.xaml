                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Carpetas de tu biblioteca" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
