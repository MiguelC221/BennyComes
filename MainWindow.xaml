                                    <Image Source="{Binding EditPlaylistCoverPreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="48" Foreground="{Binding Theme.CurrentAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditPlaylistCoverPreview}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Border>
                            <ui:Button Appearance="Secondary" Margin="0,10,0,4" HorizontalAlignment="Stretch" Padding="6,4"
                                       Command="{Binding BrowsePlaylistCoverCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Image24" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Elegir imagen..." FontSize="11" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Padding="6,4"
                                       Command="{Binding GeneratePlaylistCollageCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Autogenerar collage" FontSize="11" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>

                        <!-- Name & Description Fields -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Nombre de la lista" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ui:TextBox Text="{Binding EditPlaylistName, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Título de la lista..." Margin="0,0,0,12"
                                        Background="{DynamicResource SurfaceCardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />

                            <TextBlock Text="Descripción (opcional)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ui:TextBox Text="{Binding EditPlaylistDescription, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Añade una descripción personalizada..." Height="72" TextWrapping="Wrap"
                                        AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                        Background="{DynamicResource SurfaceCardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Secondary" Padding="16,7" Margin="0,0,10,0"
                                   Command="{Binding CancelEditPlaylistDialogCommand}">
                            <TextBlock Text="Cancelar" FontSize="12" />
                        </ui:Button>
                        <ui:Button Appearance="Primary" Padding="18,7"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding SaveEditPlaylistCommand}">
                            <TextBlock Text="Guardar cambios" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- FULLSCREEN FIRST-RUN ONBOARDING WELCOME OVERLAY               -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="10000"
              Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BoolToVisConverter}}">
            <!-- Fullscreen Deep Glass Backdrop -->
            <Border Background="#F20D0E14" />

            <!-- Decorative Ambient Radial Glow behind the Card -->
            <Ellipse Width="700" Height="450" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Opacity="0.18" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{Binding Theme.CurrentAccentColor}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Main Onboarding Modal Window / Card -->
            <Border Width="680" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="18" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                    Padding="36,32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" Color="#000000" Opacity="0.8" ShadowDepth="12" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Welcome Hero Header -->
                        <RowDefinition Height="*" />    <!-- Folder Selection Section -->
                        <RowDefinition Height="Auto" /> <!-- Footer Actions -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Hero Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border Width="64" Height="64" CornerRadius="32"
                                Background="{Binding Theme.CurrentAccentBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="32"
                                           Foreground="{Binding Theme.AccentForegroundBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="¡Te damos la bienvenida a BenyComes!"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="El reproductor de música Hi-Fi Bit-Perfect para Windows. Para comenzar a disfrutar de tu colección musical, selecciona las carpetas locales donde guardas tus pistas y álbumes."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="540" />
                    </StackPanel>

                    <!-- Row 1: Folder Selection Section -->
                    <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource SurfaceCardHoverBrush}"
                            BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                            Padding="18,16" Margin="0,0,0,24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Section Title + Add Buttons -->
                                <RowDefinition Height="*" />    <!-- Folders List or Empty State -->
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Carpetas de música a escanear" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Appearance="Secondary" Padding="10,5" Margin="0,0,8,0"
                                               Command="{Binding AddDefaultMusicFolderCommand}"
                                               ToolTip="Añade la carpeta estándar Música de tu usuario">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="FolderAdd24" FontSize="13" Margin="0,0,6,0" />
                                            <TextBlock Text="+ Carpeta 'Música'" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Appearance="Primary" Padding="12,5"
                                               Background="{Binding Theme.CurrentAccentBrush}"
                                               Command="{Binding AddOnboardingFolderCommand}"
                                               ToolTip="Seleccionar una carpeta de música en tu disco">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="Examinar carpeta..." FontSize="11" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" />
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <!-- Folders List or Empty Placeholder -->
                            <Grid Grid.Row="1" MinHeight="130">
                                <!-- Empty state text when no folders added -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding OnboardingFolders.Count, Converter={StaticResource InverseBoolToVisConverter}}">
                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="28" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" />
                                    <TextBlock Text="No has seleccionado ninguna carpeta todavía."
                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Haz clic en '+ Carpeta Música' o 'Examinar carpeta...' para añadir una ruta."
                                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Items list when folders are present -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                                    <ItemsControl ItemsSource="{Binding OnboardingFolders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Background="{DynamicResource AppBackgroundBrush}"
                                                        BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                                        Padding="10,7" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="16"
                                                                       Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center" />
                                                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="4"
                                                                   Command="{Binding DataContext.RemoveOnboardingFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   CommandParameter="{Binding}"
                                                                   ToolTip="Quitar carpeta de la lista">
                                                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </ui:Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 2: Footer Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button Grid.Column="0" Appearance="Transparent" Padding="14,8"
                                   Command="{Binding SkipOnboardingCommand}">
                            <TextBlock Text="Omitir por ahora" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </ui:Button>

                        <ui:Button Grid.Column="2" Appearance="Primary" Padding="26,10"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding CompleteOnboardingCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="15" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Comenzar a disfrutar de mi música" FontSize="13" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- ARTIST PHOTO GALLERY MODAL                                      -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="9200"
              Visibility="{Binding IsArtistGalleryModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#D00A0A0F" />

            <Border Width="720" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="16" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                    Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.75" ShadowDepth="10" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Photo Grid -->
                        <RowDefinition Height="Auto" /> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Title, Actions & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Image24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Galería de Fotos del Artista" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>

                            <!-- Single artist display -->
                            <TextBlock Text="{Binding GalleryArtistName}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,2,0,0"
                                       Visibility="{Binding HasMultipleGalleryArtists, Converter={StaticResource InverseBoolToVisConverter}}" />

                            <!-- Multi-artist collaboration selector -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,5,0,0"
                                        Visibility="{Binding HasMultipleGalleryArtists, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Artista:" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding GalleryAvailableArtists}"
                                          SelectedItem="{Binding SelectedGalleryArtist, Mode=TwoWay}"
                                          MinWidth="160" MaxWidth="240" FontSize="12" Padding="8,4" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Source selector -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Fuente:" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding GallerySources}"
                                          SelectedItem="{Binding SelectedGallerySource, Mode=TwoWay}"
                                          MinWidth="115" FontSize="12" Padding="8,4" />
                            </StackPanel>

                            <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,8,0"
                                       Command="{Binding AddLocalArtistPhotoCommand}"
                                       ToolTip="Añadir una foto desde tu equipo a la galería">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderAdd24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="+ Foto local" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,10,0"
                                       Command="{Binding RefreshGalleryFromLastFmCommand}"
                                       ToolTip="Descargar fotos para el artista desde la fuente seleccionada">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Obtener fotos" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Appearance="Transparent" Padding="4"
                                       Command="{Binding CloseArtistGalleryCommand}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Photos Grid / Loading / Empty -->
                    <Grid Grid.Row="1" MinHeight="260" MaxHeight="360">
                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding GalleryPhotos.Count}" Value="0" />
                                                <Condition Binding="{Binding IsGalleryLoading}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Symbol="ImageOff24" FontSize="40" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,10" HorizontalAlignment="Center" />
                            <TextBlock Text="No hay fotos en caché para este artista." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Haz clic en '+ Foto local' o 'Actualizar Last.fm' para descargar imágenes oficiales." FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Photos ScrollViewer (supports >6 images with visible scrollbar) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      MaxHeight="350" Padding="0,0,6,0"
                                      Visibility="{Binding GalleryPhotos.Count, Converter={StaticResource BoolToVisConverter}}">
                            <ItemsControl ItemsSource="{Binding GalleryPhotos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ArtistPhotoItem}">
                                        <Border Width="150" Height="150" Margin="6" CornerRadius="10" ClipToBounds="True"
                                                Background="#14141C" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceCardBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsOmitted}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <!-- Clickable Image Preview to select photo directly -->
                                                <Button Command="{Binding SetPrimaryArtistPhotoCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                        CommandParameter="{Binding}"
                                                        Cursor="Hand" Padding="0" BorderThickness="0" Background="Transparent"
                                                        ToolTip="Haz clic para seleccionar como foto principal">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Image Source="{Binding ImagePreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Omitted Dim Overlay Badge (Center) -->
                                                <Border Background="#99000000" IsHitTestVisible="False"
                                                        Visibility="{Binding IsOmitted, Converter={StaticResource BoolToVisConverter}}">
                                                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="#CC1E1E28" BorderBrush="#55FFFFFF" BorderThickness="1"
                                                            CornerRadius="6" Padding="8,3">
                                                        <TextBlock Text="Omitida" FontSize="10" FontWeight="Bold" Foreground="#FF8888" />
                                                    </Border>
                                                </Border>

                                                <!-- Top-Left: Omit / Include Toggle Button -->
                                                <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                        Cursor="Hand"
                                                        Command="{Binding ToggleOmitArtistPhotoCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Omitir o incluir esta imagen en la rotación">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border CornerRadius="5" Padding="6,3" Background="#CC14141C" BorderBrush="#44FFFFFF" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <ui:SymbolIcon FontSize="11" Foreground="#FFFFFF" Margin="0,0,4,0">
                                                                        <ui:SymbolIcon.Style>
                                                                            <Style TargetType="ui:SymbolIcon">
                                                                                <Setter Property="Symbol" Value="EyeOff24" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOmitted}" Value="True">
                                                                                        <Setter Property="Symbol" Value="Eye24" />
                                                                                        <Setter Property="Foreground" Value="#00D26A" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </ui:SymbolIcon.Style>
                                                                    </ui:SymbolIcon>
                                                                    <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#FFFFFF">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Text" Value="Omitir" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOmitted}" Value="True">
                                                                                        <Setter Property="Text" Value="Incluir" />
                                                                                        <Setter Property="Foreground" Value="#00D26A" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Primary Badge (Top-Right) -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                        CornerRadius="4" Padding="6,2" IsHitTestVisible="False"
                                                        Background="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}"
                                                        Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisConverter}}">
                                                    <TextBlock Text="★ Principal" FontSize="9" FontWeight="Bold"
                                                               Foreground="{Binding Theme.AccentForegroundBrush, Source={x:Static vm:MainViewModel.Instance}}" />
                                                </Border>

                                                <!-- Action overlay on bottom -->
                                                <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="4">
                                                    <Grid>
                                                        <!-- If not primary: Button to set as primary -->
                                                        <Button Cursor="Hand" HorizontalAlignment="Stretch"
                                                                Command="{Binding SetPrimaryArtistPhotoCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsPrimary, Converter={StaticResource InverseBoolToVisConverter}}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" Padding="4,2" HorizontalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ui:SymbolIcon Symbol="Star24" FontSize="11" Foreground="White" Margin="0,0,4,0" />
                                                                            <TextBlock Text="Fijar principal" FontSize="10" Foreground="White" FontWeight="SemiBold" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- If already primary: label -->
                                                        <TextBlock Text="★ Foto activa" FontSize="10"
                                                                   Foreground="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}"
                                                                   FontWeight="Bold" HorizontalAlignment="Center" Padding="0,2"
                                                                   Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Loading Indicator (Placed ON TOP of photos with Panel.ZIndex="100") -->
                        <Border Panel.ZIndex="100" CornerRadius="12" Background="#D90E0E14"
                                Visibility="{Binding IsGalleryLoading, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,0,12" />
                                <TextBlock Text="Cargando y actualizando fotos del artista..." FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Footer Close Button -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <TextBlock Text="La foto principal se utilizará como avatar circular y en el fondo animado de Reproducción en Curso."
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <ui:Button Appearance="Primary" Padding="20,7" HorizontalAlignment="Right"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding CloseArtistGalleryCommand}">
                            <TextBlock Text="Cerrar" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- ARTIST BIO MODAL                                               -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="9250"
              Visibility="{Binding IsArtistBioModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#D00A0A0F" />

            <Border Width="640" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="16" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                    Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.75" ShadowDepth="10" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header with Avatar & Name -->
                        <RowDefinition Height="*" />    <!-- Bio Content -->
                        <RowDefinition Height="Auto" /> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with Avatar & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Circular Avatar with Fallback -->
                        <Border Grid.Column="0" Width="70" Height="70" CornerRadius="35" ClipToBounds="True" Background="#1F1F28" Margin="0,0,16,0">
                            <Grid>
                                <ui:SymbolIcon Symbol="Person24" FontSize="32" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding BioModalAvatar}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BioModalArtistName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Biografía e información proporcionada por Last.fm" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="4" VerticalAlignment="Top"
                                   Command="{Binding CloseArtistBioCommand}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <!-- Row 1: Bio Content with ScrollViewer -->
                    <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource SurfaceCardHoverBrush}"
                            BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                            Padding="16" MinHeight="180" MaxHeight="420">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding BioModalContent}"
                                       FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap" LineHeight="22" />
                        </ScrollViewer>
                    </Border>

                    <!-- Row 2: Footer -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <ui:Button Appearance="Primary" Padding="20,7" HorizontalAlignment="Right"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding CloseArtistBioCommand}">
                            <TextBlock Text="Entendido" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- OPEN-SOURCE LICENSES MODAL                                     -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="9300"
              Visibility="{Binding IsLicensesModalOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#D908080D" />

            <Border Width="760" MaxHeight="680" VerticalAlignment="Center" HorizontalAlignment="Center"
                    CornerRadius="16" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                    Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="44" Color="#000000" Opacity="0.8" ShadowDepth="12" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header -->
                        <RowDefinition Height="*" />    <!-- Licenses List -->
                        <RowDefinition Height="Auto" /> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource SurfaceCardHoverBrush}"
                                BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Certificate24" FontSize="24" Foreground="{Binding Theme.CurrentAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Licencias de Código Abierto — BennyComes v1.2.005" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Agradecemos a los autores y mantenedores de los proyectos open-source que hacen posible BennyComes."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="6" VerticalAlignment="Top"
                                   Command="{Binding CloseLicensesModalCommand}">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <!-- Row 1: Scrollable Open-Source Libraries -->
                    <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                            Padding="14" MaxHeight="490">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Settings.OpenSourceLicenses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Background="{DynamicResource SurfaceCardBrush}"
                                                BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                                Padding="16,14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        <Border CornerRadius="5" Padding="7,2" Margin="10,0,0,0" Background="{DynamicResource SurfaceCardHoverBrush}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <Border CornerRadius="5" Padding="7,2" Margin="6,0,0,0" Background="#2200D26A" BorderBrush="#4400D26A" BorderThickness="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding LicenseType}" FontSize="11" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush, Source={x:Static vm:MainViewModel.Instance}}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <ui:Button Grid.Column="1" Appearance="Secondary" Padding="10,4"
                                                               Command="{Binding Settings.OpenLicenseUrlCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                               CommandParameter="{Binding RepositoryUrl}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Globe24" FontSize="13" Margin="0,0,5,0" />
                                                            <TextBlock Text="Repositorio" FontSize="11" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                </Grid>

                                                <TextBlock Text="{Binding Copyright}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                <TextBlock Text="{Binding LicenseText}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" LineHeight="17" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Row 2: Footer -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="BennyComes v1.2.005 • Reproductor Nativo Bit-Perfect"
                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />

                        <ui:Button Grid.Column="1" Appearance="Primary" Padding="24,8"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding CloseLicensesModalCommand}">
                            <TextBlock Text="Cerrar" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
