                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="18" Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ui:Button Grid.Column="2" Appearance="Danger" Padding="8,4"
                                                           Command="{Binding DataContext.Settings.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" ToolTip="Quitar carpeta y eliminar sus canciones de la base de datos">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" Margin="0,0,4,0" />
                                                        <TextBlock Text="Quitar" FontSize="11" />
                                                    </StackPanel>
