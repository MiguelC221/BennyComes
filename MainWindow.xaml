                        <StackPanel Grid.Column="0" Margin="0,0,20,0" HorizontalAlignment="Center">
                            <Border Width="130" Height="130" CornerRadius="10" ClipToBounds="True" Background="#26FFFFFF" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding EditPlaylistCoverPreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="48" Foreground="{Binding Theme.CurrentAccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditPlaylistCoverPreview}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Border>
