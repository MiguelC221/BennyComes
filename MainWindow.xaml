                                            <TextBlock Grid.Row="2" Text="{Binding DisplayFrequency}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
