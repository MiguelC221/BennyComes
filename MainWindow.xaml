                    Width="440" CornerRadius="14" Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                    Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.7" ShadowDepth="8" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <ui:SymbolIcon Symbol="Warning24" FontSize="22" Foreground="#FFFFB900" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Canción Duplicada" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding DuplicateDialogMessage}"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,20" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Appearance="Secondary" Padding="16,7" Margin="0,0,10,0"
                                   Command="{Binding CancelDuplicateCommand}">
                            <TextBlock Text="Cancelar" FontSize="12" />
