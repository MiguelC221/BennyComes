<UserControl x:Class="BenyComes.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:BenyComes.Models"
             xmlns:vm="clr-namespace:BenyComes.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="980">

    <ScrollViewer x:Name="HomeScrollViewer" VerticalScrollBarVisibility="Auto" Margin="32,20,32,20">
        <StackPanel Margin="0,0,0,30">
            <!-- ============================================================== -->
            <!-- 1. HEADER & QUICK ACTIONS                                     -->
            <!-- ============================================================== -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Home.Greeting}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="Continúa disfrutando de tu biblioteca musical con máxima fidelidad de audio"
                               FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Primary" Padding="16,9" Margin="0,0,12,0"
                               Background="{Binding Theme.CurrentAccentBrush}"
                               Command="{Binding Home.ResumePlaybackCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Reanudar escucha" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="13" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary" Padding="16,9"
                               Command="{Binding Home.DailyRandomMixCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Mix Diario Aleatorio" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>

            <!-- ============================================================== -->
            <!-- 2. SECCIÓN: RECOMENDACIONES Y MIXES INTELIGENTES              -->
            <!-- ============================================================== -->
            <Grid Margin="0,4,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="{Binding Theme.CurrentAccentBrush}" Width="4" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Recomendaciones y Mixes Diarios" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Selecciones personalizadas y listas inteligentes adaptadas a tus gustos" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,3,0,0" />
                </StackPanel>
            </Grid>

            <Grid SizeChanged="OnSmartMixContainerSizeChanged" Margin="0,0,0,28">
                <ItemsControl ItemsSource="{Binding Home.SmartMixes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Home.SmartMixColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SmartMixItemModel}">
                            <Border Height="140" Margin="0,0,14,14" CornerRadius="14"
                                    Background="{Binding CardBackgroundBrush}"
                                    BorderBrush="{Binding CardBorderBrush}"
                                    BorderThickness="1"
                                    Padding="16" Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding Command}" CommandParameter="{Binding CommandParameter}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Icon Badge, Title/Subtitle & Category Tag -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="36" Height="36" CornerRadius="18" Background="{Binding BadgeBackgroundColor}" Margin="0,0,10,0">
                                                <ui:SymbolIcon Symbol="{Binding Symbol}" FontSize="18" Foreground="{Binding AccentColor}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#C8D0D8" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Category Tag Pill -->
                                        <Border Grid.Column="1" Background="{Binding BadgeBackgroundColor}" CornerRadius="10" Padding="8,2" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding CategoryTag}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding AccentColor}" />
                                        </Border>
                                    </Grid>

                                    <!-- Row 1: Description / Count -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="#B0B8C4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />

                                    <!-- Row 2: Play Button -->
                                    <ui:Button Grid.Row="2" Appearance="Secondary" Padding="14,5" HorizontalAlignment="Right"
                                               Command="{Binding Command}"
                                               CommandParameter="{Binding CommandParameter}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play24" FontSize="13" Foreground="{Binding AccentColor}" Margin="0,0,6,0" />
                                            <TextBlock Text="Reproducir" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ============================================================== -->
            <!-- 3. SECCIÓN: TOP CANCIONES Y ESTADÍSTICAS                      -->
            <!-- ============================================================== -->
            <Grid Margin="0,10,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="#FF3B82F6" Width="4" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Top Canciones Escuchadas" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Tus temas más reproducidos según el período seleccionado" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,3,0,0" />
                </StackPanel>

                <!-- Period Segmented Buttons -->
                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Este Mes" Padding="12,4" Margin="0,0,2,0" Cursor="Hand" BorderThickness="0"
                                Command="{Binding Home.SetPeriodCommand}" CommandParameter="Month">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Home.SelectedPeriod}" Value="Month">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Este Año" Padding="12,4" Margin="0,0,2,0" Cursor="Hand" BorderThickness="0"
                                Command="{Binding Home.SetPeriodCommand}" CommandParameter="Year">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Home.SelectedPeriod}" Value="Year">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Histórico" Padding="12,4" Cursor="Hand" BorderThickness="0"
                                Command="{Binding Home.SetPeriodCommand}" CommandParameter="AllTime">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Home.SelectedPeriod}" Value="AllTime">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Top Tracks Sub-header -->
            <Grid Margin="0,8,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Top Canciones" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                <ui:Button Grid.Column="1" Appearance="Secondary" Padding="12,6"
                           Command="{Binding Home.PlayTopAsPlaylistCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Reproducir Top como Playlist" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <!-- Column Header for Top Tracks -->
            <Grid Margin="12,0,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="70" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="" />
                <TextBlock Grid.Column="2" Text="TÍTULO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" />
                <TextBlock Grid.Column="3" Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="4" Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="5" Text="REPROD." FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
            </Grid>

            <!-- Top Tracks List with Scroll pass-through -->
            <ListView ItemsSource="{Binding Home.TopTracks}"
                      PreviewMouseWheel="OnListViewPreviewMouseWheel"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Margin="0,0,0,28">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="6,4">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Track}">
                        <Grid HorizontalAlignment="Stretch" ContextMenu="{DynamicResource TrackContextMenu}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>

                            <!-- Position Badge (Gold, Silver, Bronze for Top 3) -->
                            <Border Grid.Column="0" Width="28" Height="22" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1AFFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Rank}" Value="1">
                                                <Setter Property="Background" Value="#33FFD700" />
                                                <Setter Property="BorderBrush" Value="#66FFD700" />
                                                <Setter Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rank}" Value="2">
                                                <Setter Property="Background" Value="#2AE0E0E0" />
                                                <Setter Property="BorderBrush" Value="#55E0E0E0" />
                                                <Setter Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Rank}" Value="3">
                                                <Setter Property="Background" Value="#33CD7F32" />
                                                <Setter Property="BorderBrush" Value="#66CD7F32" />
                                                <Setter Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Rank, StringFormat='{}#{0}'}" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Rank}" Value="1">
                                                    <Setter Property="Foreground" Value="#FFFFD700" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Rank}" Value="2">
                                                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Rank}" Value="3">
                                                    <Setter Property="Foreground" Value="#FFFFA07A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- Cover Image with Play on click -->
                            <Grid Grid.Column="1" Width="36" Height="36" HorizontalAlignment="Center" Cursor="Hand">
                                <Border CornerRadius="6" ClipToBounds="True" Background="#22FFFFFF">
                                    <Image Source="{Binding CoverImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <ui:Button Appearance="Transparent" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                           Command="{Binding DataContext.PlayTrackNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="14" Foreground="#FFFFFF" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </ui:Button>
                            </Grid>

                            <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,10,0" />

                            <TextBlock Grid.Column="3" Text="{Binding Artist}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />

                            <TextBlock Grid.Column="4" Text="{Binding Album}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />

                            <TextBlock Grid.Column="5" Text="{Binding PlayCount, StringFormat='{}{0} repr.'}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <TextBlock Grid.Column="6" Text="{Binding DurationFormatted}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ============================================================== -->
            <!-- 4. SECCIÓN: TOP ARTISTAS RECOMENDADOS                          -->
            <!-- ============================================================== -->
            <Grid Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="#FF10B981" Width="4" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Top Artistas Recomendados" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Los intérpretes con mayor rotación en tu biblioteca musical" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,3,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Secondary" Padding="14,7"
                           Command="{Binding Home.PlayTopArtistsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="14" Foreground="#FF10B981" Margin="0,0,6,0" />
                        <TextBlock Text="Reproducir discografía" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding Home.TopArtists}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ArtistModel}">
                        <Border Width="130" Margin="0,0,16,14" CornerRadius="12"
                                Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                Padding="10" Cursor="Hand">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Reproducir discografía"
                                              Command="{Binding DataContext.PlayArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Play24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ir a artista"
                                              Command="{Binding DataContext.NavigateToArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding Name}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Person24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.PlayArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="80" Height="80" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <Border Width="80" Height="80" CornerRadius="40" ClipToBounds="True" Background="#1F1F28">
                                        <Image Source="{Binding AvatarImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <!-- Hover Play Button Overlay -->
                                    <Border x:Name="TopArtistHover" Width="80" Height="80" CornerRadius="40" Background="#66000000" Opacity="0">
                                        <ui:Button Appearance="Transparent" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Command="{Binding DataContext.PlayArtistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Play24" FontSize="18" Foreground="#FFFFFF" />
                                        </ui:Button>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="110" />
                                <TextBlock Text="{Binding TrackCount, StringFormat='{}{0} canciones'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TopArtistHover" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TopArtistHover" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============================================================== -->
            <!-- 5. SECCIÓN: TOP ÁLBUMES RECOMENDADOS                          -->
            <!-- ============================================================== -->
            <Grid Margin="0,14,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="#FF8B5CF6" Width="4" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Top Álbumes Recomendados" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Las producciones discográficas esenciales de tu colección" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,3,0,0" />
                </StackPanel>
                <ui:Button Grid.Column="1" Appearance="Secondary" Padding="14,7"
                           Command="{Binding Home.PlayTopAlbumsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" FontSize="14" Foreground="#FF8B5CF6" Margin="0,0,6,0" />
                        <TextBlock Text="Reproducir álbumes" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Button>
            </Grid>

            <ItemsControl ItemsSource="{Binding Home.TopAlbums}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:AlbumModel}">
                        <Border Width="150" Margin="0,0,16,14" CornerRadius="10"
                                Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                Padding="10" Cursor="Hand">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Reproducir álbum"
                                              Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Play24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ir a álbum"
                                              Command="{Binding DataContext.NavigateToAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding Name}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Album24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <StackPanel>
                                <Grid Width="130" Height="130" Margin="0,0,0,8">
                                    <Border CornerRadius="8" ClipToBounds="True" Background="#22FFFFFF">
                                        <Image Source="{Binding CoverImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <!-- Hover Play Button Overlay -->
                                    <Border x:Name="TopAlbumHover" CornerRadius="8" Background="#66000000" Opacity="0">
                                        <ui:Button Appearance="Transparent" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Play24" FontSize="22" Foreground="#FFFFFF" />
                                        </ui:Button>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxWidth="130" />
                            </StackPanel>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TopAlbumHover" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TopAlbumHover" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
