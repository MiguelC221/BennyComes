<UserControl x:Class="BenyComes.Views.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:BenyComes.Models"
             xmlns:vm="clr-namespace:BenyComes.ViewModels"
             xmlns:views="clr-namespace:BenyComes.Views"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="980">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/ArtistSectionTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared ContextMenu for Favorites Songs -->
        <ContextMenu x:Key="SharedFavoritesTrackContextMenu">
            <MenuItem Header="Reproducir"
                      Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Favorites.PlayTrackCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Reproducir siguiente"
                      Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Favorites.PlayTrackNextCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Next24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Agregar a la cola"
                      Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Favorites.AddTrackToQueueCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Ir al artista"
                      Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Favorites.OpenArtistByNameCommand}"
                      CommandParameter="{Binding Artist}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Person24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Ver información de álbum"
                      Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Favorites.OpenTrackAlbumCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Album24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Quitar de Favoritos ♥"
                      Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleFavoriteCommand}"
                      CommandParameter="{Binding}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Heart24" Filled="True" Foreground="#E81123" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Shared ItemTemplate for Favorite Tracks (osu! Library style) -->
        <DataTemplate x:Key="FavoriteTrackRowTemplate" DataType="{x:Type models:Track}">
            <Grid Background="Transparent">
                <Grid.InputBindings>
                    <MouseBinding Gesture="LeftClick"
                                  Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Favorites.PlayTrackCommand}"
                                  CommandParameter="{Binding}" />
                </Grid.InputBindings>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Thumbnail -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" Margin="0,0,14,0" ClipToBounds="True" Background="{DynamicResource SurfaceCardBrush}">
                    <Image Source="{Binding CoverImageSource}" Stretch="UniformToFill" />
                </Border>

                <!-- Title & Artist -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Video Badge Icon -->
                        <Border Margin="8,0,0,0" Padding="4,1" CornerRadius="4"
                                Background="{DynamicResource SurfaceCardSubtleBrush}"
                                BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                ToolTip="Contiene video musical (osu!)"
                                Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Video24" FontSize="11" Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,3,0" />
                                <TextBlock Text="VIDEO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Middle Column: Source / Genre / Album -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Border Padding="6,2" CornerRadius="6" HorizontalAlignment="Left"
                            Background="{DynamicResource SurfaceCardSubtleBrush}"
                            BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                            Visibility="{Binding HasOsuSource, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="{Binding OsuSource, StringFormat='Fuente / Origen: {0}'}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Tag24" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding OsuSource}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Duration, Favorite Heart & Playing Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,10,0">
                    <ui:SymbolIcon Symbol="Speaker224" FontSize="14"
                                   Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Margin="0,0,10,0"
                                   Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisConverter}}" />

                    <!-- Botón de Favorito (Corazón) -->
                    <Button Width="30" Height="30" Padding="0" Margin="0,0,10,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            ToolTip="Quitar o agregar a Favoritos"
                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleFavoriteCommand}"
                            CommandParameter="{Binding}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="FavBdr" CornerRadius="6" Background="Transparent">
                                    <ui:SymbolIcon x:Name="FavIcon" Symbol="Heart24" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="FavBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="FavIcon" Property="Filled" Value="True" />
                                        <Setter TargetName="FavIcon" Property="Foreground" Value="#FFE81123" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="{Binding DurationFormatted}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Shared ItemContainerStyle for Virtualized Favorites ListViews -->
        <Style x:Key="FavoriteListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ContextMenu" Value="{StaticResource SharedFavoritesTrackContextMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#250078D4" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: HEADER / NAVIGATION TABS + COMBINAR LIBRERÍAS + SEARCH  -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,16"
              Visibility="{Binding Favorites.IsInDetailView, Converter={StaticResource InverseBoolToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Either the 2 Tabs (Biblioteca / osu!library) OR Combined Header when IsCombinedMode=True -->
            <Grid Grid.Column="0" VerticalAlignment="Center">
                <!-- Tabs Bar (Visible when NOT combining libraries) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Favorites.ShowTabsBar, Converter={StaticResource BoolToVisConverter}}">
                    <!-- Tab 0: Biblioteca -->
                    <Button Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Margin="0,0,22,0" Padding="0" Cursor="Hand"
                            Command="{Binding Favorites.SelectTabCommand}" CommandParameter="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Biblioteca" FontSize="20" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Favorites.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Rectangle Height="3" Margin="0,6,0,0" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleX="1" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Favorites.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="0">
                                                        <Setter Property="Fill" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     From="0.2" To="1.0" Duration="0:0:0.25">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Tab 1: osu!library -->
                    <Button Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Margin="0,0,16,0" Padding="0" Cursor="Hand"
                            Command="{Binding Favorites.SelectTabCommand}" CommandParameter="1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="osu!library" FontSize="20" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Favorites.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Rectangle Height="3" Margin="0,6,0,0" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,0.5">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleX="1" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.Favorites.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="1">
                                                        <Setter Property="Fill" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                     From="0.2" To="1.0" Duration="0:0:0.25">
                                                                        <DoubleAnimation.EasingFunction>
                                                                            <CubicEase EasingMode="EaseOut" />
                                                                        </DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Combined Mode Header (Visible when IsCombinedMode == True and tabs disappear) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Favorites.IsCombinedMode, Converter={StaticResource BoolToVisConverter}}">
                    <ui:SymbolIcon Symbol="Heart24" Filled="True" FontSize="22" Foreground="#FFE81123" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="Favoritos" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="6"
                            Background="{DynamicResource SurfaceCardSubtleBrush}"
                            BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <TextBlock Text="Biblioteca + osu!library" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Right: "Combinar librerías" Toggle + Search Box -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ToolTip="Oculta las pestañas y combina las canciones favoritas de Biblioteca y osu!library en una sola lista">
                    <CheckBox IsChecked="{Binding Favorites.IsCombinedMode, Mode=TwoWay}"
                              Cursor="Hand" VerticalContentAlignment="Center">
                        <TextBlock Text="Combinar librerías" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="4,0,0,0" />
                    </CheckBox>
                </Border>

                <ui:TextBox Width="240" PlaceholderText="Buscar en favoritos..."
                            Text="{Binding Favorites.SearchFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 1: ACTION BAR (SHUFFLE ALL & COUNTERS)                     -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" Margin="0,0,0,16"
              Visibility="{Binding Favorites.IsInDetailView, Converter={StaticResource InverseBoolToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Appearance="Primary" Padding="14,8"
                       Background="{Binding Theme.CurrentAccentBrush}"
                       Command="{Binding Favorites.PlayAllShuffledCommand}"
                       ToolTip="Reproducir favoritos actuales en orden aleatorio">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="16" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Reproducción aleatoria" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="13" />
                </StackPanel>
            </ui:Button>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Favorites.CurrentSongsCountText}"
                           FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 2: CONTENT AREA (ANIMATED TABS, COMBINED & DETAIL VIEWS)   -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2">

            <!-- 1. PESTAÑA 0: BIBLIOTECA (Separada, con animación de transición) -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Favorites.ShowLibraryTabContent}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="14" To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ListView x:Name="LibrarySongsListView"
                          ItemsSource="{Binding Favorites.LibrarySongs}"
                          Visibility="{Binding Favorites.LibrarySongs.Count, Converter={StaticResource BoolToVisConverter}}"
                          ItemContainerStyle="{StaticResource FavoriteListViewItemStyle}"
                          ItemTemplate="{StaticResource FavoriteTrackRowTemplate}"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          AlternationCount="2"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel Margin="0,12,0,6">
                                                    <Button Style="{StaticResource AlphaGroupHeaderButtonStyle}"
                                                            Content="{Binding Name}"
                                                            Click="OnAlphaHeaderClick" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Empty State for Biblioteca Favorites -->
                <Border Visibility="{Binding Favorites.LibrarySongs.Count, Converter={StaticResource InverseBoolToVisConverter}}"
                        Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28,36" Margin="10,20,10,20"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="520">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1AE81123" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Heart24" FontSize="28" Foreground="#FFE81123" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Sin favoritos en tu Biblioteca" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Marca canciones con el corazón ♥ desde el reproductor, mini reproductor, listas de reproducción o Mi música para verlas aquí."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. PESTAÑA 1: OSU!LIBRARY (Separada, con animación de transición) -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Favorites.ShowOsuTabContent}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="14" To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ListView x:Name="OsuSongsListView"
                          ItemsSource="{Binding Favorites.OsuSongs}"
                          Visibility="{Binding Favorites.OsuSongs.Count, Converter={StaticResource BoolToVisConverter}}"
                          ItemContainerStyle="{StaticResource FavoriteListViewItemStyle}"
                          ItemTemplate="{StaticResource FavoriteTrackRowTemplate}"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          AlternationCount="2"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel Margin="0,12,0,6">
                                                    <Button Style="{StaticResource AlphaGroupHeaderButtonStyle}"
                                                            Content="{Binding Name}"
                                                            Click="OnAlphaHeaderClick" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Empty State for osu!library Favorites -->
                <Border Visibility="{Binding Favorites.OsuSongs.Count, Converter={StaticResource InverseBoolToVisConverter}}"
                        Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28,36" Margin="10,20,10,20"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="520">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1AE81123" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Heart24" FontSize="28" Foreground="#FFE81123" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Sin favoritos en osu!library" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Marca mapas y canciones de osu! con el corazón ♥ en Osu! Library, el mini reproductor o el reproductor inmersivo."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. VISTA COMBINADA (Cuando Combinar librerías está activo) -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Favorites.ShowCombinedContent}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="14" To="0" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ListView x:Name="CombinedSongsListView"
                          ItemsSource="{Binding Favorites.CombinedSongs}"
                          Visibility="{Binding Favorites.CombinedSongs.Count, Converter={StaticResource BoolToVisConverter}}"
                          ItemContainerStyle="{StaticResource FavoriteListViewItemStyle}"
                          ItemTemplate="{StaticResource FavoriteTrackRowTemplate}"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          AlternationCount="2"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel Margin="0,12,0,6">
                                                    <Button Style="{StaticResource AlphaGroupHeaderButtonStyle}"
                                                            Content="{Binding Name}"
                                                            Click="OnAlphaHeaderClick" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Empty State for Combined Favorites -->
                <Border Visibility="{Binding Favorites.CombinedSongs.Count, Converter={StaticResource InverseBoolToVisConverter}}"
                        Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28,36" Margin="10,20,10,20"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="520">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1AE81123" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Heart24" FontSize="28" Foreground="#FFE81123" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Aún no tienes canciones favoritas" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Marca tus canciones favoritas de la Biblioteca o de osu! con el botón ♥ para tenerlas todas reunidas aquí."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DETAIL VIEW 1: InfoArtista -->
            <views:InfoArtista Artist="{Binding Favorites.SelectedArtistDetail}"
                               PlayArtistCommand="{Binding Favorites.PlayArtistCommand}"
                               PlayTrackCommand="{Binding Favorites.PlayTrackCommand}"
                               TrackContextMenu="{StaticResource SharedFavoritesTrackContextMenu}" />

            <!-- DETAIL VIEW 2: InfoAlbum -->
            <views:InfoAlbum Album="{Binding Favorites.SelectedAlbumDetail}"
                             OpenArtistByNameCommand="{Binding Favorites.OpenArtistByNameCommand}"
                             PlayTrackCommand="{Binding Favorites.PlayTrackCommand}"
                             TrackContextMenu="{StaticResource SharedFavoritesTrackContextMenu}" />
        </Grid>

        <!-- ============================================================== -->
        <!-- JUMPLIST WINDOWS-STYLE MODAL SELECTOR (29 LETTERS)             -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Margin="-28,-16,-28,-10"
              Visibility="{Binding Favorites.IsJumpListOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#CC09090E" ClipToBounds="True">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding Favorites.CloseJumpListCommand}" />
            </Grid.InputBindings>

            <Border Width="340" Padding="20" CornerRadius="16"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.6" Color="#000000" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Saltar a letra" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,14" />

                    <ItemsControl ItemsSource="{Binding Favorites.JumpListLetters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Letter}"
                                        IsEnabled="{Binding HasItems}"
                                        Command="{Binding DataContext.Favorites.SelectJumpLetterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Letter}"
                                        Width="44" Height="44" Margin="3"
                                        Cursor="Hand" FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="LtrBorder" CornerRadius="8" Background="#14FFFFFF" BorderBrush="Transparent" BorderThickness="1">
                                                <TextBlock x:Name="LtrText" Text="{TemplateBinding Content}"
                                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                                           FontSize="17" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="LtrBorder" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="LtrText" Property="Opacity" Value="0.22" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsEnabled" Value="True" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="LtrBorder" Property="Background" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Setter TargetName="LtrText" Property="Foreground" Value="{Binding DataContext.Theme.AccentForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
