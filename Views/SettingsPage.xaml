<UserControl x:Class="BenyComes.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="28,20,28,30">
            <!-- Header -->
            <TextBlock Text="Configuración"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24" />

            <!-- ============================================== -->
            <!-- SECTION 1: BIBLIOTECA DE MÚSICA (CARPETAS)    -->
            <!-- ============================================== -->
            <Border x:Name="LibraryFoldersCard" CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Settings.HighlightLibraryFoldersSection}" Value="True">
                                <Setter Property="BorderBrush" Value="{Binding Theme.CurrentAccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Biblioteca de Música" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Carpetas locales supervisadas para indexación de canciones, álbumes y artistas."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary" Padding="14,7"
                                       Background="{Binding Theme.CurrentAccentBrush}"
                                       Command="{Binding Settings.AddFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Agregar carpeta..." FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Rescan Button & Status -->
                    <Grid Margin="0,4,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Settings.ScanningStatus}" FontSize="12" Foreground="{Binding Theme.CurrentAccentBrush}" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="12,5"
                                   Command="{Binding Settings.RescanAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Re-escanear todo" FontSize="12" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- Folders List -->
                    <ItemsControl ItemsSource="{Binding Settings.LibraryFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Background="{DynamicResource SurfaceCardHoverBrush}" Padding="12,8" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Grid.Column="0" Symbol="Folder24" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <ui:Button Grid.Column="2" Appearance="Danger" Padding="6,3"
                                                   Command="{Binding DataContext.Settings.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" ToolTip="Quitar carpeta">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Base Button: Administrar carpetas de música -->
                    <ui:Button Appearance="Secondary" Padding="12,7" Margin="0,12,0,0"
                               HorizontalAlignment="Right"
                               Command="{Binding Settings.OpenLibraryFoldersModalCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="15" Margin="0,0,6,0" />
                            <TextBlock Text="Administrar carpetas de música" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- SECTION 2: PERSONALIZACIÓN Y COLORES           -->
            <!-- ============================================== -->
            <Border CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="Color24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="Personalización y Colores" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Theme Selector -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tema de la Aplicación" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Selecciona entre tema oscuro, claro o según la configuración del sistema." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="170"
                                  SelectedValue="{Binding Settings.SelectedTheme, Mode=TwoWay}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="Oscuro" />
                            <ComboBoxItem Content="Claro" />
                        </ComboBox>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- Dynamic Accent Extraction Switch -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Color de Acento Reactivo (Material You)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Extraer y aplicar automáticamente el color vibrante de la carátula de la canción en reproducción." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding Settings.AutoExtractAccent, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Preset Palette Swatches -->
                    <TextBlock Text="Paleta de Colores de Acento Predefinidos:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <!-- Emerald -->
                        <Button Width="36" Height="36" Margin="0,0,10,0" Click="OnAccentEmeraldClick" ToolTip="Verde Esmeralda" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border CornerRadius="18" Background="#00D26A" BorderBrush="#FFFFFF" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Groove Blue -->
                        <Button Width="36" Height="36" Margin="0,0,10,0" Click="OnAccentBlueClick" ToolTip="Azul Groove" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border CornerRadius="18" Background="#0078D7" BorderBrush="#FFFFFF" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Cyan Hi-Fi -->
                        <Button Width="36" Height="36" Margin="0,0,10,0" Click="OnAccentCyanClick" ToolTip="Cian Hi-Fi" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border CornerRadius="18" Background="#00B7C3" BorderBrush="#FFFFFF" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Purple -->
                        <Button Width="36" Height="36" Margin="0,0,10,0" Click="OnAccentPurpleClick" ToolTip="Morado Eléctrico" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border CornerRadius="18" Background="#8764B8" BorderBrush="#FFFFFF" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Magenta -->
                        <Button Width="36" Height="36" Margin="0,0,10,0" Click="OnAccentMagentaClick" ToolTip="Rosa Magenta" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border CornerRadius="18" Background="#E3008C" BorderBrush="#FFFFFF" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Orange -->
                        <Button Width="36" Height="36" Margin="0,0,10,0" Click="OnAccentOrangeClick" ToolTip="Naranja Neón" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate>
                                    <Border CornerRadius="18" Background="#FF8C00" BorderBrush="#FFFFFF" BorderThickness="2" />
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- SECTION 3: REPRODUCCIÓN EN CURSO & VISUALIZADOR -->
            <!-- ============================================== -->
            <Border CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SoundSource24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Personalización de Reproducción en Curso" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Ajusta el fondo animado con efecto Ken Burns, difuminado, oscurecimiento y visualizadores."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,2,0,0" />
                        </StackPanel>

                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="12,6"
                                   Command="{Binding Settings.OpenCurrentArtistGalleryCommand}"
                                   ToolTip="Abrir galería de fotos y selector del artista en reproducción">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="Galería de fotos del artista" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- Switch: Usar imágenes de artista en el fondo -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Usar imágenes de artista en el fondo" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Muestra la galería de fotos descargadas del artista con transición suave y efecto Ken Burns." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Desactivado" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.UseArtistBackground}" Value="True">
                                                <Setter Property="Text" Value="Activado" />
                                                <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.UseArtistBackground, Mode=TwoWay}"
                                             OffContent="" OnContent=""
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- Background Darkness Slider -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Nivel de Oscurecimiento del Fondo" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Controla la opacidad del velo oscuro sobre el fondo (0% a 100%)." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Slider Width="140" Minimum="0.0" Maximum="1.0"
                                    Value="{Binding Settings.NowPlayingBackgroundDarkness, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Settings.NowPlayingBackgroundDarkness, StringFormat='{}{0:P0}'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- Background Blur Slider -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Intensidad del Difuminado (Blur)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Aplica difuminado gaussiano cuando no hay fotos de artista o se usa la portada." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Slider Width="140" Minimum="0" Maximum="80"
                                    Value="{Binding Settings.BackgroundBlurRadius, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Settings.BackgroundBlurRadius, StringFormat='{}{0:F0} px'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- Duración por imagen (segundos) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Duración por Imagen (Segundos)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Intervalo del efecto Ken Burns antes del crossfade a la siguiente imagen (15 a 60 s)." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Slider Width="140" Minimum="15" Maximum="60"
                                    Value="{Binding Settings.ArtistImageIntervalSeconds, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Settings.ArtistImageIntervalSeconds, StringFormat='{}{0} s'}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Width="45" TextAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- Real-Time Audio Visualizer FFT Selector -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Visualizador de Audio en Tiempo Real (FFT)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Muestra barras de espectro, onda reactiva o pulso dinámico de carátula según el ritmo musical." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="180"
                                  SelectedValue="{Binding Settings.SelectedVisualizerMode, Mode=TwoWay}"
                                  SelectedValuePath="Content">
                            <ComboBoxItem Content="Ninguno" />
                            <ComboBoxItem Content="Barras de Espectro" />
                            <ComboBoxItem Content="Onda Reactiva" />
                            <ComboBoxItem Content="Pulso de Carátula" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- SECTION 3.B: SERVICIOS EN LÍNEA (LAST.FM)     -->
            <!-- ============================================== -->
            <Border CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="Servicios en Línea (Last.fm)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Interruptor Maestro: Funciones en línea: Obtener metadatos con Last.fm -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Funciones en línea: Obtener metadatos con Last.fm" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Descarga biografías oficiales y fotos en alta resolución. Si está desactivado, se omiten las peticiones web y se usan únicamente las carátulas locales."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Desactivado" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.IsLastFmEnabled}" Value="True">
                                                <Setter Property="Text" Value="Activado" />
                                                <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.IsLastFmEnabled, Mode=TwoWay}"
                                             OffContent="" OnContent=""
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Sub-option: Buscar y descargar fotos de artistas con Last.fm -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Buscar fotos de artistas con Last.fm" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Obtiene retratos en alta definición en segundo plano para los artistas de tu biblioteca" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Desactivado" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.IsLastFmArtistImageSyncEnabled}" Value="True">
                                                <Setter Property="Text" Value="Activado" />
                                                <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.IsLastFmArtistImageSyncEnabled, Mode=TwoWay}"
                                             IsEnabled="{Binding Settings.IsLastFmEnabled}"
                                             OffContent="" OnContent=""
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- 1. Last.fm API Key Field & Test Button -->
                    <TextBlock Text="API Key de Last.fm (Biografías y Metadatos)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding Settings.LastFmApiKey, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Ingresa tu clave de API de Last.fm (32 caracteres hexadecimales)..."
                                    Background="{DynamicResource SurfaceCardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                        <ui:Button Grid.Column="1" Appearance="Primary" Padding="16,6"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding Settings.TestAndSaveLastFmCommand}"
                                   IsEnabled="{Binding Settings.IsTestingLastFm, Converter={StaticResource InverseBoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="14" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Probar y guardar" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- Last.fm Status Message Box -->
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceCardHoverBrush}" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding Settings.LastFmStatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Settings.LastFmStatusMessage}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,0,0,16">
                        <Run Text="¿No tienes una API key de Last.fm? Puedes crear tu clave personal gratuita en " />
                        <Hyperlink Command="{Binding Settings.OpenLastFmApiSignupCommand}" Cursor="Hand">
                            <Run Text="last.fm/api/account/create" Foreground="{Binding Theme.CurrentAccentBrush}" TextDecorations="Underline" />
                        </Hyperlink>
                    </TextBlock>

                    <!-- 2. Fanart.tv API Key Field & Test Button -->
                    <TextBlock Text="API Key de Fanart.tv (Fotos y Fondos HD de Artistas)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding Settings.FanartTvApiKey, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Ingresa tu clave de API de Fanart.tv (opcional, complementa a Deezer)..."
                                    Background="{DynamicResource SurfaceCardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                        <ui:Button Grid.Column="1" Appearance="Primary" Padding="16,6"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding Settings.TestAndSaveFanartTvCommand}"
                                   IsEnabled="{Binding Settings.IsTestingFanartTv, Converter={StaticResource InverseBoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="14" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,6,0" />
                                <TextBlock Text="Probar y guardar" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <!-- Fanart.tv Status Message Box -->
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceCardHoverBrush}" Padding="12,8" Margin="0,0,0,8"
                            Visibility="{Binding Settings.FanartTvStatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Info24" FontSize="15" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Settings.FanartTvStatusMessage}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,0,0,0" TextWrapping="Wrap">
                        <Run Text="¿Deseas obtener una API key de Fanart.tv? Créala gratis en " />
                        <Hyperlink Command="{Binding Settings.OpenFanartTvApiSignupCommand}" Cursor="Hand">
                            <Run Text="fanart.tv/get-an-api-key" Foreground="{Binding Theme.CurrentAccentBrush}" TextDecorations="Underline" />
                        </Hyperlink>
                        <Run Text=". Las APIs públicas de Deezer y MusicBrainz están integradas de forma nativa y no requieren clave." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- SECTION 3.B: ENRIQUECIMIENTO MASIVO ARTISTAS   -->
            <!-- ============================================== -->
            <Border CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="Enriquecimiento de Artistas en Segundo Plano" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="Obtiene biografías oficiales mediante la API de Last.fm y fotos en alta definición (Fanart.tv y Deezer) para todos los artistas de tu colección sin ralentizar la app."
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="30,0,0,16" TextWrapping="Wrap" />

                    <!-- Status & Controls -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Estado: " FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Settings.ArtistEnrichment.StatusText}" FontSize="13" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Settings.ArtistEnrichment.CurrentArtistName, StringFormat='Artista actual: {0}'}"
                                       FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,2,0,0"
                                       Visibility="{Binding Settings.ArtistEnrichment.IsRunning, Converter={StaticResource BoolToVisConverter}}" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Iniciar / Actualizar todos -->
                            <ui:Button Appearance="Primary" Padding="14,6" Margin="0,0,8,0"
                                       Background="{Binding Theme.CurrentAccentBrush}"
                                       Command="{Binding Settings.StartEnrichmentCommand}"
                                       IsEnabled="{Binding Settings.ArtistEnrichment.IsRunning, Converter={StaticResource InverseBoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Actualizar información de todos los artistas" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Pausar -->
                            <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,8,0"
                                       Command="{Binding Settings.PauseEnrichmentCommand}"
                                       Visibility="{Binding Settings.ArtistEnrichment.IsRunning, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Pause24" FontSize="14" Margin="0,0,4,0" />
                                    <TextBlock Text="Pausar" FontSize="12" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Reanudar -->
                            <ui:Button Appearance="Secondary" Padding="10,6" Margin="0,0,8,0"
                                       Command="{Binding Settings.ResumeEnrichmentCommand}"
                                       Visibility="{Binding Settings.ArtistEnrichment.IsPaused, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" FontSize="14" Margin="0,0,4,0" />
                                    <TextBlock Text="Reanudar" FontSize="12" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Cancelar -->
                            <ui:Button Appearance="Transparent" Padding="8,6"
                                       Command="{Binding Settings.CancelEnrichmentCommand}"
                                       Visibility="{Binding Settings.ArtistEnrichment.IsRunning, Converter={StaticResource BoolToVisConverter}}"
                                       ToolTip="Cancelar cola actual">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#E81123" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Progress Bar (visible when running or paused) -->
                    <StackPanel Margin="0,4,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.ArtistEnrichment.IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Settings.ArtistEnrichment.IsPaused}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ProgressBar Value="{Binding Settings.ArtistEnrichment.ProgressPercentage}" Minimum="0" Maximum="100" Height="6"
                                     Foreground="{Binding Theme.CurrentAccentBrush}" Background="{DynamicResource SurfaceCardHoverBrush}" Margin="0,0,0,6" />
                        <Grid>
                            <TextBlock Text="{Binding Settings.ArtistEnrichment.ProcessedCount, StringFormat='{}{0} procesados'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding Settings.ArtistEnrichment.PendingCount, StringFormat='{}{0} pendientes'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- SECTION 4: REPRODUCCIÓN Y AUDIO                -->
            <!-- ============================================== -->
            <Border CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ui:SymbolIcon Symbol="Speaker224" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                        <TextBlock Text="Reproducción y Audio" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Autoplay Switch -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Reproducir automáticamente al iniciar BenyComes" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Cargar y reanudar automáticamente la última canción reproducida al abrir el reproductor." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Desactivado" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.IsAutoplayOnStartup}" Value="True">
                                                <Setter Property="Text" Value="Activado" />
                                                <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.IsAutoplayOnStartup, Mode=TwoWay}"
                                             OffContent="" OnContent=""
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- SECTION 5: INDEXADOR INTELIGENTE DE ARTISTAS   -->
            <!-- ============================================== -->
            <Border CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="People24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Indexador Inteligente de Artistas" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Configura los separadores activos y la lista blanca de excepciones para dividir colaboraciones sin romper nombres de bandas."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Secondary" Padding="12,6" Margin="0,0,8,0"
                                       Command="{Binding Settings.ResetArtistConfigCommand}"
                                       ToolTip="Restaurar separadores y excepciones predeterminados">
                                <TextBlock Text="Valores por defecto" FontSize="12" />
                            </ui:Button>
                            <ui:Button Appearance="Primary" Padding="14,7"
                                       Background="{Binding Theme.CurrentAccentBrush}"
                                       Command="{Binding Settings.ReindexArtistsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Guardar y re-indexar biblioteca" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="12" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!-- Status Banner when Re-indexing -->
                    <Border CornerRadius="8" Background="{DynamicResource SurfaceCardHoverBrush}" Padding="10,6" Margin="0,0,0,12"
                            Visibility="{Binding Settings.ReindexStatusText, Converter={StaticResource StringToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="14" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Settings.ReindexStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- 1. Separadores Activos -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Separadores activos" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text=" (ej. ',', ';', 'feat.', '&amp;', '/')" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="10,4"
                                   Command="{Binding Settings.OpenSeparatorsModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Open24" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Settings.ArtistSeparators.Count, StringFormat='Ver separadores ({0})'}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding Settings.NewSeparatorText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Escribe un separador (ej. 'feat.', ';', '/')..."
                                    Background="{DynamicResource SurfaceCardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="14,6"
                                   Command="{Binding Settings.AddSeparatorCommand}">
                            <TextBlock Text="+ Agregar separador" FontSize="12" FontWeight="SemiBold" />
                        </ui:Button>
                    </Grid>

                    <Border CornerRadius="8" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="10,10,10,2" Margin="0,0,0,16">
                        <ItemsControl ItemsSource="{Binding Settings.ArtistSeparators}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Background="{DynamicResource SurfaceCardHoverBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                            Padding="10,4" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:Button Appearance="Transparent" Padding="2" ToolTip="Eliminar separador"
                                                       Command="{Binding DataContext.Settings.RemoveSeparatorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,14" />

                    <!-- 2. Lista Blanca de Excepciones -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Lista blanca de excepciones" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text=" (ej. 'Tyler, The Creator', 'AC/DC', 'Earth, Wind &amp; Fire')" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="10,4"
                                   Command="{Binding Settings.OpenExceptionsModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Open24" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Settings.ArtistExceptions.Count, StringFormat='Ver excepciones ({0})'}" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" Text="{Binding Settings.NewExceptionText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Escribe un artista o banda con símbolos (ej. 'Tyler, The Creator', 'AC/DC')..."
                                    Background="{DynamicResource SurfaceCardHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="14,6"
                                   Command="{Binding Settings.AddExceptionCommand}">
                            <TextBlock Text="+ Agregar excepción" FontSize="12" FontWeight="SemiBold" />
                        </ui:Button>
                    </Grid>

                    <Border CornerRadius="8" Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="10,10,10,2" Margin="0,0,0,4">
                        <ItemsControl ItemsSource="{Binding Settings.ArtistExceptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Background="{DynamicResource SurfaceCardHoverBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                            Padding="10,4" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:Button Appearance="Transparent" Padding="2" ToolTip="Eliminar excepción"
                                                       Command="{Binding DataContext.Settings.RemoveExceptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       CommandParameter="{Binding}">
                                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </ui:Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- SECTION 6: MANTENIMIENTO Y DIAGNÓSTICO         -->
            <!-- ============================================== -->
            <Border CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Wrench24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="Mantenimiento y Diagnóstico" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Herramientas de diagnóstico de memoria, registro detallado y captura de errores del sistema."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Debug Mode Switch -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Modo Debug y Registro Detallado" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Monitorea y registra periódicamente el consumo de memoria RAM (Working Set y GC Heap) en debug_log.txt para detectar fugas de memoria."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Desactivado" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.IsDebugModeEnabled}" Value="True">
                                                <Setter Property="Text" Value="Activado" />
                                                <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.IsDebugModeEnabled, Mode=TwoWay}"
                                             OffContent="" OnContent=""
                                             VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- Open Logs Folder Button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Registros y Reportes de Fallos" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Accede directamente a la carpeta local donde se almacenan los logs de diagnóstico y reportes de crash (%LocalAppData%\BenyComes\Logs\)."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="14,7"
                                   Command="{Binding Settings.OpenLogsFolderCommand}"
                                   ToolTip="Abrir carpeta de logs en el Explorador de Windows">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Abrir carpeta de registros (Logs)" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,16,0,16" />

                    <!-- Emergency Reset (Borrar todo y empezar desde cero) -->
                    <Border CornerRadius="8" Background="#1AE81123" BorderBrush="#4DE81123" BorderThickness="1" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="#FFE81123" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Zona de Emergencia: Restablecer y Empezar de Cero" FontSize="14" FontWeight="Bold" Foreground="#FFFF5555" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Borra de manera irreversible toda la base de datos de música, canciones, álbumes, favoritos, caché de fotos/biografías de artistas y configuraciones locales. La aplicación se reiniciará completamente limpia desde 0."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Appearance="Danger" Padding="16,8" VerticalAlignment="Center"
                                       Command="{Binding Settings.EmergencyFactoryResetCommand}"
                                       ToolTip="Elimina toda la información y reinicia la aplicación desde cero">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Borrar todo y reiniciar" FontWeight="Bold" FontSize="12" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============================================== -->
            <!-- SECTION 7: ACERCA DE BENNYCOMES, ACTUALIZACIONES Y LICENCIAS -->
            <!-- ============================================== -->
            <Border CornerRadius="12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="20">
                <StackPanel>
                    <!-- App Brand & Version Info -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16" Background="{DynamicResource SurfaceCardHoverBrush}"
                                BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Margin="0,0,18,0" VerticalAlignment="Center">
                            <Grid>
                                <ui:SymbolIcon Symbol="MusicNote224" FontSize="30" Foreground="{Binding Theme.CurrentAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="BennyComes" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <Border CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Background="{Binding Theme.CurrentAccentBrush}">
                                    <TextBlock Text="v1.2.003" FontSize="11" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Settings.AppVersion}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,3,0,5" />
                            <TextBlock Text="{Binding Settings.AudioEngineInfo}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Settings.TechnologiesInfo}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- Actualizaciones desde GitHub Releases -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSyncCircle24" FontSize="18" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Actualizaciones de la Aplicación (GitHub Releases)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Settings.UpdateStatusMessage}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Appearance="Primary" Padding="14,7" Margin="0,0,8,0"
                                       Background="{Binding Theme.CurrentAccentBrush}"
                                       Command="{Binding Settings.CheckForUpdatesCommand}"
                                       IsEnabled="{Binding Settings.IsCheckingForUpdates, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Buscar actualizaciones" FontWeight="Bold" FontSize="12" Foreground="{Binding Theme.AccentForegroundBrush}" />
                                </StackPanel>
                            </ui:Button>

                            <ui:Button Appearance="Secondary" Padding="14,7"
                                       Command="{Binding Settings.OpenGitHubReleasesCommand}"
                                       ToolTip="Abrir https://github.com/MiguelC221/BennyComes/releases en el navegador">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="15" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Ir a GitHub Releases" FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16" />

                    <!-- Apartado de Licencias de Código Abierto -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentText24" FontSize="18" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Licencias de Código Abierto" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Consulta las bibliotecas y proyectos de código abierto utilizados en el desarrollo de BennyComes y sus respectivos avisos de licencia."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="16,8" VerticalAlignment="Center"
                                   Command="{Binding Settings.OpenLicensesModalCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Certificate24" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Ver licencias de código abierto" FontWeight="SemiBold" FontSize="12" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
