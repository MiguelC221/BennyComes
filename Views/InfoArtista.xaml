<UserControl x:Class="BenyComes.Views.InfoArtista"
             x:Name="RootInfoArtista"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:BenyComes.Models"
             xmlns:vm="clr-namespace:BenyComes.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980">

    <Grid x:Name="RootContentGrid"
          Background="Transparent"
          PreviewMouseWheel="OnRootPreviewMouseWheel"
          Visibility="{Binding Artist, ElementName=RootInfoArtista, Converter={StaticResource NullToVisibilityConverter}}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootSlideTransform" Y="0" />
        </Grid.RenderTransform>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Row 0: Accented Artist Hero Box -->
            <RowDefinition Height="Auto" /> <!-- Row 1: "En la biblioteca" + List/Grid Switcher -->
            <RowDefinition Height="*" />    <!-- Row 2: Album-Grouped List View OR Album Grid View -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: ARTIST HERO BOX (Accented color + Smooth Animations)    -->
        <!-- ============================================================== -->
        <Border x:Name="HeroBoxBorder"
                Grid.Row="0"
                CornerRadius="12"
                ClipToBounds="True"
                Background="{Binding Artist.DominantHeaderBrush, ElementName=RootInfoArtista, FallbackValue='#242632', TargetNullValue='#242632'}"
                BorderBrush="#26FFFFFF"
                BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0,0,0,18" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompactHeader, ElementName=RootInfoArtista}" Value="True">
                            <Setter Property="Margin" Value="0,0,0,10" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <!-- Lateral Mini-Backdrop: Portada duplicada lateral con difuminado hacia el centro y reducción fluida al hacer scroll (sin inflar altura) -->
                <Border x:Name="LateralCoverBorder"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="380" ClipToBounds="True"
                        Cursor="Hand" MouseLeftButtonUp="OnLateralCoverImageClick" ToolTip="Clic para ver foto completa del artista">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactHeader, ElementName=RootInfoArtista}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="220" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="380" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               RenderOptions.BitmapScalingMode="HighQuality">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding Artist.CoverImageSource, ElementName=RootInfoArtista}"
                                        Stretch="UniformToFill"
                                        AlignmentX="Right" AlignmentY="Center" />
                        </Rectangle.Fill>
                        <Rectangle.OpacityMask>
                            <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5">
                                <GradientStop Color="#CC000000" Offset="0.0" />
                                <GradientStop Color="#80000000" Offset="0.35" />
                                <GradientStop Color="#26000000" Offset="0.7" />
                                <GradientStop Color="#00000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.OpacityMask>
                    </Rectangle>
                </Border>

                <Grid x:Name="ArtistBoxInnerGrid">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="26,20" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactHeader, ElementName=RootInfoArtista}" Value="True">
                                <Setter Property="Margin" Value="18,10" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: 100% Circular Artist Avatar using Ellipse + ImageBrush + Smooth Size Animation -->
                <Grid x:Name="AvatarContainer"
                      Grid.Column="0"
                      Width="148" Height="148"
                      Margin="0,0,26,0"
                      VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactHeader, ElementName=RootInfoArtista}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="68" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Height" To="68" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Width" To="148" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="Height" To="148" Duration="0:0:0.26">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <!-- Circular background + fallback icon -->
                    <Ellipse Fill="#28000000" Stroke="#2EFFFFFF" StrokeThickness="1.5" />
                    <ui:SymbolIcon Symbol="Person24" FontSize="36" Foreground="#B0FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- True circular clipped artist photo -->
                    <Ellipse Stroke="#38FFFFFF" StrokeThickness="1.5"
                             RenderOptions.BitmapScalingMode="HighQuality">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="18" Color="#000000" Opacity="0.38" ShadowDepth="3" />
                        </Ellipse.Effect>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Artist.AvatarImageSource, ElementName=RootInfoArtista}"
                                        Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <!-- Right: Artist Name, Stats, Genre, Last.fm Bio, and Action Buttons -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- Artist Title + Optional Unicode/AltNames -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                        <WrapPanel.RenderTransform>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                        </WrapPanel.RenderTransform>
                        <WrapPanel.Style>
                            <Style TargetType="WrapPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactHeader, ElementName=RootInfoArtista}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.72" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.72" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </WrapPanel.Style>

                        <TextBlock Text="{Binding Artist.Name, ElementName=RootInfoArtista}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis" />

                        <TextBlock Text="{Binding Artist.AltNamesDisplay, ElementName=RootInfoArtista, StringFormat='({0})'}"
                                   FontSize="15"
                                   Foreground="#D4DCE8"
                                   VerticalAlignment="Center"
                                   Margin="10,4,0,0"
                                   Visibility="{Binding Artist.HasAltNames, ElementName=RootInfoArtista, Converter={StaticResource BoolToVisConverter}}" />
                    </WrapPanel>

                    <!-- Expanded Metadata Section (Smoothly animates MaxHeight & Opacity when scrolling down/up) -->
                    <StackPanel Margin="0,4,0,4" MaxHeight="160" Opacity="1.0" ClipToBounds="True">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactHeader, ElementName=RootInfoArtista}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.25">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="160" Duration="0:0:0.26">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.24">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Line 1: "12 álbumes • 20 canciones • 1 hora 45 min" -->
                        <TextBlock FontSize="13.5" Margin="0,0,0,2">
                            <Run Text="{Binding Artist.PrimaryStatsText, ElementName=RootInfoArtista, Mode=OneWay}"
                                 FontWeight="SemiBold" Foreground="#FFFFFF" />
                            <Run Text="{Binding Artist.DurationStatsText, ElementName=RootInfoArtista, Mode=OneWay}"
                                 Foreground="#D0D8E4" />
                        </TextBlock>

                        <!-- Line 2: "Artista • Género desconocido" -->
                        <TextBlock Text="{Binding Artist.MainGenreDisplay, ElementName=RootInfoArtista}"
                                   FontSize="12"
                                   Foreground="#CBD4E0" />

                        <!-- Clickable Last.fm Biography Excerpt (Opens full popup modal on click) -->
                        <Border x:Name="BioPreviewCard"
                                Margin="0,8,0,2"
                                Padding="10,7"
                                CornerRadius="8"
                                MaxWidth="760"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                Background="#1A000000"
                                BorderBrush="#24FFFFFF"
                                BorderThickness="1"
                                MouseLeftButtonUp="OnOpenBioPopupClick"
                                ToolTip="Haz clic para ver toda la información del artista"
                                Visibility="{Binding Artist.HasBiography, ElementName=RootInfoArtista, Converter={StaticResource BoolToVisConverter}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2E000000" />
                                            <Setter Property="BorderBrush" Value="#48FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding Artist.BiographySummary, ElementName=RootInfoArtista}"
                                           FontSize="12"
                                           Foreground="#E8EDF5"
                                           TextWrapping="Wrap"
                                           MaxHeight="36"
                                           LineHeight="17"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="12" Foreground="#FFFFFF" Margin="0,0,5,0" />
                                    <TextBlock Text="Leer biografía completa de Last.fm"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               TextDecorations="Underline" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Action Buttons Row -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                        <!-- 1. Reproducir todo -->
                        <Button Cursor="Hand" Margin="0,0,10,4"
                                Click="OnPlayAllArtistClick"
                                ToolTip="Reproducir todas las canciones del artista">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="PrimaryBtnBdr"
                                            CornerRadius="6"
                                            Padding="15,7"
                                            RenderTransformOrigin="0.5,0.5"
                                            Background="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Play24" FontSize="15"
                                                           Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.AccentForegroundBrush}"
                                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Reproducir todo" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.AccentForegroundBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PrimaryBtnBdr" Property="Opacity" Value="0.92" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="PrimaryBtnBdr" Property="Opacity" Value="0.80" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 2. Reproducir en orden aleatorio -->
                        <Button Cursor="Hand" Margin="0,0,10,4"
                                Click="OnShuffleArtistClick"
                                ToolTip="Reproducir en orden aleatorio">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="SecBtnBdr"
                                            CornerRadius="6"
                                            Padding="15,7"
                                            Background="#22FFFFFF"
                                            BorderBrush="#32FFFFFF"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="15"
                                                           Foreground="#FFFFFF"
                                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Reproducir en orden aleatorio" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SecBtnBdr" Property="Background" Value="#36FFFFFF" />
                                            <Setter TargetName="SecBtnBdr" Property="BorderBrush" Value="#55FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="SecBtnBdr" Property="Background" Value="#48FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 3. + Agregar a -->
                        <Button Cursor="Hand" Margin="0,0,10,4"
                                Click="OnAddToButtonClick"
                                ToolTip="Agregar discografía a cola o lista de reproducción">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AddBtnBdr"
                                            CornerRadius="6"
                                            Padding="15,7"
                                            Background="#22FFFFFF"
                                            BorderBrush="#32FFFFFF"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="15"
                                                           Foreground="#FFFFFF"
                                                           Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Agregar a" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="AddBtnBdr" Property="Background" Value="#36FFFFFF" />
                                            <Setter TargetName="AddBtnBdr" Property="BorderBrush" Value="#55FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="AddBtnBdr" Property="Background" Value="#48FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 4. ••• (Foto y datos del artista) -->
                        <Button Cursor="Hand" Margin="0,0,0,4"
                                Click="OnArtistPhotoMenuButtonClick"
                                ToolTip="Foto y datos del artista (Last.fm / Galería)">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Ver biografía completa (Last.fm)"
                                              Click="OnOpenBioPopupMenuClick">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="TextDescription24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Abrir galería de fotos..."
                                              Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OpenArtistGalleryCommand}"
                                              CommandParameter="{Binding Artist.Name, ElementName=RootInfoArtista}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Image24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Elegir foto local desde explorador..."
                                              Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ChangeArtistPhotoFromExplorerCommand}"
                                              CommandParameter="{Binding Artist, ElementName=RootInfoArtista}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="FolderOpen24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Volver a consultar Last.fm / APIs"
                                              Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=RedownloadArtistFromLastFmCommand}"
                                              CommandParameter="{Binding Artist, ElementName=RootInfoArtista}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="ArrowSync24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Combinar con otro artista..."
                                              Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=MyMusic.OpenCombineArtistDialogCommand}"
                                              CommandParameter="{Binding Artist, ElementName=RootInfoArtista}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="PeopleSwap24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="MoreBtnBdr"
                                            CornerRadius="6"
                                            Padding="11,7"
                                            Background="#22FFFFFF"
                                            BorderBrush="#32FFFFFF"
                                            BorderThickness="1">
                                        <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16"
                                                       Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MoreBtnBdr" Property="Background" Value="#36FFFFFF" />
                                            <Setter TargetName="MoreBtnBdr" Property="BorderBrush" Value="#55FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="MoreBtnBdr" Property="Background" Value="#48FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 1: "En la biblioteca" + View Mode Icons (List vs Grid)     -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" Margin="2,0,2,14">
            <TextBlock Text="En la biblioteca"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Toggle: Mostrar canciones de osu! -->
                <Button Cursor="Hand" Margin="0,0,10,0"
                        Click="OnToggleShowOsuTracksClick"
                        ToolTip="Mostrar u ocultar las canciones de osu! de este artista">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="OsuToggleBdr"
                                    Background="{DynamicResource SurfaceCardSubtleBrush}"
                                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="11,5"
                                    Opacity="0.80">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Control x:Name="OsuToggleLogo"
                                             Template="{StaticResource OsuThemeLogoTemplate}"
                                             Width="17" Height="17"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             Background="Transparent"
                                             Margin="0,0,7,0"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="OsuToggleText"
                                               Text="Mostrar canciones de osu!"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <Border x:Name="OsuActiveDot"
                                            Width="7" Height="7"
                                            CornerRadius="3.5"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding ShowOsuTracks, ElementName=RootInfoArtista}" Value="True">
                                    <Setter TargetName="OsuToggleBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                    <Setter TargetName="OsuToggleBdr" Property="BorderBrush" Value="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}" />
                                    <Setter TargetName="OsuToggleBdr" Property="Opacity" Value="1.0" />
                                    <Setter TargetName="OsuToggleLogo" Property="Foreground" Value="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}" />
                                    <Setter TargetName="OsuToggleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="OsuActiveDot" Property="Background" Value="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OsuToggleBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                    <Setter TargetName="OsuToggleBdr" Property="Opacity" Value="1.0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                <!-- Toggle 1: Vista por Lista -->
                <Button Cursor="Hand" Margin="0,0,6,0"
                        Click="OnListViewModeClick"
                        ToolTip="Vista en lista por álbum">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBtnBdr" Background="Transparent" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                    <ui:SymbolIcon x:Name="TabIcon"
                                                   Symbol="TextBulletListLtr24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    <Border x:Name="ActiveUnderline"
                                            Height="3" Width="16" CornerRadius="1.5"
                                            Margin="0,4,0,0"
                                            Background="Transparent"
                                            HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBtnBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsGridView, ElementName=RootInfoArtista}" Value="False">
                                    <Setter TargetName="TabIcon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="ActiveUnderline" Property="Background" Value="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Toggle 2: Vista en Cuadrícula (Carátulas) -->
                <Button Cursor="Hand"
                        Click="OnGridViewModeClick"
                        ToolTip="Vista en cuadrícula de álbumes">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabBtnBdr" Background="Transparent" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                    <ui:SymbolIcon x:Name="TabIcon"
                                                   Symbol="Grid24"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    <Border x:Name="ActiveUnderline"
                                            Height="3" Width="16" CornerRadius="1.5"
                                            Margin="0,4,0,0"
                                            Background="Transparent"
                                            HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabBtnBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsGridView, ElementName=RootInfoArtista}" Value="True">
                                    <Setter TargetName="TabIcon" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="ActiveUnderline" Property="Background" Value="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 2.A: VISTA POR LISTA (Título de álbum + Año arriba como    -->
        <!--          encabezado de grupo, Carátula a la izq y Tabla a der) -->
        <!-- ============================================================== -->
        <ScrollViewer x:Name="ListScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="OnContentScrollChanged"
                      Visibility="{Binding IsGridView, ElementName=RootInfoArtista, Converter={StaticResource InverseBoolToVisConverter}}">
            <ScrollViewer.RenderTransform>
                <TranslateTransform x:Name="ListViewSlideTransform" Y="0" />
            </ScrollViewer.RenderTransform>
            <ItemsControl ItemsSource="{Binding Artist.Albums, ElementName=RootInfoArtista}"
                          Margin="0,0,0,120">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:AlbumModel}">
                        <StackPanel Margin="0,0,0,32">
                            <!-- Encabezado de grupo del álbum arriba (Título grande + Enter + Año debajo + línea divisoria) -->
                            <StackPanel Margin="2,0,0,12" Cursor="Hand"
                                        Background="Transparent"
                                        MouseLeftButtonUp="OnOpenAlbumDetailClick"
                                        ToolTip="Abrir detalles del álbum">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding YearDisplay}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                                <Border Height="1"
                                        Background="{DynamicResource DividerBrush}"
                                        Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Contenido: Carátula a la izquierda + Tabla cebra a la derecha -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Carátula del álbum (140x140 con animación de escala suave al pasar el cursor) -->
                                <Border Grid.Column="0"
                                        Width="140" Height="140"
                                        CornerRadius="6"
                                        Margin="0,0,22,0"
                                        ClipToBounds="True"
                                        RenderTransformOrigin="0.5,0.5"
                                        Background="{DynamicResource SurfaceCardSubtleBrush}"
                                        BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Top"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="OnOpenAlbumDetailClick"
                                        ToolTip="Abrir detalles del álbum">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                    </Border.RenderTransform>
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Album24" FontSize="36"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Image Source="{Binding CoverImageSource}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Border x:Name="CoverHoverOverlay" Background="#55000000" Opacity="0">
                                            <Button Width="42" Height="42"
                                                    Cursor="Hand"
                                                    Click="OnPlayAlbumButtonClick"
                                                    ToolTip="Reproducir álbum"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Width="42" Height="42" CornerRadius="21"
                                                                Background="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}">
                                                            <ui:SymbolIcon Symbol="Play24" FontSize="18"
                                                                           Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.AccentForegroundBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Border>
                                    </Grid>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CoverHoverOverlay" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CoverHoverOverlay" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18" />
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>

                                <!-- Tabla de canciones del álbum con estilo cebra -->
                                <ListView Grid.Column="1"
                                          ItemsSource="{Binding Tracks}"
                                          AlternationCount="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="OnInnerTracksPreviewMouseWheel"
                                          VerticalAlignment="Top">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Background" Value="#12FFFFFF" />
                                            <Setter Property="Padding" Value="18,11" />
                                            <Setter Property="Margin" Value="0,0,0,3" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="ContextMenu" Value="{Binding TrackContextMenu, ElementName=RootInfoArtista}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListViewItem">
                                                        <Border x:Name="ItemBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="6"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="#22FFFFFF" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:Track}">
                                            <Grid x:Name="RowGrid" Background="Transparent" Cursor="Hand">
                                                <Grid.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding PlayTrackCommand, ElementName=RootInfoArtista}"
                                                                  CommandParameter="{Binding}" />
                                                </Grid.InputBindings>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="2.4*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                    <ColumnDefinition Width="1.3*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- # o Icono Play/Speaker -->
                                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TrackNumTxt"
                                                               Text="{Binding TrackNumberDisplay}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <ui:SymbolIcon x:Name="HoverPlayIcon"
                                                                   Symbol="Play24"
                                                                   FontSize="14"
                                                                   Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="Collapsed" />
                                                    <ui:SymbolIcon x:Name="CurrentSpeakerIcon"
                                                                   Symbol="Speaker224"
                                                                   FontSize="14"
                                                                   Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="Collapsed" />
                                                </Grid>

                                                <!-- Título + Logo osu! + Insignia VIDEO -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock x:Name="TrackTitleTxt"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               MaxWidth="260"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <Control Template="{StaticResource OsuThemeLogoTemplate}"
                                                             Width="18" Height="18" Margin="7,0,0,0"
                                                             VerticalAlignment="Center"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource AccentBrush}"
                                                             ToolTip="Canción de osu!"
                                                             Visibility="{Binding IsOsuTrack, Converter={StaticResource BoolToVisConverter}}" />

                                                    <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="4"
                                                            Background="{DynamicResource SurfaceCardSubtleBrush}"
                                                            BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                                            ToolTip="Contiene video musical (osu!)"
                                                            Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisConverter}}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:SymbolIcon Symbol="Video24" FontSize="11"
                                                                           Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}"
                                                                           Margin="0,0,3,0" />
                                                            <TextBlock Text="VIDEO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Artista (Botón invisible para redirigir al artista de la pista) -->
                                                <Button Grid.Column="2"
                                                        Background="Transparent" BorderThickness="0" Padding="0,2"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Margin="0,0,16,0"
                                                        Cursor="Hand"
                                                        ToolTip="Ir al artista"
                                                        Click="OnTrackArtistButtonClick">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="Transparent">
                                                                <TextBlock x:Name="TrackArtistCellTxt"
                                                                           Text="{Binding Artist}"
                                                                           FontSize="12.5"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="TrackArtistCellTxt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    <Setter TargetName="TrackArtistCellTxt" Property="TextDecorations" Value="Underline" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Género -->
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding GenreDisplay}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,16,0" />

                                                <!-- Favorito ♥ + Duración -->
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Button Width="26" Height="26" Padding="0" Margin="0,0,10,0"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            ToolTip="Agregar o quitar de Favoritos"
                                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleFavoriteCommand}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="FavBdr" CornerRadius="6" Background="Transparent">
                                                                    <ui:SymbolIcon x:Name="FavIcon" Symbol="Heart24" FontSize="13.5"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="FavBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                                    </Trigger>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter TargetName="FavIcon" Property="Filled" Value="True" />
                                                                        <Setter TargetName="FavIcon" Property="Foreground" Value="#FFE81123" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>

                                                    <TextBlock Text="{Binding DurationTwoDigitFormatted}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center"
                                                               MinWidth="38"
                                                               TextAlignment="Right" />
                                                </StackPanel>
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="RowGrid" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TrackNumTxt" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="HoverPlayIcon" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter TargetName="TrackTitleTxt" Property="Foreground" Value="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}" />
                                                    <Setter TargetName="TrackTitleTxt" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="TrackNumTxt" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="HoverPlayIcon" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="CurrentSpeakerIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- ROW 2.B: VISTA EN CUADRÍCULA DE ÁLBUMES                        -->
        <!-- ============================================================== -->
        <ScrollViewer x:Name="GridScrollViewer"
                      Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="OnContentScrollChanged"
                      Visibility="{Binding IsGridView, ElementName=RootInfoArtista, Converter={StaticResource BoolToVisConverter}}">
            <ScrollViewer.RenderTransform>
                <TranslateTransform x:Name="GridViewSlideTransform" Y="0" />
            </ScrollViewer.RenderTransform>
            <ItemsControl ItemsSource="{Binding Artist.Albums, ElementName=RootInfoArtista}"
                          Margin="0,0,0,120">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:AlbumModel}">
                        <StackPanel Width="156" Margin="0,0,18,24" Cursor="Hand"
                                    Background="Transparent"
                                    MouseLeftButtonUp="OnOpenAlbumDetailClick"
                                    ToolTip="Abrir detalles del álbum">
                            <Border Width="156" Height="156"
                                    CornerRadius="6"
                                    ClipToBounds="True"
                                    RenderTransformOrigin="0.5,0.5"
                                    Background="{DynamicResource SurfaceCardSubtleBrush}"
                                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                                    BorderThickness="1">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                </Border.RenderTransform>
                                <Grid>
                                    <ui:SymbolIcon Symbol="Album24" FontSize="38"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding CoverImageSource}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Border x:Name="GridCardHover" Background="#55000000" Opacity="0">
                                        <Button Width="42" Height="42"
                                                Cursor="Hand"
                                                Click="OnPlayAlbumButtonClick"
                                                ToolTip="Reproducir álbum"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Width="42" Height="42" CornerRadius="21"
                                                            Background="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}">
                                                        <ui:SymbolIcon Symbol="Play24" FontSize="18"
                                                                       Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.AccentForegroundBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Border>
                                </Grid>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GridCardHover" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="GridCardHover" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.18" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.18">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>

                            <TextBlock Text="{Binding Name}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       MaxHeight="36"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,8,0,0"
                                       ToolTip="{Binding Name}" />

                            <TextBlock Text="{Binding YearDisplay}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ============================================================== -->
        <!-- POPUP MODAL OVERLAY: FULL ARTIST BIOGRAPHY FROM LAST.FM        -->
        <!-- ============================================================== -->
        <Grid x:Name="BioPopupBackdropGrid"
              Grid.Row="0" Grid.RowSpan="3"
              Panel.ZIndex="100"
              Background="#CC09090E"
              MouseLeftButtonDown="OnBioPopupBackdropClick"
              Visibility="{Binding IsBioPopupOpen, ElementName=RootInfoArtista, Converter={StaticResource BoolToVisConverter}}">
            <Border x:Name="BioPopupCardBorder"
                    Width="620" MaxHeight="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="14"
                    Padding="24,20"
                    RenderTransformOrigin="0.5,0.5"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                    BorderThickness="1"
                    MouseLeftButtonDown="OnBioPopupCardClick">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="BioPopupCardScale" ScaleX="1.0" ScaleY="1.0" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" Color="#000000" Opacity="0.65" ShadowDepth="8" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: Circular Avatar + Artist Name + Close X Button -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="54" Height="54" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Ellipse Fill="#28000000" Stroke="#2EFFFFFF" StrokeThickness="1" />
                            <ui:SymbolIcon Symbol="Person24" FontSize="22" Foreground="#B0FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Stroke="#38FFFFFF" StrokeThickness="1" RenderOptions.BitmapScalingMode="HighQuality">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Artist.AvatarImageSource, ElementName=RootInfoArtista}"
                                                Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Artist.Name, ElementName=RootInfoArtista}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Información y biografía del artista (Last.fm)"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Width="34" Height="34"
                                Cursor="Hand"
                                VerticalAlignment="Top"
                                Click="OnCloseBioPopupClick"
                                ToolTip="Cerrar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseXBtn" CornerRadius="8" Background="Transparent">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseXBtn" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Divider -->
                    <Border Grid.Row="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,14" />

                    <!-- Scrollable Full Biography Content -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="330"
                                  Padding="0,0,8,0">
                        <TextBlock Text="{Binding Artist.BiographyFull, ElementName=RootInfoArtista}"
                                   FontSize="13.5"
                                   LineHeight="22"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <!-- Footer Buttons: Más info sobre este artista + Cerrar -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Cursor="Hand" Click="OnMoreInfoLastFmClick" Margin="0,0,10,0" ToolTip="Abrir página del artista en Last.fm">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="MoreInfoBtnBdr"
                                            CornerRadius="6"
                                            Padding="14,8"
                                            Background="#14FFFFFF"
                                            BorderBrush="#2AFFFFFF"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Open24" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Más info sobre este artista"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MoreInfoBtnBdr" Property="Background" Value="#25FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="MoreInfoBtnBdr" Property="Background" Value="#1FFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Cursor="Hand" Click="OnCloseBioPopupClick">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CloseFooterBdr"
                                            CornerRadius="6"
                                            Padding="20,8"
                                            Background="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}">
                                        <TextBlock Text="Cerrar"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.AccentForegroundBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CloseFooterBdr" Property="Opacity" Value="0.9" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CloseFooterBdr" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- POPUP MODAL OVERLAY: VISOR DE IMAGEN / FOTO COMPLETA           -->
        <!-- ============================================================== -->
        <Grid x:Name="ImagePreviewModal"
              Grid.Row="0" Grid.RowSpan="3"
              Background="#D9000000"
              Panel.ZIndex="3000"
              Visibility="{Binding IsImagePreviewOpen, ElementName=RootInfoArtista, Converter={StaticResource BoolToVisConverter}}"
              MouseLeftButtonDown="OnCloseImagePreviewClick">
            <Border MaxWidth="640" MaxHeight="640" Margin="24"
                    CornerRadius="16" ClipToBounds="True"
                    Background="#1C1C24" BorderBrush="#33FFFFFF" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" Color="#000000" Opacity="0.8" ShadowDepth="8" />
                </Border.Effect>
                <Grid>
                    <Image Source="{Binding Artist.CoverImageSource, ElementName=RootInfoArtista}"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                            Width="34" Height="34" Cursor="Hand"
                            Click="OnCloseImagePreviewClick" ToolTip="Cerrar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="17" Background="#B3000000">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
