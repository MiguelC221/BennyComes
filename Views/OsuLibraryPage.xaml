<UserControl x:Class="BenyComes.Views.OsuLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:BenyComes.Models"
             xmlns:vm="clr-namespace:BenyComes.ViewModels"
             xmlns:views="clr-namespace:BenyComes.Views"
             xmlns:wpftk="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="980">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/ArtistSectionTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared ContextMenu for Osu Songs -->
            <ContextMenu x:Key="SharedOsuTrackContextMenu">
                <MenuItem Header="Reproducir"
                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OsuLibrary.PlayTrackCommand}"
                          CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Reproducir siguiente"
                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OsuLibrary.PlayTrackNextCommand}"
                          CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Next24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Agregar a la cola"
                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OsuLibrary.AddTrackToQueueCommand}"
                          CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Ir al artista"
                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OsuLibrary.OpenArtistByNameCommand}"
                          CommandParameter="{Binding Artist}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Person24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Ver información de álbum (Last.fm)"
                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OsuLibrary.OpenTrackAlbumCommand}"
                          CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Album24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Marcar / Desmarcar Favorito ♥"
                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleFavoriteCommand}"
                          CommandParameter="{Binding}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Heart24" Foreground="#E81123" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>

            <!-- Shared ItemContainerStyle for Osu Tabular Song Rows (Matches MyMusicPage) -->
            <Style x:Key="OsuSongListViewItemStyle" TargetType="ListViewItem">
                <EventSetter Event="MouseDoubleClick" Handler="OnSongItemDoubleClick" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="28,2,28,2" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ContextMenu" Value="{StaticResource SharedOsuTrackContextMenu}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="ItemBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="6,4">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="#250078D4" />
                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{DynamicResource TableRowAlternateBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Shared DataTemplate for Osu Tabular Song Rows (Matches MyMusicPage) -->
            <DataTemplate x:Key="OsuSongRowTemplate" DataType="{x:Type models:Track}">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <!-- Col 0: 40x40 Cover with Hover Play Button & Playing Indicator -->
                    <Grid Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border CornerRadius="6" ClipToBounds="True" Background="#1C1C26">
                            <Image Source="{Binding CoverImageSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <!-- Playing badge overlay -->
                        <Border x:Name="PlayingBadge" Background="#B3000000" CornerRadius="6" Visibility="Collapsed">
                            <ui:SymbolIcon Symbol="Speaker224" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Hover Play Overlay Button -->
                        <Button x:Name="HoverPlayButton"
                                Background="#99000000" BorderThickness="0"
                                Width="40" Height="40" Cursor="Hand" Opacity="0"
                                Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OsuLibrary.PlayTrackCommand}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                        <Path Data="M 4,2 L 16,10 L 4,18 Z" Fill="White" Stroke="{x:Null}" Width="14" Height="14" Margin="2,0,0,0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Col 1: Song Title + Logo osu! + Optional VIDEO Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,10,0">
                        <TextBlock x:Name="SongTitleText" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   MaxWidth="300"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                        <Control Template="{StaticResource OsuThemeLogoTemplate}"
                                 Width="18" Height="18" Margin="7,0,0,0"
                                 VerticalAlignment="Center"
                                 Background="Transparent"
                                 Foreground="{DynamicResource AccentBrush}"
                                 ToolTip="Canción de osu!" />

                        <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="4"
                                Background="{DynamicResource SurfaceCardSubtleBrush}"
                                BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                ToolTip="Contiene video musical (osu!)"
                                Visibility="{Binding HasVideo, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Video24" FontSize="11"
                                               Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}"
                                               Margin="0,0,3,0" />
                                <TextBlock Text="VIDEO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Col 2: Artist (Invisible Button to redirect to Artist Detail) -->
                    <Button Grid.Column="2"
                            Background="Transparent" BorderThickness="0" Padding="0,2"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                            Cursor="Hand"
                            ToolTip="Ir al artista"
                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=OsuLibrary.OpenArtistByNameCommand}"
                            CommandParameter="{Binding Artist}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <TextBlock x:Name="ArtistCellTxt"
                                               Text="{Binding Artist}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ArtistCellTxt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Setter TargetName="ArtistCellTxt" Property="TextDecorations" Value="Underline" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Col 3: OsuSource / Origin Badge -->
                    <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Border Background="{DynamicResource SurfaceCardHoverBrush}" CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="{Binding HasOsuSource, Converter={StaticResource BoolToVisConverter}}"
                                ToolTip="{Binding OsuSource, StringFormat='Fuente / Origen: {0}'}">
                            <TextBlock Text="{Binding OsuSource}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </Grid>

                    <!-- Col 4: Favorite Heart & Duration -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Width="26" Height="26" Padding="0" Margin="0,0,6,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                ToolTip="Agregar o quitar de Favoritos"
                                Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleFavoriteCommand}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="FavBdr" CornerRadius="5" Background="Transparent">
                                        <ui:SymbolIcon x:Name="FavIcon" Symbol="Heart24" FontSize="14"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="FavBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter TargetName="FavIcon" Property="Filled" Value="True" />
                                            <Setter TargetName="FavIcon" Property="Foreground" Value="#FFE81123" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="{Binding DurationFormatted}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                        <Setter TargetName="HoverPlayButton" Property="Opacity" Value="1.0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                        <Setter TargetName="SongTitleText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                        <Setter TargetName="SongTitleText" Property="FontWeight" Value="Bold" />
                        <Setter TargetName="PlayingBadge" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0,16,0,10" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding OsuLibrary.IsInDetailView}" Value="True">
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Page Title & Search -->
            <RowDefinition Height="Auto" /> <!-- 1. Modern Sub-tabs Selector (Matches Mi Música) -->
            <RowDefinition Height="Auto" /> <!-- 2. Persistent Toolbar Across All Tabs -->
            <RowDefinition Height="*" />    <!-- 3. Tab Content Area -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: PAGE TITLE + SEARCH BAR                                 -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Margin="28,0,28,14">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OsuLibrary.IsInDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Control Template="{StaticResource OsuThemeLogoTemplate}"
                         Width="30" Height="30" Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Background="Transparent"
                         Foreground="{DynamicResource AccentBrush}" />
                <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Text="osu! Library" />
            </StackPanel>

            <ui:TextBox Grid.Column="1" Width="250" PlaceholderText="Buscar en osu!..."
                        VerticalAlignment="Center"
                        Text="{Binding OsuLibrary.SearchFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" />
                </ui:TextBox.Icon>
            </ui:TextBox>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 1: MODERN SUB-TABS SELECTOR (Exact design of Mi Música)    -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="28,0,28,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OsuLibrary.IsInDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Orientation="Horizontal">
                <!-- 1. Canciones Tab -->
                <Button Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Margin="0,0,12,0" Padding="0" Cursor="Hand"
                        PreviewMouseLeftButtonDown="OnSongsTabPreviewMouseDown" Click="OnSongsTabClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabHitBox" Background="Transparent" CornerRadius="8" Padding="14,8,14,6">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TabText" Text="Canciones" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                    <Border x:Name="Indicator" Height="3" CornerRadius="1.5" Margin="0,6,0,0"
                                            Background="{Binding Theme.CurrentAccentBrush}" Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.2" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabHitBox" Property="Background" Value="#0DFFFFFF" />
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding OsuLibrary.SelectedTabIndex}" Value="0">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.4" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.2" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 2. Artistas Tab -->
                <Button Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Margin="0,0,12,0" Padding="0" Cursor="Hand"
                        PreviewMouseLeftButtonDown="OnArtistsTabPreviewMouseDown" Click="OnArtistsTabClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabHitBox" Background="Transparent" CornerRadius="8" Padding="14,8,14,6">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TabText" Text="Artistas" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                    <Border x:Name="Indicator" Height="3" CornerRadius="1.5" Margin="0,6,0,0"
                                            Background="{Binding Theme.CurrentAccentBrush}" Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.2" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabHitBox" Property="Background" Value="#0DFFFFFF" />
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding OsuLibrary.SelectedTabIndex}" Value="1">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.4" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.2" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 3. Con vídeo Tab -->
                <Button Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Margin="0,0,12,0" Padding="0" Cursor="Hand"
                        PreviewMouseLeftButtonDown="OnVideoSongsTabPreviewMouseDown" Click="OnVideoSongsTabClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabHitBox" Background="Transparent" CornerRadius="8" Padding="14,8,14,6">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TabText" Text="Con vídeo" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                    <Border x:Name="Indicator" Height="3" CornerRadius="1.5" Margin="0,6,0,0"
                                            Background="{Binding Theme.CurrentAccentBrush}" Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.2" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabHitBox" Property="Background" Value="#0DFFFFFF" />
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding OsuLibrary.SelectedTabIndex}" Value="2">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.4" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.2" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2: PERSISTENT TOOLBAR (SHUFFLE, FILTERS & COUNTERS)        -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="28,0,28,14">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OsuLibrary.IsInDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Play All Shuffled + JumpList A-Z Button -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Appearance="Primary" Padding="14,8"
                           Background="{Binding Theme.CurrentAccentBrush}"
                           Command="{Binding OsuLibrary.PlayAllShuffledCommand}"
                           ToolTip="Reproducir música de osu! en orden aleatorio">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="16" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Reproducción aleatoria" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="13" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Appearance="Transparent" Padding="8,6" Margin="10,0,0,0"
                           Command="{Binding OsuLibrary.OpenJumpListCommand}"
                           IsEnabled="{Binding OsuLibrary.IsAlphabetEnabled}"
                           ToolTip="Abrir selector alfabético (JumpList)">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3" />
                                    <Setter Property="ToolTip" Value="Abecedario desactivado al ordenar por cantidad de canciones" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="A-Z" FontSize="12" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>

            <!-- Right: Sort Controls (for Artists Tab) & Item Count -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OsuLibrary.SelectedTabIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="Ordenar por:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="180" ItemsSource="{Binding OsuLibrary.ArtistSortOptions}"
                              SelectedItem="{Binding OsuLibrary.SelectedArtistSort, Mode=TwoWay}"
                              Margin="0,0,6,0" />

                    <ui:Button Appearance="Transparent" Width="32" Height="32" Padding="0"
                               Command="{Binding OsuLibrary.ToggleSortDirectionCommand}"
                               ToolTip="{Binding OsuLibrary.SortDirectionTooltip}">
                        <ui:SymbolIcon Symbol="{Binding OsuLibrary.SortDirectionIcon}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </ui:Button>
                </StackPanel>

                <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding OsuLibrary.Songs.Count, StringFormat='{}{0} canciones de osu!'}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding OsuLibrary.SelectedTabIndex}" Value="1">
                                    <Setter Property="Text" Value="{Binding OsuLibrary.Artists.Count, StringFormat='{}{0} artistas'}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding OsuLibrary.SelectedTabIndex}" Value="2">
                                    <Setter Property="Text" Value="{Binding OsuLibrary.VideoSongs.Count, StringFormat='{}{0} canciones con vídeo'}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 3: TAB CONTENT CONTAINER (ANIMATED LIKE MI MÚSICA)         -->
        <!-- ============================================================== -->
        <Grid Grid.Row="3">

            <!-- ========================================================== -->
            <!-- 1. TAB 0: CANCIONES (TABULAR FULL-WIDTH LISTVIEW)          -->
            <!-- ========================================================== -->
            <Grid x:Name="Tab0SongsGrid">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Tab0SongsTranslate" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OsuLibrary.SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="15" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OsuLibrary.IsInDetailView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Fixed Column Header Bar -->
                <Grid Grid.Row="0" Margin="28,0,28,8" Visibility="{Binding OsuLibrary.Songs.Count, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="TÍTULO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" />
                    <TextBlock Grid.Column="2" Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="ORIGEN / FUENTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                </Grid>

                <ListView x:Name="SongsListView" Grid.Row="1"
                          ItemsSource="{Binding OsuLibrary.Songs}"
                          ItemContainerStyle="{StaticResource OsuSongListViewItemStyle}"
                          ItemTemplate="{StaticResource OsuSongRowTemplate}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          VirtualizingPanel.CacheLength="1,1"
                          ScrollViewer.CanContentScroll="True"
                          AlternationCount="2"
                          PreviewMouseWheel="OnSongsListViewPreviewMouseWheel"
                          MouseDoubleClick="OnSongItemDoubleClick">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel Margin="28,12,28,6">
                                                    <Button Style="{StaticResource AlphaGroupHeaderButtonStyle}"
                                                            Content="{Binding Name}"
                                                            Click="OnAlphaHeaderClick" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
            </Grid>

            <!-- ========================================================== -->
            <!-- 2. TAB 1: ARTISTAS                                         -->
            <!-- ========================================================== -->
            <Grid x:Name="Tab1ArtistsGrid">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Tab1ArtistsTranslate" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OsuLibrary.SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="15" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OsuLibrary.IsInDetailView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Banner discreto de artistas dudosos (Unicode <-> Romaji ambiguos) -->
                <Border Grid.Row="0" Margin="28,0,28,12" Padding="14,10" CornerRadius="10"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                        Visibility="{Binding OsuLibrary.HasDoubtfulArtists, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="PeopleSwap24" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding OsuLibrary.DoubtfulBannerText}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" Appearance="Secondary" Padding="12,5"
                                   Command="{Binding OsuLibrary.OpenDoubtfulDialogCommand}">
                            <TextBlock Text="Revisar" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </ui:Button>
                    </Grid>
                </Border>

                <ListView Grid.Row="1" x:Name="ArtistsListView"
                          ItemsSource="{Binding OsuLibrary.ArtistSections}"
                          Tag="{Binding OsuLibrary}"
                          Background="Transparent" BorderThickness="0"
                          Padding="28,0,28,0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Stretch"
                          PreviewMouseWheel="OnArtistsListViewPreviewMouseWheel"
                          ItemTemplate="{StaticResource SharedArtistLetterSectionTemplate}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </Grid>

            <!-- ========================================================== -->
            <!-- 3. TAB 2: CON VÍDEO (TABULAR FULL-WIDTH LISTVIEW)          -->
            <!-- ========================================================== -->
            <Grid x:Name="Tab2VideoSongsGrid">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Tab2VideoSongsTranslate" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding OsuLibrary.SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="15" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding OsuLibrary.IsInDetailView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Fixed Column Header Bar -->
                <Grid Grid.Row="0" Margin="28,0,28,8" Visibility="{Binding OsuLibrary.VideoSongs.Count, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="2.6*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="TÍTULO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" />
                    <TextBlock Grid.Column="2" Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="ORIGEN / FUENTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                </Grid>

                <ListView x:Name="VideoSongsListView" Grid.Row="1"
                          ItemsSource="{Binding OsuLibrary.VideoSongs}"
                          ItemContainerStyle="{StaticResource OsuSongListViewItemStyle}"
                          ItemTemplate="{StaticResource OsuSongRowTemplate}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          VirtualizingPanel.CacheLength="1,1"
                          ScrollViewer.CanContentScroll="True"
                          AlternationCount="2"
                          PreviewMouseWheel="OnVideoSongsListViewPreviewMouseWheel"
                          MouseDoubleClick="OnSongItemDoubleClick">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel Margin="28,12,28,6">
                                                    <Button Style="{StaticResource AlphaGroupHeaderButtonStyle}"
                                                            Content="{Binding Name}"
                                                            Click="OnAlphaHeaderClick" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>
            </Grid>

            <!-- DETAIL VIEW 1: Selected Artist Songs (InfoArtista) -->
            <views:InfoArtista Margin="28,16,28,0"
                               Artist="{Binding OsuLibrary.SelectedArtistDetail}"
                               PlayArtistCommand="{Binding OsuLibrary.PlayArtistCommand}"
                               PlayTrackCommand="{Binding OsuLibrary.PlayTrackCommand}"
                               TrackContextMenu="{StaticResource SharedOsuTrackContextMenu}" />

            <!-- DETAIL VIEW 2: Selected Album (InfoAlbum) -->
            <views:InfoAlbum Margin="28,16,28,0"
                             Album="{Binding OsuLibrary.SelectedAlbumDetail}"
                             IsLoading="{Binding OsuLibrary.IsFetchingAlbumInfo}"
                             OpenArtistByNameCommand="{Binding OsuLibrary.OpenArtistByNameCommand}"
                             PlayTrackCommand="{Binding OsuLibrary.PlayTrackCommand}"
                             TrackContextMenu="{StaticResource SharedOsuTrackContextMenu}" />
        </Grid>

        <!-- ============================================================== -->
        <!-- JUMPLIST WINDOWS-STYLE MODAL SELECTOR (29 LETTERS)             -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Margin="0,-16,0,-10"
              Visibility="{Binding OsuLibrary.IsJumpListOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#CC09090E" ClipToBounds="True">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding OsuLibrary.CloseJumpListCommand}" />
            </Grid.InputBindings>

            <Border Width="440" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000" />
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{x:Null}" />
                </Border.InputBindings>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="18" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Ir a letra o grupo" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Right" Padding="6"
                                   Command="{Binding OsuLibrary.CloseJumpListCommand}"
                                   ToolTip="Cerrar">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <!-- 29 Letter Grid (6 columns) -->
                    <ItemsControl ItemsSource="{Binding OsuLibrary.JumpListLetters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:JumpListLetterItem}">
                                <Button Margin="4" Width="48" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                        Command="{Binding DataContext.OsuLibrary.SelectJumpLetterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Letter}"
                                        IsEnabled="{Binding HasItems}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBorder" Width="48" Height="44" CornerRadius="8" BorderThickness="1.5"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent">
                                                <TextBlock x:Name="BtnText" Text="{Binding Letter}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasItems}" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.28" />
                                                    <Setter TargetName="BtnText" Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding HasItems}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Setter TargetName="BtnText" Property="Foreground" Value="{Binding DataContext.Theme.AccentForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- DOUBTFUL ARTIST PAIRS REVIEW MODAL                             -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Margin="0,-16,0,-10"
              Visibility="{Binding OsuLibrary.IsDoubtfulDialogOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#CC09090E" ClipToBounds="True">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding OsuLibrary.CloseDoubtfulDialogCommand}" />
            </Grid.InputBindings>

            <Border Width="560" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000" />
                </Border.Effect>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{x:Null}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="PeopleSwap24" FontSize="18" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Revisar artistas similares (Unicode / Romaji)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Right" Padding="6"
                                   Command="{Binding OsuLibrary.CloseDoubtfulDialogCommand}"
                                   ToolTip="Cerrar">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Estos pares aparecen con más de una variante en tu biblioteca de osu!. Elige si deseas combinarlos bajo el nombre romaji o mantenerlos separados:"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OsuLibrary.DoubtfulArtistPairs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DoubtfulArtistPair}">
                                    <Border Background="{DynamicResource SurfaceCardSubtleBrush}"
                                            BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding DisplayPair}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           ToolTip="{Binding Reason}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:Button Appearance="Primary" Padding="10,5" Margin="0,0,6,0"
                                                           Background="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           Command="{Binding DataContext.OsuLibrary.CombineDoubtfulPairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}">
                                                    <TextBlock Text="Combinar" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding DataContext.Theme.AccentForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </ui:Button>
                                                <ui:Button Appearance="Secondary" Padding="10,5"
                                                           Command="{Binding DataContext.OsuLibrary.RejectDoubtfulPairCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}">
                                                    <TextBlock Text="No combinar" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
