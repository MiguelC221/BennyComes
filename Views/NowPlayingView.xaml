<UserControl x:Class="BenyComes.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:BenyComes.Models"
             xmlns:vm="clr-namespace:BenyComes.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100">

    <Grid ClipToBounds="True">
        <!-- ============================================================== -->
        <!-- BACKGROUND LAYER: DYNAMIC ARTIST GALLERY & KEN BURNS EFFECT    -->
        <!-- ============================================================== -->
        <Grid x:Name="BackgroundContainer" ClipToBounds="True">
            <!-- Ken Burns Animated Zoom Container (with -60 overscan margin so pan/zoom out never exposes borders) -->
            <Grid x:Name="BackgroundTransformContainer" Margin="-60" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BackgroundScale" ScaleX="1.0" ScaleY="1.0" />
                        <TranslateTransform x:Name="BackgroundTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image x:Name="BackgroundPrimary" Stretch="UniformToFill" Opacity="1.0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect x:Name="PrimaryBlur" Radius="{Binding NowPlaying.BackgroundBlurRadius}" RenderingBias="Performance" />
                    </Image.Effect>
                </Image>
                <Image x:Name="BackgroundSecondary" Stretch="UniformToFill" Opacity="0.0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect x:Name="SecondaryBlur" Radius="{Binding NowPlaying.BackgroundBlurRadius}" RenderingBias="Performance" />
                    </Image.Effect>
                </Image>
            </Grid>

            <!-- Darkening overlay with user-adjustable opacity -->
            <Border x:Name="BackgroundDarknessOverlay" Background="#000000" Opacity="{Binding NowPlaying.BackgroundDarkness}" />
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#8009090D" Offset="0.0" />
                        <GradientStop Color="#4009090D" Offset="0.4" />
                        <GradientStop Color="#A0050508" Offset="0.8" />
                        <GradientStop Color="#D0040407" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- TOP MINI DOWNLOAD PROGRESS BAR -->
        <ProgressBar VerticalAlignment="Top" Height="2.5" IsIndeterminate="True"
                     Foreground="{Binding Theme.CurrentAccentBrush}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding NowPlaying.IsFetchingArtistImages, Converter={StaticResource BoolToVisConverter}}" />

        <!-- TOP TOAST/BANNER NOTIFICATION FOR ARTIST IMAGES -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                Background="#E61E1E24" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16"
                Padding="14,6" Panel.ZIndex="100"
                Visibility="{Binding NowPlaying.ShowArtistImageNotification, Converter={StaticResource BoolToVisConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding NowPlaying.ArtistImageNotificationMessage}" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- TOP HUD CONTROLS: PERSONALIZACIÓN & BADGES (AUTO-HIDE)         -->
        <!-- ============================================================== -->
        <Grid x:Name="TopHudContainer" VerticalAlignment="Top" Height="48" Margin="20,38,20,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNowPlayingQueueExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Top Right Action Buttons: Personalización (...) & Output Mode Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Personalización Button (...) -->
                <ui:Button x:Name="CustomizationButton"
                           Appearance="Transparent" Padding="8,6" Margin="0,0,8,0"
                           Command="{Binding NowPlaying.ToggleCustomizationFlyoutCommand}"
                           ToolTip="Personalización">
                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="20" Foreground="#FFFFFF" />
                </ui:Button>

                <!-- Popup Flyout de Personalización -->
                <Popup x:Name="CustomizationPopup"
                       PlacementTarget="{Binding ElementName=CustomizationButton}"
                       Placement="Bottom"
                       HorizontalOffset="-260"
                       VerticalOffset="8"
                       IsOpen="{Binding NowPlaying.IsCustomizationFlyoutOpen, Mode=TwoWay}"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="#E6181820" BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="18" Width="340">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Direction="270" Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <!-- Header -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Color24" FontSize="18" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Personalización" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="4"
                                           Command="{Binding NowPlaying.CloseCustomizationFlyoutCommand}"
                                           ToolTip="Cerrar">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#99FFFFFF" />
                                </ui:Button>
                            </Grid>

                            <!-- 1. Usar imagen del artista en el fondo (Label antes del switch, switch a la derecha) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Imagen del artista" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                                    <TextBlock Text="Usar fotos del artista en el fondo" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#99FFFFFF">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Desactivado" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowPlaying.UseArtistBackground}" Value="True">
                                                        <Setter Property="Text" Value="Activado" />
                                                        <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:ToggleSwitch IsChecked="{Binding NowPlaying.UseArtistBackground, Mode=TwoWay}"
                                                     OffContent="" OnContent=""
                                                     VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Interruptor: Ver siempre la imagen de artista (Visible cuando haya imagen de artista disponible) -->
                            <Grid Margin="0,0,0,12" Visibility="{Binding NowPlaying.HasAvailableArtistImage, Converter={StaticResource BoolToVisConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="Ver siempre la imagen de artista" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                                    <TextBlock Text="Limita el difuminado hasta 4 px y el oscurecimiento al 30%" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#99FFFFFF">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Desactivado" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowPlaying.AlwaysShowArtistImage}" Value="True">
                                                        <Setter Property="Text" Value="Activado" />
                                                        <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:ToggleSwitch IsChecked="{Binding NowPlaying.AlwaysShowArtistImage, Mode=TwoWay}"
                                                     OffContent="" OnContent=""
                                                     VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Multi-Artist Collaboration Selector (Visible if song has multiple artists) -->
                            <StackPanel Margin="0,0,0,12" Visibility="{Binding NowPlaying.HasCollaborationArtists, Converter={StaticResource BoolToVisConverter}}">
                                <TextBlock Text="Descargar / Usar imágenes de:" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4" FontWeight="SemiBold" />
                                <ComboBox ItemsSource="{Binding NowPlaying.CollaborationArtists}"
                                          SelectedItem="{Binding NowPlaying.SelectedCollaborationArtist, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- 2. Seleccionar imagen de artista -->
                            <ui:Button Margin="0,0,0,8" HorizontalAlignment="Stretch" Padding="10,7"
                                       Command="{Binding OpenArtistGalleryCommand}"
                                       ToolTip="Ver y seleccionar fotos disponibles del artista">
                                <Grid HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Seleccionar imagen de artista" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </ui:Button>

                            <!-- 2.b Siguiente imagen de artista -->
                            <ui:Button Margin="0,0,0,14" HorizontalAlignment="Stretch" Padding="10,7"
                                       Command="{Binding NowPlaying.NextArtistImageCommand}"
                                       IsEnabled="{Binding NowPlaying.UseArtistBackground}"
                                       ToolTip="Cambiar de inmediato a la siguiente foto del artista">
                                <Grid HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Next24" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Siguiente imagen de artista" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    </StackPanel>
                                </Grid>
                            </ui:Button>

                            <Separator Background="#22FFFFFF" Margin="0,0,0,12" />

                            <!-- 3. Intensidad del difuminado (Blur) -->
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Intensidad de difuminado (Blur)" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding NowPlaying.BackgroundBlurRadius, StringFormat='{}{0:F0} px'}"
                                               HorizontalAlignment="Right" FontSize="12" Foreground="{Binding Theme.CurrentAccentBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="0" Maximum="{Binding NowPlaying.MaxBlurRadius, FallbackValue=80}" SmallChange="1" LargeChange="5"
                                        Value="{Binding NowPlaying.BackgroundBlurRadius, Mode=TwoWay}"
                                        ValueChanged="OnBlurSliderValueChanged" />
                            </StackPanel>

                            <!-- 4. Slider de Oscurecimiento del Fondo (10% a 90%) -->
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Oscurecimiento del fondo" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding NowPlaying.BackgroundDarkness, StringFormat='{}{0:P0}'}"
                                               HorizontalAlignment="Right" FontSize="12" Foreground="{Binding Theme.CurrentAccentBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="0.10" Maximum="{Binding NowPlaying.MaxDarkness, FallbackValue=0.90}" SmallChange="0.05" LargeChange="0.10"
                                        Value="{Binding NowPlaying.BackgroundDarkness, Mode=TwoWay}"
                                        ValueChanged="OnDarknessSliderValueChanged" />
                            </StackPanel>

                            <!-- 5. Slider de Duración por Foto de Artista (15s a 90s) -->
                            <StackPanel Margin="0,0,0,14">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Duración por foto de artista" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding NowPlaying.ArtistImageIntervalSeconds, StringFormat='{}{0} s'}"
                                               HorizontalAlignment="Right" FontSize="12" Foreground="{Binding Theme.CurrentAccentBrush}" FontWeight="Bold" />
                                </Grid>
                                <Slider Minimum="15" Maximum="90" SmallChange="5" LargeChange="15"
                                        IsSnapToTickEnabled="True" TickFrequency="5"
                                        Value="{Binding NowPlaying.ArtistImageIntervalSeconds, Mode=TwoWay}" />
                            </StackPanel>

                            <Separator Background="#22FFFFFF" Margin="0,0,0,12" />

                            <!-- 6. Visualizador de audio (Label antes del switch, switch a la derecha) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Visualizador de audio" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                                    <TextBlock Text="Reactivo a las frecuencias" FontSize="11" Foreground="#99FFFFFF" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#99FFFFFF">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Desactivado" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NowPlaying.IsVisualizerActive}" Value="True">
                                                        <Setter Property="Text" Value="Activado" />
                                                        <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ui:ToggleSwitch IsChecked="{Binding NowPlaying.IsVisualizerActive, Mode=TwoWay}"
                                                     OffContent="" OnContent=""
                                                     VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 7. Tipo de visualización -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Tipo de visualización" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding NowPlaying.SelectedVisualizerMode, Mode=TwoWay}"
                                          SelectedValuePath="Content"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Barras de Espectro" />
                                    <ComboBoxItem Content="Onda Reactiva" />
                                    <ComboBoxItem Content="Pulso de Bajos" />
                                </ComboBox>
                            </StackPanel>

                            <Separator Background="#22FFFFFF" Margin="0,0,0,10" />

                            <!-- 8. Botón Forzar Actualización de Estilo -->
                            <ui:Button HorizontalAlignment="Stretch" Padding="10,6"
                                       Appearance="Secondary"
                                       Command="{Binding NowPlaying.ForceUpdateStyleCommand}"
                                       ToolTip="Refrescar inmediatamente fondo, desenfoque y oscurecimiento">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="Forzar actualización de estilo" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Output Mode Badge Top Right -->
                <Border Style="{StaticResource TechBadgeStyle}" Background="#33000000" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkStarburst24" FontSize="14" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding NowPlaying.TechnicalInfo.OutputMode}" FontWeight="Bold" FontSize="11" Foreground="{Binding Theme.CurrentAccentBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- STATE A: NORMAL IMMERSIVE VIEW (QUEUE COLLAPSED)               -->
        <!-- ============================================================== -->
        <Grid x:Name="NormalImmersiveContainer" Margin="48,56,48,20" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="NormalImmersiveTranslate" Y="0" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Bottom-Left Main Info Block -->
            <Grid x:Name="TrackInfoContainer" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,24">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="TrackInfoTranslate" X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Album Art with CornerRadius="12" & DropShadow & Bass Pulse -->
                <Border Grid.Column="0" Width="220" Height="220" CornerRadius="12" ClipToBounds="True" Background="#1C1C24"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding NowPlaying.Visualizer.BassScale}"
                                        ScaleY="{Binding NowPlaying.Visualizer.BassScale}" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" Color="{Binding Theme.CurrentAccentColor}"
                                          Opacity="{Binding NowPlaying.Visualizer.BassGlowOpacity}" ShadowDepth="0" />
                    </Border.Effect>
                    <Image Source="{Binding NowPlaying.AlbumArt}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Track Info & Audio Badges Stack -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28,0,0,0" MaxWidth="720">
                    <!-- Interactive Song Info (Title & Artist) redirects to Album -->
                    <Button Command="{Binding DataContext.ViewCurrentAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Margin="0,0,0,16"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Cursor="Hand"
                            ToolTip="Ver álbum de la canción">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <!-- Title -->
                            <TextBlock Text="{Binding NowPlaying.Title}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="30" FontWeight="Bold" Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.5" ShadowDepth="2" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Interactive Artist • Album -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding NowPlaying.Artist}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="16" Foreground="#D0FFFFFF">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.4" ShadowDepth="2" />
                                    </TextBlock.Effect>
                                </TextBlock>

                                <!-- Dot Separator -->
                                <TextBlock Text=" • " FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="16" Foreground="#80FFFFFF" VerticalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.4" ShadowDepth="2" />
                                    </TextBlock.Effect>
                                </TextBlock>

                                <!-- Album -->
                                <TextBlock Text="{Binding NowPlaying.Album}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="16" Foreground="#D0FFFFFF">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.4" ShadowDepth="2" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Real-Time Audio Technical Badges -->
                    <WrapPanel x:Name="TechBadgesPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource TechBadgeStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SoundSource24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding NowPlaying.TechnicalInfo.Format}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TechBadgeStyle}">
                            <TextBlock Text="{Binding NowPlaying.TechnicalInfo.SampleRate}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" />
                        </Border>
                        <Border Style="{StaticResource TechBadgeStyle}">
                            <TextBlock Text="{Binding NowPlaying.TechnicalInfo.BitDepth}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" />
                        </Border>
                        <Border Style="{StaticResource TechBadgeStyle}">
                            <TextBlock Text="{Binding NowPlaying.TechnicalInfo.Channels}" FontSize="11" Foreground="#CCFFFFFF" />
                        </Border>
                        <Border Style="{StaticResource TechBadgeStyle}" Background="#22000000">
                            <TextBlock Text="{Binding NowPlaying.TechnicalInfo.Bitrate}" FontSize="11" Foreground="#BBFFFFFF" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- Bottom Visualizer, Transport & Seekbar -->
            <StackPanel x:Name="BottomRowPanel" Grid.Row="1">
                <!-- Visualizer Display Area -->
                <Grid x:Name="VisualizerContainer" Height="55" Margin="0,0,0,10" VerticalAlignment="Bottom">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="VisualizerTranslate" X="0" Y="0" />
                    </Grid.RenderTransform>
                    <!-- 1. Spectrum Bars -->
                    <ItemsControl x:Name="SpectrumItems" ItemsSource="{Binding NowPlaying.Visualizer.SpectrumBars}"
                                  HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Barras de Espectro">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="6" Height="{Binding}" CornerRadius="3" Margin="2,0"
                                        VerticalAlignment="Bottom"
                                        Background="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 2. Reactive Waveform -->
                    <Polyline x:Name="WaveformLine" Points="{Binding NowPlaying.Visualizer.WaveformPoints}"
                              Stroke="{Binding Theme.CurrentAccentBrush}"
                              StrokeThickness="2.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Polyline.Style>
                            <Style TargetType="Polyline">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Onda Reactiva">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Polyline.Style>
                    </Polyline>
                </Grid>

                <!-- AUTO-HIDE HUD CONTROLS: Seekbar & Transport/Volume Bar -->
                <StackPanel x:Name="BottomHudControlsContainer">
                    <!-- Seekbar with Wide Single-Click Hitbox -->
                    <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding NowPlaying.CurrentTimeText}" FontSize="12" FontWeight="SemiBold" Foreground="#B0FFFFFF" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="Transparent" Padding="0,8" Cursor="Hand"
                            PreviewMouseLeftButtonDown="OnSeekContainerMouseDown"
                            PreviewMouseMove="OnSeekContainerMouseMove"
                            PreviewMouseLeftButtonUp="OnSeekContainerMouseUp">
                        <Slider x:Name="NowPlayingSeekSlider" Margin="10,0"
                                Minimum="0" Maximum="{Binding NowPlaying.TotalDurationSeconds}"
                                Value="{Binding NowPlaying.CurrentPositionSeconds, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                PreviewMouseLeftButtonDown="OnSeekSliderPreviewMouseDown"
                                PreviewMouseMove="OnSeekSliderPreviewMouseMove"
                                PreviewMouseLeftButtonUp="OnSeekSliderPreviewMouseUp"
                                ValueChanged="OnSeekSliderValueChanged" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding NowPlaying.TotalTimeText}" FontSize="12" FontWeight="SemiBold" Foreground="#B0FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- Controls Bar -->
                <Grid Height="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Transport -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- Shuffle Button -->
                        <Button Command="{Binding NowPlaying.ToggleShuffleCommand}" Cursor="Hand" Padding="0" Margin="0,0,4,0" ToolTip="Reproducción aleatoria">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="8,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="ArrowShuffle24" FontSize="18" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ui:Button Appearance="Transparent" Padding="9" Margin="0,0,4,0" Command="{Binding NowPlaying.PreviousCommand}">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="20" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <Button Style="{StaticResource CircularPlayPauseButtonStyle}"
                                Command="{Binding NowPlaying.PlayPauseCommand}"
                                Margin="4,0,8,0" />

                        <ui:Button Appearance="Transparent" Padding="9" Margin="0,0,4,0" Command="{Binding NowPlaying.NextCommand}">
                            <ui:SymbolIcon Symbol="Next24" FontSize="20" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <!-- Repeat Button -->
                        <Button Command="{Binding NowPlaying.CycleRepeatCommand}" Cursor="Hand" Padding="0" Margin="0,0,12,0" ToolTip="Modo de repetición">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="8,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="{Binding NowPlaying.RepeatMode, Converter={StaticResource RepeatModeToSymbolConverter}}" FontSize="18" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="All">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="One">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Center: Expand Queue Arrow (^) -->
                    <ui:Button Grid.Column="1" Appearance="Transparent" Padding="14,6"
                               Command="{Binding ToggleNowPlayingQueueCommand}"
                               ToolTip="Desplegar Cola Actual (Up Next)">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ChevronUp24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" />
                            <TextBlock Text="Cola activa" FontSize="10" FontWeight="SemiBold" Foreground="#A0FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Right: Extra Controls (Mute Button, Volume Slider, DAC Selector, Fullscreen, More Options) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Volume Mute Button -->
                        <Button Command="{Binding NowPlaying.ToggleMuteCommand}" Cursor="Hand" Width="36" Height="36" Padding="0" ToolTip="Silenciar / Activar sonido">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="6,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" FontSize="17" Foreground="#D9FFFFFF" HorizontalAlignment="Center">
                                                <ui:SymbolIcon.Symbol>
                                                    <MultiBinding Converter="{StaticResource VolumeToSymbolConverter}">
                                                        <Binding Path="NowPlaying.Volume" />
                                                        <Binding Path="NowPlaying.IsMuted" />
                                                    </MultiBinding>
                                                </ui:SymbolIcon.Symbol>
                                            </ui:SymbolIcon>
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="#FF4C4C" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.IsMuted}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FF6B6B" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Volume Slider with Wide Single-Click Hitbox -->
                        <Border Background="Transparent" Padding="0,8" Margin="4,0,12,0" Cursor="Hand">
                            <Slider Width="110" Minimum="0" Maximum="1"
                                    IsMoveToPointEnabled="True"
                                    Value="{Binding NowPlaying.Volume, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="OnVolumeSliderPreviewMouseDown"
                                    PreviewMouseMove="OnVolumeSliderPreviewMouseMove"
                                    PreviewMouseLeftButtonUp="OnVolumeSliderPreviewMouseUp"
                                    VerticalAlignment="Center" />
                        </Border>

                        <!-- DAC Output Selector Button -->
                        <Button Command="{Binding ToggleDeviceSelectorCommand}" Cursor="Hand" Padding="0" Margin="0,0,6,0" ToolTip="Dispositivo de salida / WASAPI Exclusive Bit-Perfect">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="7,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Hi-Fi Speaker Minicomponente / Bafle Vector Icon -->
                                            <Grid Width="16" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="14" Height="17.5" RadiusX="2.5" RadiusY="2.5" Stroke="#D9FFFFFF" StrokeThickness="1.5" Fill="#1AFFFFFF" />
                                                <Ellipse Width="3.5" Height="3.5" Fill="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3.5,0,0" />
                                                <Ellipse Width="7.5" Height="7.5" Stroke="#D9FFFFFF" StrokeThickness="1.2" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2.5" />
                                                <Ellipse Width="2.5" Height="2.5" Fill="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                            </Grid>
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceSelectorOpen}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Fullscreen Button -->
                        <ui:Button Appearance="Transparent" Padding="8" Margin="4,0,4,0"
                                   Command="{Binding ToggleFullscreenCommand}"
                                   ToolTip="Pantalla completa (F11)">
                            <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="18" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <!-- More Options (...) Button (Opens on Left or Right Click) -->
                        <ui:Button Appearance="Transparent" Padding="8"
                                   Click="OnMoreOptionsButtonClick"
                                   ToolTip="Más opciones y Ecualizador">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Lista actual"
                                              Command="{Binding OpenCurrentQueueCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Añadir a lista de reproducción" SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="List24" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="+ Nueva lista de reproducción..." />
                                    </MenuItem>
                                    <MenuItem Header="Ver álbum"
                                              Command="{Binding ViewCurrentAlbumCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Album24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ver artista"
                                              Command="{Binding ViewCurrentArtistCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Person24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Añadir pistas relacionadas"
                                              Command="{Binding AddRelatedTracksCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Sparkle24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Ecualizador"
                                              Command="{Binding ToggleEqualizerCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Options24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Galería de fotos del artista"
                                              Command="{Binding OpenArtistGalleryCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="ImageMultiple24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Parar / Detener música"
                                              Command="{Binding StopMusicCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Stop24" Foreground="#E81123" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" Foreground="#E0FFFFFF" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- QUEUE ACTIVE BACKGROUND BACKDROP (90% OPACITY FADE-IN)         -->
        <!-- ============================================================== -->
        <Border x:Name="QueueBackdropOverlay" Background="#0A0B10" IsHitTestVisible="False"
                Visibility="Collapsed" Opacity="0.0" />

        <!-- ============================================================== -->
        <!-- STATE B: QUEUE EXPANDED VIEW (UP NEXT 4-COLUMN LAYOUT)        -->
        <!-- ============================================================== -->
        <Grid x:Name="QueueExpandedContainer" Margin="48,46,48,20" RenderTransformOrigin="0.5,0.5"
              Visibility="Collapsed" Opacity="0.0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="QueueTranslate" Y="0" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Shifted Track Info & Full Controls -->
                <RowDefinition Height="Auto" /> <!-- Center Down Arrow (v) -->
                <RowDefinition Height="*" />    <!-- 4-Column Clean Queue List -->
            </Grid.RowDefinitions>

            <!-- Top Shifted Track Info Bar, Seekbar & Full Transport Controls -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Compact Album Art & Titles -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True" Background="#1C1C24" Margin="0,0,16,0">
                            <Image Source="{Binding NowPlaying.AlbumArt}" Stretch="UniformToFill" />
                        </Border>
                        <Button Command="{Binding DataContext.ViewCurrentAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                HorizontalContentAlignment="Left"
                                Cursor="Hand"
                                ToolTip="Ver álbum de la canción">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel VerticalAlignment="Center" MaxWidth="320">
                                <TextBlock Text="{Binding NowPlaying.Title}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding NowPlaying.ArtistAndAlbum}" FontSize="13" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Full Transport Controls Center-Right in State B -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Shuffle Button -->
                        <Button Command="{Binding NowPlaying.ToggleShuffleCommand}" Cursor="Hand" Padding="0" Margin="0,0,3,0" ToolTip="Reproducción aleatoria">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="7,4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="ArrowShuffle24" FontSize="16" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ui:Button Appearance="Transparent" Padding="7" Command="{Binding NowPlaying.PreviousCommand}">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="18" Foreground="#FFFFFF" />
                        </ui:Button>
                        <Button Style="{StaticResource CircularPlayPauseButtonStyle}"
                                Command="{Binding NowPlaying.PlayPauseCommand}"
                                Margin="4,0" />
                        <ui:Button Appearance="Transparent" Padding="7" Command="{Binding NowPlaying.NextCommand}">
                            <ui:SymbolIcon Symbol="Next24" FontSize="18" Foreground="#FFFFFF" />
                        </ui:Button>

                        <!-- Repeat Button -->
                        <Button Command="{Binding NowPlaying.CycleRepeatCommand}" Cursor="Hand" Padding="0" Margin="3,0,6,0" ToolTip="Modo de repetición">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="7,4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="{Binding NowPlaying.RepeatMode, Converter={StaticResource RepeatModeToSymbolConverter}}" FontSize="16" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="All">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="One">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Volume Mute Button -->
                        <Button Command="{Binding NowPlaying.ToggleMuteCommand}" Cursor="Hand" Width="32" Height="32" Padding="0" ToolTip="Silenciar / Activar sonido">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="5,4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" FontSize="15" Foreground="#D9FFFFFF" HorizontalAlignment="Center">
                                                <ui:SymbolIcon.Symbol>
                                                    <MultiBinding Converter="{StaticResource VolumeToSymbolConverter}">
                                                        <Binding Path="NowPlaying.Volume" />
                                                        <Binding Path="NowPlaying.IsMuted" />
                                                    </MultiBinding>
                                                </ui:SymbolIcon.Symbol>
                                            </ui:SymbolIcon>
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="#FF4C4C" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.IsMuted}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FF6B6B" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Volume Slider with Wide Hitbox -->
                        <Border Background="Transparent" Padding="0,8" Margin="2,0,8,0" Cursor="Hand">
                            <Slider Width="90" Minimum="0" Maximum="1"
                                    IsMoveToPointEnabled="True"
                                    Value="{Binding NowPlaying.Volume, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="OnVolumeSliderPreviewMouseDown"
                                    PreviewMouseMove="OnVolumeSliderPreviewMouseMove"
                                    PreviewMouseLeftButtonUp="OnVolumeSliderPreviewMouseUp"
                                    VerticalAlignment="Center" />
                        </Border>

                        <!-- Fullscreen Button -->
                        <ui:Button Appearance="Transparent" Padding="7" Margin="0,0,4,0"
                                   Command="{Binding ToggleFullscreenCommand}"
                                   ToolTip="Pantalla completa (F11)">
                            <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="16" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <!-- More Options (...) Button -->
                        <ui:Button Appearance="Transparent" Padding="7"
                                   Click="OnMoreOptionsButtonClick"
                                   ToolTip="Más opciones y Ecualizador">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Lista actual"
                                              Command="{Binding OpenCurrentQueueCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Añadir a lista de reproducción" SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="List24" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="+ Nueva lista de reproducción..." />
                                    </MenuItem>
                                    <MenuItem Header="Ver álbum"
                                              Command="{Binding ViewCurrentAlbumCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Album24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ver artista"
                                              Command="{Binding ViewCurrentArtistCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Person24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Añadir pistas relacionadas"
                                              Command="{Binding AddRelatedTracksCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Sparkle24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Ecualizador"
                                              Command="{Binding ToggleEqualizerCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Options24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Parar / Detener música"
                                              Command="{Binding StopMusicCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Stop24" Foreground="#E81123" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" Foreground="#E0FFFFFF" />
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- State B Seekbar with Wide Single-Click Hitbox -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding NowPlaying.CurrentTimeText}" FontSize="11" FontWeight="SemiBold" Foreground="#B0FFFFFF" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="Transparent" Padding="0,6" Cursor="Hand">
                        <Slider Margin="8,0"
                                Minimum="0" Maximum="{Binding NowPlaying.TotalDurationSeconds}"
                                Value="{Binding NowPlaying.CurrentPositionSeconds, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                PreviewMouseLeftButtonDown="OnSeekSliderPreviewMouseDown"
                                PreviewMouseMove="OnSeekSliderPreviewMouseMove"
                                PreviewMouseLeftButtonUp="OnSeekSliderPreviewMouseUp"
                                ValueChanged="OnSeekSliderValueChanged" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding NowPlaying.TotalTimeText}" FontSize="11" FontWeight="SemiBold" Foreground="#B0FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Center Down Arrow (v) to collapse back -->
            <Grid Grid.Row="1" Margin="0,2,0,8">
                <ui:Button Appearance="Transparent" Padding="14,4" HorizontalAlignment="Center"
                           Command="{Binding ToggleNowPlayingQueueCommand}"
                           ToolTip="Ocultar cola de reproducción">
                    <StackPanel Orientation="Vertical">
                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" />
                        <TextBlock Text="Ocultar cola" FontSize="10" FontWeight="SemiBold" Foreground="#99FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Locate active track -->
                <ui:Button Appearance="Transparent" Padding="10,8" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Click="OnLocateCurrentTrackClick"
                           ToolTip="Ir a la canción actual">
                    <ui:SymbolIcon Symbol="Target24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" />
                </ui:Button>
            </Grid>

            <!-- 4-Column Clean Queue List (Full Width, No heavy borders) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Column Headers -->
                    <RowDefinition Height="*" />    <!-- Rows -->
                </Grid.RowDefinitions>

                <!-- 4 Columns Header -->
                <Grid Grid.Row="0" Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" /> <!-- Canción -->
                        <ColumnDefinition Width="1.5*" /> <!-- Artista -->
                        <ColumnDefinition Width="1.8*" /> <!-- Álbum -->
                        <ColumnDefinition Width="80" />   <!-- Duración -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CANCIÓN" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" />
                    <TextBlock Grid.Column="1" Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" />
                    <TextBlock Grid.Column="2" Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" />
                    <TextBlock Grid.Column="3" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" HorizontalAlignment="Right" />
                </Grid>

                <!-- Queue ListView with Full Right-Click ContextMenu -->
                <ListView x:Name="QueueListView" Grid.Row="1" ItemsSource="{Binding Queue.Queue}"
                          SelectedItem="{Binding Queue.SelectedTrack, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="OnQueueItemDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu Opened="OnTrackContextMenuOpened">
                                        <MenuItem Header="Reproducir ahora"
                                                  Command="{Binding PlayTrackNowCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Play24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Reproducir siguiente (Play Next)"
                                                  Command="{Binding PlayNextCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowRight24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Ir a artista"
                                                  Command="{Binding NavigateToArtistCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding Artist}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Person24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Ir a álbum"
                                                  Command="{Binding NavigateToAlbumCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding Album}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Album24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Agregar a lista de reproducción" SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="List24" />
                                            </MenuItem.Icon>
                                            <MenuItem Header="+ Nueva lista de reproducción..." />
                                        </MenuItem>
                                        <MenuItem Header="Marcar / Desmarcar Favorito ♥"
                                                  Command="{Binding ToggleFavoriteCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Heart24" Foreground="#E81123" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Ver información de la pista"
                                                  Command="{Binding ShowTrackPropertiesCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Info24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Eliminar pista"
                                                  Command="{Binding DeleteTrackCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" Foreground="#E81123" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Margin="0,1" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#15FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Track}">
                            <Border CornerRadius="6" Padding="16,10" Margin="0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Background" Value="#2A00D26A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" /> <!-- Icon + Title -->
                                        <ColumnDefinition Width="1.5*" /> <!-- Artist -->
                                        <ColumnDefinition Width="1.8*" /> <!-- Album -->
                                        <ColumnDefinition Width="80" />   <!-- Duration -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 1: Equalizer Icon + Song Title -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Active Equalizer Bars Icon -->
                                        <ui:SymbolIcon Symbol="Speaker224" FontSize="15" Margin="0,0,10,0"
                                                       Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisConverter}}"
                                                       Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#E0FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Col 2: Artist -->
                                    <TextBlock Grid.Column="1" Text="{Binding Artist}" FontSize="12"
                                               Foreground="#B0FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <!-- Col 3: Album -->
                                    <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="12"
                                               Foreground="#88FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <!-- Col 4: Duration -->
                                    <TextBlock Grid.Column="3" Text="{Binding DurationFormatted}" FontSize="12"
                                               Foreground="#99FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
