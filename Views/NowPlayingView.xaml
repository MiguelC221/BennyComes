<UserControl x:Class="BenyComes.Views.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:models="clr-namespace:BenyComes.Models"
             xmlns:vm="clr-namespace:BenyComes.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100"
             SizeChanged="OnNowPlayingViewSizeChanged">

    <Grid ClipToBounds="True">
        <!-- ============================================================== -->
        <!-- BACKGROUND LAYER: DYNAMIC ARTIST GALLERY & KEN BURNS EFFECT    -->
        <!-- ============================================================== -->
        <Grid x:Name="BackgroundContainer" ClipToBounds="True">
            <!-- Semi-transparent Acrylic Fallback Background (Visible when transparent PNG/artwork or video with margins is active) -->
            <Border Background="#1C182B" />
            <Border Background="#660A0A12" />

            <!-- Ken Burns Animated Zoom Container (with -90 overscan margin so pan/zoom out never exposes borders) -->
            <Grid x:Name="BackgroundTransformContainer" Margin="-90" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="BackgroundScale" ScaleX="1.0" ScaleY="1.0" />
                        <TranslateTransform x:Name="BackgroundTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image x:Name="BackgroundPrimary" Stretch="UniformToFill" Opacity="1.0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect x:Name="PrimaryBlur" Radius="{Binding NowPlaying.BackgroundBlurRadius}" RenderingBias="Performance" />
                    </Image.Effect>
                </Image>
                <Image x:Name="BackgroundSecondary" Stretch="UniformToFill" Opacity="0.0"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <BlurEffect x:Name="SecondaryBlur" Radius="{Binding NowPlaying.BackgroundBlurRadius}" RenderingBias="Performance" />
                    </Image.Effect>
                </Image>
            </Grid>

            <!-- Dynamic Blurred Video Backdrop Container (Rellena los espacios y bordes del vídeo de osu!) -->
            <Grid x:Name="OsuVideoBlurContainer" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.0" IsHitTestVisible="False">
                <!-- Capa para MediaElement nativo (VisualBrush en tiempo real) -->
                <Rectangle x:Name="OsuVideoMediaElementBlur" Stretch="Fill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <VisualBrush Visual="{Binding ElementName=OsuBackgroundVideoPlayer}" Stretch="UniformToFill" />
                    </Rectangle.Fill>
                    <Rectangle.Effect>
                        <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance" />
                    </Rectangle.Effect>
                </Rectangle>

                <!-- Capa para LibVLC Fallback (Renderizado dinámico de _vlcBitmap con UniformToFill y Blur) -->
                <Image x:Name="OsuVlcVideoBlurImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image.Effect>
                        <BlurEffect Radius="60" KernelType="Gaussian" RenderingBias="Performance" />
                    </Image.Effect>
                </Image>

                <!-- Tinte oscuro para que el fondo difuminado resalte el vídeo central y mantenga contraste -->
                <Border Background="#73000000" />
            </Grid>

            <!-- osu! Video Background Player Layer (MediaElement nativo) -->
            <MediaElement x:Name="OsuBackgroundVideoPlayer"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          Stretch="{Binding NowPlaying.OsuVideoStretch}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          IsMuted="True"
                          ScrubbingEnabled="True"
                          Opacity="0.0" />

            <!-- LibVLC Fallback Video Player Layer (Memoria / WriteableBitmap nativa sin Airspace) -->
            <Image x:Name="OsuVlcVideoImage"
                   Stretch="{Binding NowPlaying.OsuVideoStretch}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Opacity="0.0" />

            <!-- Darkening overlay with user-adjustable opacity -->
            <Border x:Name="BackgroundDarknessOverlay" Background="#000000" Opacity="{Binding NowPlaying.BackgroundDarkness}" />
            <Border x:Name="BackgroundGradientOverlay">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#8009090D" Offset="0.0" />
                        <GradientStop Color="#4009090D" Offset="0.4" />
                        <GradientStop Color="#A0050508" Offset="0.8" />
                        <GradientStop Color="#D0040407" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- TOP MINI DOWNLOAD PROGRESS BAR -->
        <ProgressBar VerticalAlignment="Top" Height="2.5" IsIndeterminate="True"
                     Foreground="{Binding Theme.CurrentAccentBrush}" Background="Transparent" BorderThickness="0"
                     Visibility="{Binding NowPlaying.IsFetchingArtistImages, Converter={StaticResource BoolToVisConverter}}" />

        <!-- TOP TOAST/BANNER NOTIFICATION FOR ARTIST IMAGES -->
        <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                Background="#E61E1E24" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16"
                Padding="14,6" Panel.ZIndex="100"
                Visibility="{Binding NowPlaying.ShowArtistImageNotification, Converter={StaticResource BoolToVisConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Info24" FontSize="14" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding NowPlaying.ArtistImageNotificationMessage}" FontSize="12" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- TOP HUD CONTROLS: PERSONALIZACIÓN & BADGES (AUTO-HIDE)         -->
        <!-- ============================================================== -->
        <Grid x:Name="TopHudContainer" VerticalAlignment="Top" Height="48" Margin="20,38,20,0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNowPlayingQueueExpanded}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Top Left / Center in Compact Mobile Mode (Back Chevron Down & Queue position / Album title) -->
            <Grid Grid.Column="0">
                <!-- Back Button in Compact Mode (Left) -->
                <ui:Button Appearance="Transparent" Padding="8,6" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Command="{Binding CloseNowPlayingCommand, Source={x:Static vm:MainViewModel.Instance}}"
                           ToolTip="Ocultar Reproducción en curso">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NowPlaying.IsCompactMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="20" Foreground="#FFFFFF" />
                </ui:Button>

                <!-- Center Title / Queue info in Compact Mode -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NowPlaying.IsCompactMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding NowPlaying.QueuePositionText}" FontSize="11" Foreground="#99FFFFFF" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding NowPlaying.AlbumFallbackTitle}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                               TextTrimming="CharacterEllipsis" MaxWidth="280" HorizontalAlignment="Center" Margin="0,1,0,0" />
                </StackPanel>
            </Grid>

            <!-- Top Right Action Buttons: Modo Cine (Ojo), Personalización (...) & Output Mode Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Modo Cine / Vista Limpia (Ojo) -->
                <ui:Button x:Name="CinemaModeButton"
                           Appearance="Transparent" Padding="8,6" Margin="0,0,6,0"
                           Click="OnCinemaModeButtonClick"
                           ToolTip="Modo cine: ocultar todo el HUD al estar inactivo el cursor">
                    <ui:SymbolIcon x:Name="CinemaModeIcon" Symbol="Eye24" FontSize="20" Foreground="#FFFFFF" />
                </ui:Button>

                <!-- Personalización Button (...) -->
                <ui:Button x:Name="CustomizationButton"
                           Appearance="Transparent" Padding="8,6" Margin="0,0,8,0"
                           Command="{Binding NowPlaying.ToggleCustomizationFlyoutCommand}"
                           ToolTip="Personalización">
                    <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="20" Foreground="#FFFFFF" />
                </ui:Button>

                <!-- Popup Flyout de Personalización -->
                <Popup x:Name="CustomizationPopup"
                       PlacementTarget="{Binding ElementName=CustomizationButton}"
                       Placement="Bottom"
                       HorizontalOffset="-260"
                       VerticalOffset="8"
                       IsOpen="{Binding NowPlaying.IsCustomizationFlyoutOpen, Mode=TwoWay}"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="#E6181820" BorderBrush="#33FFFFFF" BorderThickness="1"
                            CornerRadius="12" Padding="18,14,14,14" Width="340">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6" Direction="270" Color="#000000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header fijo con título y botón de cerrar -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Color24" FontSize="18" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Personalización" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>
                                <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="4"
                                           Command="{Binding NowPlaying.CloseCustomizationFlyoutCommand}"
                                           ToolTip="Cerrar">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Foreground="#99FFFFFF" />
                                </ui:Button>
                            </Grid>

                            <!-- Contenido con ScrollViewer para que no se salga de la pantalla -->
                            <ScrollViewer x:Name="CustomizationScrollViewer" Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,4,0">
                                <StackPanel>
                                    <!-- 1. Usar imagen del artista en el fondo (Label antes del switch, switch a la derecha) -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="Imagen del artista" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                                            <TextBlock Text="Usar fotos del artista en el fondo" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#99FFFFFF">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Desactivado" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NowPlaying.UseArtistBackground}" Value="True">
                                                                <Setter Property="Text" Value="Activado" />
                                                                <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ui:ToggleSwitch IsChecked="{Binding NowPlaying.UseArtistBackground, Mode=TwoWay}"
                                                             OffContent="" OnContent=""
                                                             VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Interruptor: Ver siempre la imagen de artista (Visible cuando haya imagen de artista disponible) -->
                                    <Grid Margin="0,0,0,12" Visibility="{Binding NowPlaying.HasAvailableArtistImage, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="Ver siempre la imagen de artista" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                                            <TextBlock Text="Limita el difuminado hasta 4 px y el oscurecimiento al 30%" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#99FFFFFF">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Desactivado" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NowPlaying.AlwaysShowArtistImage}" Value="True">
                                                                <Setter Property="Text" Value="Activado" />
                                                                <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ui:ToggleSwitch IsChecked="{Binding NowPlaying.AlwaysShowArtistImage, Mode=TwoWay}"
                                                             OffContent="" OnContent=""
                                                             VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Multi-Artist Collaboration Selector (Visible if song has multiple artists) -->
                                    <StackPanel Margin="0,0,0,12" Visibility="{Binding NowPlaying.HasCollaborationArtists, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBlock Text="Descargar / Usar imágenes de:" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding NowPlaying.CollaborationArtists}"
                                                  SelectedItem="{Binding NowPlaying.SelectedCollaborationArtist, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <!-- OSU! MUSIC VIDEO PLAYBACK TOGGLE & STRETCH (Visible only if current track has an osu! video) -->
                                    <StackPanel Margin="0,0,0,14" Visibility="{Binding NowPlaying.HasOsuVideo, Converter={StaticResource BoolToVisConverter}}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Video24" FontSize="14" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="Reproducir video de fondo (osu!)" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                                                </StackPanel>
                                                <TextBlock Text="Muestra el video del beatmap sincronizado en tiempo real" FontSize="11" Foreground="#99FFFFFF" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding NowPlaying.PlayOsuBackgroundVideo, Mode=TwoWay}"
                                                             OffContent="" OnContent="" VerticalAlignment="Center" />
                                        </Grid>

                                        <!-- Video Stretch Mode Selector (visible when video playback toggle is enabled) -->
                                        <StackPanel Visibility="{Binding NowPlaying.PlayOsuBackgroundVideo, Converter={StaticResource BoolToVisConverter}}" Margin="20,0,0,0">
                                            <TextBlock Text="Ajuste de video:" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4" FontWeight="SemiBold" />
                                            <ComboBox ItemsSource="{Binding NowPlaying.OsuVideoStretchOptions}"
                                                      SelectedItem="{Binding NowPlaying.OsuVideoStretchMode, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 2. Seleccionar imagen de artista -->
                                    <ui:Button Margin="0,0,0,8" HorizontalAlignment="Stretch" Padding="10,7"
                                               Command="{Binding OpenArtistGalleryCommand}"
                                               ToolTip="Ver y seleccionar fotos disponibles del artista">
                                        <Grid HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="ImageMultiple24" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Seleccionar imagen de artista" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            </StackPanel>
                                        </Grid>
                                    </ui:Button>

                                    <!-- 2.b Siguiente imagen de artista -->
                                    <ui:Button Margin="0,0,0,14" HorizontalAlignment="Stretch" Padding="10,7"
                                               Command="{Binding NowPlaying.NextArtistImageCommand}"
                                               IsEnabled="{Binding NowPlaying.UseArtistBackground}"
                                               ToolTip="Cambiar de inmediato a la siguiente foto del artista">
                                        <Grid HorizontalAlignment="Stretch">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Next24" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="Siguiente imagen de artista" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            </StackPanel>
                                        </Grid>
                                    </ui:Button>

                                    <Separator Background="#22FFFFFF" Margin="0,0,0,12" />

                                    <!-- 3. Intensidad del difuminado (Blur) -->
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Intensidad de difuminado (Blur)" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding NowPlaying.BackgroundBlurRadius, StringFormat='{}{0:F0} px'}"
                                                       HorizontalAlignment="Right" FontSize="12" Foreground="{Binding Theme.CurrentAccentBrush}" FontWeight="Bold" />
                                        </Grid>
                                        <Slider Minimum="0" Maximum="{Binding NowPlaying.MaxBlurRadius, FallbackValue=80}" SmallChange="1" LargeChange="5"
                                                Value="{Binding NowPlaying.BackgroundBlurRadius, Mode=TwoWay}"
                                                ValueChanged="OnBlurSliderValueChanged" />
                                    </StackPanel>

                                    <!-- 4. Slider de Oscurecimiento del Fondo (10% a 90%) -->
                                    <StackPanel Margin="0,0,0,12">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Oscurecimiento del fondo" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding NowPlaying.BackgroundDarkness, StringFormat='{}{0:P0}'}"
                                                       HorizontalAlignment="Right" FontSize="12" Foreground="{Binding Theme.CurrentAccentBrush}" FontWeight="Bold" />
                                        </Grid>
                                        <Slider Minimum="0.10" Maximum="{Binding NowPlaying.MaxDarkness, FallbackValue=0.90}" SmallChange="0.05" LargeChange="0.10"
                                                Value="{Binding NowPlaying.BackgroundDarkness, Mode=TwoWay}"
                                                ValueChanged="OnDarknessSliderValueChanged" />
                                    </StackPanel>

                                    <!-- 5. Slider de Duración por Foto de Artista (15s a 90s) -->
                                    <StackPanel Margin="0,0,0,14">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Duración por foto de artista" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding NowPlaying.ArtistImageIntervalSeconds, StringFormat='{}{0} s'}"
                                                       HorizontalAlignment="Right" FontSize="12" Foreground="{Binding Theme.CurrentAccentBrush}" FontWeight="Bold" />
                                        </Grid>
                                        <Slider Minimum="15" Maximum="90" SmallChange="5" LargeChange="15"
                                                IsSnapToTickEnabled="True" TickFrequency="5"
                                                Value="{Binding NowPlaying.ArtistImageIntervalSeconds, Mode=TwoWay}" />
                                    </StackPanel>

                                    <Separator Background="#22FFFFFF" Margin="0,0,0,12" />

                                    <!-- 6. Visualizador de audio (Label antes del switch, switch a la derecha) -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Visualizador de audio" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" />
                                            <TextBlock Text="Reactivo a las frecuencias" FontSize="11" Foreground="#99FFFFFF" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="#99FFFFFF">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Desactivado" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NowPlaying.IsVisualizerActive}" Value="True">
                                                                <Setter Property="Text" Value="Activado" />
                                                                <Setter Property="Foreground" Value="{Binding Theme.CurrentAccentBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ui:ToggleSwitch IsChecked="{Binding NowPlaying.IsVisualizerActive, Mode=TwoWay}"
                                                             OffContent="" OnContent=""
                                                             VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 7. Tipo de visualización -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Tipo de visualización" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding NowPlaying.SelectedVisualizerMode, Mode=TwoWay}"
                                                  SelectedValuePath="Content"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Barras de Espectro" />
                                            <ComboBoxItem Content="Onda Reactiva" />
                                            <ComboBoxItem Content="Pulso de Bajos" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- 7.b Posición del visualizador -->
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Posición del visualizador" FontSize="11" Foreground="#CCCCCC" Margin="0,0,0,4" />
                                        <ComboBox SelectedValue="{Binding NowPlaying.SelectedVisualizerPlacement, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Junto a la canción (Original)" Tag="InfoCancion" />
                                            <ComboBoxItem Content="Centro de la ventana (Más alto)" Tag="Centro" />
                                            <ComboBoxItem Content="Parte inferior derecha (Más alto)" Tag="InferiorDerecha" />
                                        </ComboBox>
                                    </StackPanel>

                                    <Separator Background="#22FFFFFF" Margin="0,0,0,10" />

                                    <!-- 8. Botón Forzar Actualización de Estilo -->
                                    <ui:Button HorizontalAlignment="Stretch" Padding="10,6"
                                               Appearance="Secondary"
                                               Command="{Binding NowPlaying.ForceUpdateStyleCommand}"
                                               ToolTip="Refrescar inmediatamente fondo, desenfoque y oscurecimiento">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="Forzar actualización de estilo" FontSize="11" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </ui:Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>

                <!-- Output Mode Badge Top Right -->
                <Border Style="{StaticResource TechBadgeStyle}" Background="#33000000" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkStarburst24" FontSize="14" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding NowPlaying.TechnicalInfo.OutputMode}" FontWeight="Bold" FontSize="11" Foreground="{Binding Theme.CurrentAccentBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- STATE A: NORMAL IMMERSIVE VIEW (QUEUE COLLAPSED)               -->
        <!-- ============================================================== -->
        <Grid x:Name="NormalImmersiveContainer" Margin="0" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="NormalImmersiveTranslate" Y="0" />
            </Grid.RenderTransform>

            <!-- ========================================================== -->
            <!-- 1. MODO ESTÁNDAR (ANCHO > 750px - Widescreen Groove Style) -->
            <!-- ========================================================== -->
            <Grid x:Name="StandardImmersiveLayout">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NowPlaying.IsCompactMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- Bottom-Left Main Info Block (Groove Music style) -->
            <Grid x:Name="TrackInfoContainer" Grid.Row="0"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Margin="48,0,0,16">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="TrackInfoTranslate" X="0" Y="0" />
                        <TranslateTransform x:Name="TrackInfoSlideX" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Album Art: fixed 210x210 with CornerRadius="14" & DropShadow & Bass Pulse -->
                <Border Grid.Column="0" Width="210" Height="210" VerticalAlignment="Bottom"
                        CornerRadius="14" ClipToBounds="True" Background="#1C1C24"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="{Binding NowPlaying.Visualizer.BassScale}"
                                        ScaleY="{Binding NowPlaying.Visualizer.BassScale}" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="45" Color="{Binding Theme.CurrentAccentColor}"
                                          Opacity="{Binding NowPlaying.Visualizer.BassGlowOpacity}" ShadowDepth="0" />
                    </Border.Effect>
                    <Image Source="{Binding NowPlaying.AlbumArt}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Track Info, Visualizer & Audio Badges Stack -->
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="28,0,0,0">
                    <!-- Interactive Song Info (Title & Artist • Album) redirects to Album -->
                    <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                        <!-- Title + Heart ♥ -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding DataContext.ViewCurrentAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Cursor="Hand" ToolTip="Ver álbum de la canción">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding NowPlaying.Title}"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           FontSize="36" FontWeight="Bold" Foreground="#FFFFFF"
                                           TextTrimming="CharacterEllipsis" MaxWidth="680">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="14" Color="#000000" Opacity="0.5" ShadowDepth="2" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Button>

                            <!-- Corazón ♥ junto al título en Reproductor Grande (State A) -->
                            <Button Command="{Binding ToggleCurrentTrackFavoriteCommand}"
                                    Cursor="Hand" Padding="0" Margin="14,4,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Marcar o quitar de Favoritos">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="HudTitleFavBdr" CornerRadius="10" Padding="8,6" Background="Transparent">
                                            <ui:SymbolIcon x:Name="HudTitleFavIcon" Symbol="Heart24" FontSize="24"
                                                           Foreground="#E0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding CurrentTrack.IsFavorite}" Value="True">
                                                <Setter TargetName="HudTitleFavIcon" Property="Filled" Value="True" />
                                                <Setter TargetName="HudTitleFavIcon" Property="Foreground" Value="#FFE81123" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NowPlaying.CurrentTrack.IsFavorite}" Value="True">
                                                <Setter TargetName="HudTitleFavIcon" Property="Filled" Value="True" />
                                                <Setter TargetName="HudTitleFavIcon" Property="Foreground" Value="#FFE81123" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HudTitleFavBdr" Property="Background" Value="#33000000" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Interactive Artist • Album -->
                        <Button Command="{Binding DataContext.ViewCurrentAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Background="Transparent" BorderThickness="0" Padding="0" Margin="0,6,0,0"
                                HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                Cursor="Hand" ToolTip="Ver álbum de la canción">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NowPlaying.Artist}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="18" Foreground="#D0FFFFFF"
                                           TextTrimming="CharacterEllipsis" MaxWidth="400">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.4" ShadowDepth="2" />
                                    </TextBlock.Effect>
                                </TextBlock>

                                <!-- Dot Separator (Visible only when Album has text or is fetching) -->
                                <TextBlock Text=" • " FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="18" Foreground="#80FFFFFF" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NowPlaying.IsFetchingAlbum}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NowPlaying.Album, Converter={StaticResource StringToVisibilityConverter}}" Value="Visible">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.4" ShadowDepth="2" />
                                    </TextBlock.Effect>
                                </TextBlock>

                                <!-- Album Fetching Indicator / Loading Ring (shows spinner alongside track title / album) -->
                                <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Foreground="{Binding Theme.CurrentAccentBrush}"
                                                 Visibility="{Binding NowPlaying.IsFetchingAlbum, Converter={StaticResource BoolToVisConverter}}" />

                                <!-- Not Found Indicator (X Icon when Last.fm search completes without finding the album) -->
                                <ui:SymbolIcon Symbol="DismissCircle24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="#99FF5555"
                                               ToolTip="No se encontró el álbum en Last.fm"
                                               Visibility="{Binding NowPlaying.IsAlbumNotFound, Converter={StaticResource BoolToVisConverter}}" />

                                <!-- Album Name -->
                                <TextBlock Text="{Binding NowPlaying.Album}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="18" Foreground="#D0FFFFFF"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.4" ShadowDepth="2" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Visualizer Display Area (Posición 1: InfoCancion - left aligned with title) -->
                    <Grid x:Name="VisualizerContainer" Height="36" Width="260" Margin="0,16,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying.SelectedVisualizerPlacement}" Value="InfoCancion">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- 1. Spectrum Bars -->
                        <ItemsControl x:Name="SpectrumItems" ItemsSource="{Binding NowPlaying.Visualizer.SpectrumBars}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Barras de Espectro">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="5" Height="{Binding}" CornerRadius="2.5" Margin="1.5,0"
                                            VerticalAlignment="Bottom"
                                            Background="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 2. Reactive Waveform -->
                        <Polyline x:Name="WaveformLine" Points="{Binding NowPlaying.Visualizer.WaveformPoints}"
                                  Stroke="{Binding Theme.CurrentAccentBrush}"
                                  StrokeThickness="2.5"
                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Polyline.Style>
                                <Style TargetType="Polyline">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Onda Reactiva">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Polyline.Style>
                        </Polyline>
                    </Grid>

                    <!-- Real-Time Audio Technical Badges -->
                    <WrapPanel x:Name="TechBadgesPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                        <Border Style="{StaticResource TechBadgeStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="SoundSource24" FontSize="13" Foreground="#FFFFFF" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding NowPlaying.TechnicalInfo.Format}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource TechBadgeStyle}">
                            <TextBlock Text="{Binding NowPlaying.TechnicalInfo.SampleRate}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" />
                        </Border>
                        <Border Style="{StaticResource TechBadgeStyle}">
                            <TextBlock Text="{Binding NowPlaying.TechnicalInfo.BitDepth}" FontWeight="SemiBold" FontSize="11" Foreground="#FFFFFF" />
                        </Border>
                        <Border Style="{StaticResource TechBadgeStyle}">
                            <TextBlock Text="{Binding NowPlaying.TechnicalInfo.Channels}" FontSize="11" Foreground="#CCFFFFFF" />
                        </Border>
                        <Border Style="{StaticResource TechBadgeStyle}" Background="#22000000">
                            <TextBlock Text="{Binding NowPlaying.TechnicalInfo.Bitrate}" FontSize="11" Foreground="#BBFFFFFF" />
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- ============================================================== -->
            <!-- POSICIÓN 2: CENTRO DE LA VENTANA (MÁS ALTO, HASTA 120PX)       -->
            <!-- ============================================================== -->
            <Grid x:Name="VisualizerCenterContainer" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Height="130" Margin="0,0,0,40"
                  IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="VisualizerCenterTranslate" X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NowPlaying.SelectedVisualizerPlacement}" Value="Centro">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Spectrum Bars Center -->
                <ItemsControl ItemsSource="{Binding NowPlaying.Visualizer.SpectrumBars}"
                              HorizontalAlignment="Center" VerticalAlignment="Bottom">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Barras de Espectro">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="7" Height="{Binding}" CornerRadius="3.5" Margin="2,0"
                                    VerticalAlignment="Bottom"
                                    Background="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Reactive Waveform Center -->
                <Polyline Points="{Binding NowPlaying.Visualizer.WaveformPoints}"
                          Stroke="{Binding Theme.CurrentAccentBrush}"
                          StrokeThickness="3"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Polyline.Style>
                        <Style TargetType="Polyline">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Onda Reactiva">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Polyline.Style>
                </Polyline>
            </Grid>

            <!-- ============================================================== -->
            <!-- POSICIÓN 3: INFERIOR DERECHA (ALINEADA A INFO CANCIÓN, 100PX)  -->
            <!-- ============================================================== -->
            <Grid x:Name="VisualizerRightContainer" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="110" Margin="0,0,48,16"
                  IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="VisualizerRightTranslate" X="0" Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NowPlaying.SelectedVisualizerPlacement}" Value="InferiorDerecha">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <!-- Spectrum Bars Right -->
                <ItemsControl ItemsSource="{Binding NowPlaying.Visualizer.SpectrumBars}"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Barras de Espectro">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="6" Height="{Binding}" CornerRadius="3" Margin="1.8,0"
                                    VerticalAlignment="Bottom"
                                    Background="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Reactive Waveform Right -->
                <Polyline Points="{Binding NowPlaying.Visualizer.WaveformPoints}"
                          Stroke="{Binding Theme.CurrentAccentBrush}"
                          StrokeThickness="2.8"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Polyline.Style>
                        <Style TargetType="Polyline">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Onda Reactiva">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Polyline.Style>
                </Polyline>
            </Grid>

            <!-- Bottom Transport & Seekbar (HUD) -->
            <StackPanel x:Name="BottomRowPanel" Grid.Row="1" VerticalAlignment="Bottom" Margin="48,0,48,20">
                <!-- AUTO-HIDE HUD CONTROLS: Seekbar & Transport/Volume Bar -->
                <StackPanel x:Name="BottomHudControlsContainer">
                    <!-- Seekbar with Wide Single-Click Hitbox -->
                    <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding NowPlaying.CurrentTimeText}" FontSize="12" FontWeight="SemiBold" Foreground="#B0FFFFFF" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="Transparent" Padding="0,8" Cursor="Hand"
                            PreviewMouseLeftButtonDown="OnSeekContainerMouseDown"
                            PreviewMouseMove="OnSeekContainerMouseMove"
                            PreviewMouseLeftButtonUp="OnSeekContainerMouseUp">
                        <Slider x:Name="NowPlayingSeekSlider" Margin="10,0"
                                Minimum="0" Maximum="{Binding NowPlaying.TotalDurationSeconds}"
                                Value="{Binding NowPlaying.CurrentPositionSeconds, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                PreviewMouseLeftButtonDown="OnSeekSliderPreviewMouseDown"
                                PreviewMouseMove="OnSeekSliderPreviewMouseMove"
                                PreviewMouseLeftButtonUp="OnSeekSliderPreviewMouseUp"
                                ValueChanged="OnSeekSliderValueChanged" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding NowPlaying.TotalTimeText}" FontSize="12" FontWeight="SemiBold" Foreground="#B0FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- Controls Bar -->
                <Grid Height="58">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Transport -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <!-- Shuffle Button -->
                        <Button Command="{Binding NowPlaying.ToggleShuffleCommand}" Cursor="Hand" Padding="0" Margin="0,0,4,0" ToolTip="Reproducción aleatoria">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="8,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="ArrowShuffle24" FontSize="18" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ui:Button Appearance="Transparent" Padding="9" Margin="0,0,4,0" Command="{Binding NowPlaying.PreviousCommand}">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="20" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <Button Style="{StaticResource CircularPlayPauseButtonStyle}"
                                Command="{Binding NowPlaying.PlayPauseCommand}"
                                Margin="4,0,8,0" />

                        <ui:Button Appearance="Transparent" Padding="9" Margin="0,0,4,0" Command="{Binding NowPlaying.NextCommand}">
                            <ui:SymbolIcon Symbol="Next24" FontSize="20" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <!-- Repeat Button -->
                        <Button Command="{Binding NowPlaying.CycleRepeatCommand}" Cursor="Hand" Padding="0" Margin="0,0,12,0" ToolTip="Modo de repetición">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="8,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="{Binding NowPlaying.RepeatMode, Converter={StaticResource RepeatModeToSymbolConverter}}" FontSize="18" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="All">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="One">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Center: Expand Queue Arrow (^) -->
                    <ui:Button Grid.Column="1" Appearance="Transparent" Padding="14,8"
                               Command="{Binding ToggleNowPlayingQueueCommand}"
                               ToolTip="Desplegar Cola Actual (Up Next)">
                        <ui:SymbolIcon Symbol="ChevronUp24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" />
                    </ui:Button>

                    <!-- Right: Extra Controls (Mute Button, Volume Slider, DAC Selector, Fullscreen, More Options) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Volume Mute Button -->
                        <Button Command="{Binding NowPlaying.ToggleMuteCommand}" Cursor="Hand" Width="36" Height="36" Padding="0" ToolTip="Silenciar / Activar sonido">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="6,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" FontSize="17" Foreground="#D9FFFFFF" HorizontalAlignment="Center">
                                                <ui:SymbolIcon.Symbol>
                                                    <MultiBinding Converter="{StaticResource VolumeToSymbolConverter}">
                                                        <Binding Path="NowPlaying.Volume" />
                                                        <Binding Path="NowPlaying.IsMuted" />
                                                    </MultiBinding>
                                                </ui:SymbolIcon.Symbol>
                                            </ui:SymbolIcon>
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="#FF4C4C" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.IsMuted}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FF6B6B" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Volume Slider with Wide Single-Click Hitbox -->
                        <Border Background="Transparent" Padding="0,8" Margin="4,0,12,0" Cursor="Hand">
                            <Slider Width="110" Minimum="0" Maximum="1"
                                    IsMoveToPointEnabled="True"
                                    Value="{Binding NowPlaying.Volume, Mode=TwoWay}"
                                    PreviewMouseLeftButtonDown="OnVolumeSliderPreviewMouseDown"
                                    PreviewMouseMove="OnVolumeSliderPreviewMouseMove"
                                    PreviewMouseLeftButtonUp="OnVolumeSliderPreviewMouseUp"
                                    VerticalAlignment="Center" />
                        </Border>

                        <!-- DAC Output Selector Button -->
                        <Button Command="{Binding ToggleDeviceSelectorCommand}" Cursor="Hand" Padding="0" Margin="0,0,6,0" ToolTip="Dispositivo de salida / WASAPI Exclusive Bit-Perfect">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="7,5" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Hi-Fi Speaker Minicomponente / Bafle Vector Icon -->
                                            <Grid Width="16" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="14" Height="17.5" RadiusX="2.5" RadiusY="2.5" Stroke="#D9FFFFFF" StrokeThickness="1.5" Fill="#1AFFFFFF" />
                                                <Ellipse Width="3.5" Height="3.5" Fill="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3.5,0,0" />
                                                <Ellipse Width="7.5" Height="7.5" Stroke="#D9FFFFFF" StrokeThickness="1.2" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2.5" />
                                                <Ellipse Width="2.5" Height="2.5" Fill="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                            </Grid>
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDeviceSelectorOpen}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Fullscreen Button -->
                        <ui:Button Appearance="Transparent" Padding="8" Margin="4,0,4,0"
                                   Command="{Binding ToggleFullscreenCommand}"
                                   ToolTip="Pantalla completa (F11)">
                            <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="18" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <!-- More Options (...) Button (Opens on Left or Right Click) -->
                        <ui:Button Appearance="Transparent" Padding="8"
                                   Click="OnMoreOptionsButtonClick"
                                   ToolTip="Más opciones y Ecualizador">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Lista actual"
                                              Command="{Binding OpenCurrentQueueCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Añadir a lista de reproducción" SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="List24" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="+ Nueva lista de reproducción..." />
                                    </MenuItem>
                                    <MenuItem Header="Marcar / Desmarcar Favorito ♥"
                                              Command="{Binding ToggleCurrentTrackFavoriteCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Heart24" Foreground="#E81123" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ver álbum"
                                              Command="{Binding ViewCurrentAlbumCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Album24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ver artista"
                                              Command="{Binding ViewCurrentArtistCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Person24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Añadir pistas relacionadas"
                                              Command="{Binding AddRelatedTracksCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Sparkle24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Ecualizador"
                                              Command="{Binding ToggleEqualizerCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Options24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Galería de fotos del artista"
                                              Command="{Binding OpenArtistGalleryCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="ImageMultiple24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Parar / Detener música"
                                              Command="{Binding StopMusicCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Stop24" Foreground="#E81123" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" Foreground="#E0FFFFFF" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </StackPanel>
            </Grid>

            <!-- ========================================================== -->
            <!-- 2. MODO COMPACTO MÓVIL (ANCHO <= 750px)                    -->
            <!-- ========================================================== -->
            <Grid x:Name="CompactMobileLayout" Margin="24,6,24,14">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NowPlaying.IsCompactMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <!-- Fila 0: Carátula centrada -->
                    <RowDefinition Height="*" MinHeight="170" />
                    <!-- Fila 1: Info pista + Corazón + Visualizador detrás -->
                    <RowDefinition Height="Auto" />
                    <!-- Fila 2: Progreso de pista (Seekbar) -->
                    <RowDefinition Height="Auto" />
                    <!-- Fila 3: Controles de transporte (Atrás, Play/Pause, Siguiente) -->
                    <RowDefinition Height="Auto" />
                    <!-- Fila 4: Utilidades (Volumen, DAC, Pantalla completa, Tres puntos) -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 0. CARÁTULA CENTRADA (Borde suave, sombra y pulso de bajos) -->
                <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,10">
                    <Border MaxWidth="300" MaxHeight="300" MinWidth="170" MinHeight="170"
                            CornerRadius="18" ClipToBounds="True" Background="#1C1C24"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="{Binding NowPlaying.Visualizer.BassScale}"
                                            ScaleY="{Binding NowPlaying.Visualizer.BassScale}" />
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" Color="{Binding Theme.CurrentAccentColor}"
                                              Opacity="{Binding NowPlaying.Visualizer.BassGlowOpacity}" ShadowDepth="0" />
                        </Border.Effect>
                        <Image Source="{Binding NowPlaying.AlbumArt}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>

                <!-- 1. INFO DE PISTA + CORAZÓN CON VISUALIZADOR POR DETRÁS -->
                <Grid Grid.Row="1" Margin="0,4,0,6">
                    <!-- Capa 0: Visualizador reactivo de fondo (Onda o Espectro) -->
                    <Grid Panel.ZIndex="0" VerticalAlignment="Center" Height="50" IsHitTestVisible="False">
                        <!-- Onda Reactiva -->
                        <Polyline Points="{Binding NowPlaying.Visualizer.WaveformPoints}"
                                  Stroke="{Binding Theme.CurrentAccentBrush}"
                                  StrokeThickness="2.5"
                                  Opacity="0.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Polyline.Style>
                                <Style TargetType="Polyline">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Onda Reactiva">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Polyline.Style>
                        </Polyline>

                        <!-- Barras de Espectro -->
                        <ItemsControl ItemsSource="{Binding NowPlaying.Visualizer.SpectrumBars}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Opacity="0.45">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.Visualizer.SelectedVisualizerMode}" Value="Barras de Espectro">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="6" Height="{Binding}" CornerRadius="3" Margin="2,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Capa 1: Información de pista (con marquesina si es largo) y botón de corazón fijo -->
                    <Grid Panel.ZIndex="1" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Título y artista con scroll/marquesina si excede -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" ClipToBounds="True">
                            <TextBlock Text="{Binding NowPlaying.Artist}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#000000" Opacity="0.6" ShadowDepth="1" />
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Viewport de título con marquesina suave -->
                            <ScrollViewer x:Name="CompactTitleViewport"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          IsHitTestVisible="False"
                                          ClipToBounds="True"
                                          SizeChanged="OnCompactTitleSizeChanged"
                                          Margin="0,3,0,0">
                                <TextBlock x:Name="CompactTitleTextBlock"
                                           Text="{Binding NowPlaying.Title}"
                                           FontFamily="Segoe UI Variable Text, Segoe UI"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="#D8FFFFFF"
                                           SizeChanged="OnCompactTitleSizeChanged">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="CompactTitleTranslate" X="0" />
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="6" Color="#000000" Opacity="0.5" ShadowDepth="1" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Botón de Favorito (Corazón ♥) NUNCA se oculta ni sale de pantalla -->
                        <Button Grid.Column="1"
                                Command="{Binding ToggleCurrentTrackFavoriteCommand}"
                                Cursor="Hand" Padding="0" Margin="0"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                ToolTip="Marcar o quitar de Favoritos">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CompactFavBdr" CornerRadius="12" Padding="8" Background="#26000000">
                                        <ui:SymbolIcon x:Name="CompactFavIcon" Symbol="Heart24" FontSize="24"
                                                       Foreground="#E0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTrack.IsFavorite}" Value="True">
                                            <Setter TargetName="CompactFavIcon" Property="Filled" Value="True" />
                                            <Setter TargetName="CompactFavIcon" Property="Foreground" Value="#FFE81123" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.CurrentTrack.IsFavorite}" Value="True">
                                            <Setter TargetName="CompactFavIcon" Property="Filled" Value="True" />
                                            <Setter TargetName="CompactFavIcon" Property="Foreground" Value="#FFE81123" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CompactFavBdr" Property="Background" Value="#44000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- 2. PROGRESO DE LA PISTA (SEEKBAR) -->
                <Grid Grid.Row="2" Margin="0,6,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding NowPlaying.CurrentTimeText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#B0FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Border Grid.Column="1" Background="Transparent" Padding="0,6" Cursor="Hand"
                            PreviewMouseLeftButtonDown="OnSeekContainerMouseDown"
                            PreviewMouseMove="OnSeekContainerMouseMove"
                            PreviewMouseLeftButtonUp="OnSeekContainerMouseUp">
                        <Slider Margin="6,0"
                                Minimum="0" Maximum="{Binding NowPlaying.TotalDurationSeconds}"
                                Value="{Binding NowPlaying.CurrentPositionSeconds, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                PreviewMouseLeftButtonDown="OnSeekSliderPreviewMouseDown"
                                PreviewMouseMove="OnSeekSliderPreviewMouseMove"
                                PreviewMouseLeftButtonUp="OnSeekSliderPreviewMouseUp"
                                ValueChanged="OnSeekSliderValueChanged" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding NowPlaying.TotalTimeText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#B0FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <!-- 3. CONTROLES DE TRANSPORTE (ATRÁS, PLAY/PAUSA, SIGUIENTE) -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,10">
                    <!-- Aleatorio (Shuffle) -->
                    <Button Command="{Binding NowPlaying.ToggleShuffleCommand}" Cursor="Hand" Padding="0" Margin="0,0,12,0" ToolTip="Reproducción aleatoria">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" CornerRadius="8" Padding="8,5" Background="Transparent">
                                    <ui:SymbolIcon x:Name="BtnIcon" Symbol="ArrowShuffle24" FontSize="18" Foreground="#D9FFFFFF" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying.IsShuffleEnabled}" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                        <Setter TargetName="BtnIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Atrás (Anterior) -->
                    <ui:Button Appearance="Transparent" Padding="10" Margin="0,0,10,0" Command="{Binding NowPlaying.PreviousCommand}" ToolTip="Anterior">
                        <ui:SymbolIcon Symbol="Previous24" FontSize="24" Foreground="#E0FFFFFF" />
                    </ui:Button>

                    <!-- Play / Pausa (Circular central prominente) -->
                    <Button Style="{StaticResource CircularPlayPauseButtonStyle}"
                            Command="{Binding NowPlaying.PlayPauseCommand}"
                            Width="62" Height="62"
                            Margin="6,0" />

                    <!-- Siguiente -->
                    <ui:Button Appearance="Transparent" Padding="10" Margin="10,0,0,0" Command="{Binding NowPlaying.NextCommand}" ToolTip="Siguiente">
                        <ui:SymbolIcon Symbol="Next24" FontSize="24" Foreground="#E0FFFFFF" />
                    </ui:Button>

                    <!-- Repetir (Repeat) -->
                    <Button Command="{Binding NowPlaying.CycleRepeatCommand}" Cursor="Hand" Padding="0" Margin="12,0,0,0" ToolTip="Modo de repetición">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" CornerRadius="8" Padding="8,5" Background="Transparent">
                                    <ui:SymbolIcon x:Name="BtnIcon" Symbol="{Binding NowPlaying.RepeatMode, Converter={StaticResource RepeatModeToSymbolConverter}}" FontSize="18" Foreground="#D9FFFFFF" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="All">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                        <Setter TargetName="BtnIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="One">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                        <Setter TargetName="BtnIcon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- 4. FILA DE UTILIDADES (VOLUMEN, FUENTE DE AUDIO, PANTALLA COMPLETA, COLA, TRES PUNTITOS) -->
                <Grid Grid.Row="4" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Volumen / Silenciar -->
                        <Button Command="{Binding NowPlaying.ToggleMuteCommand}" Cursor="Hand" Width="40" Height="40" Padding="0" Margin="6,0" ToolTip="Volumen">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="6,5" Background="Transparent">
                                        <ui:SymbolIcon x:Name="BtnIcon" FontSize="18" Foreground="#D9FFFFFF" HorizontalAlignment="Center">
                                            <ui:SymbolIcon.Symbol>
                                                <MultiBinding Converter="{StaticResource VolumeToSymbolConverter}">
                                                    <Binding Path="NowPlaying.Volume" />
                                                    <Binding Path="NowPlaying.IsMuted" />
                                                </MultiBinding>
                                            </ui:SymbolIcon.Symbol>
                                        </ui:SymbolIcon>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Fuente de audio / DAC -->
                        <Button Command="{Binding ToggleDeviceSelectorCommand}" Cursor="Hand" Width="40" Height="40" Padding="0" Margin="6,0" ToolTip="Fuente de audio / DAC">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="7,5" Background="Transparent">
                                        <Grid Width="16" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Rectangle Width="14" Height="17.5" RadiusX="2.5" RadiusY="2.5" Stroke="#D9FFFFFF" StrokeThickness="1.5" Fill="#1AFFFFFF" />
                                            <Ellipse Width="3.5" Height="3.5" Fill="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3.5,0,0" />
                                            <Ellipse Width="7.5" Height="7.5" Stroke="#D9FFFFFF" StrokeThickness="1.2" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2.5" />
                                            <Ellipse Width="2.5" Height="2.5" Fill="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Cola actual (Lista de reproducción / Up Next) con flecha hacia arriba y área de clic más ancha -->
                        <ui:Button Appearance="Transparent" Width="70" Height="40" Padding="0" Margin="4,0"
                                   Command="{Binding ToggleNowPlayingQueueCommand}"
                                   ToolTip="Lista actual / Desplegar Cola">
                            <ui:SymbolIcon Symbol="ChevronUp24" FontSize="22" Foreground="#FFFFFF" />
                        </ui:Button>

                        <!-- Pantalla completa -->
                        <ui:Button Appearance="Transparent" Width="40" Height="40" Padding="0" Margin="6,0"
                                   Command="{Binding ToggleFullscreenCommand}"
                                   ToolTip="Pantalla completa (F11)">
                            <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="18" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <!-- Tres puntitos (Más opciones) -->
                        <ui:Button Appearance="Transparent" Width="40" Height="40" Padding="0" Margin="6,0"
                                   Click="OnMoreOptionsButtonClick"
                                   ToolTip="Más opciones">
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="18" Foreground="#E0FFFFFF" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- QUEUE ACTIVE BACKGROUND BACKDROP (90% OPACITY FADE-IN)         -->
        <!-- ============================================================== -->
        <Border x:Name="QueueBackdropOverlay" Background="#0A0B10" IsHitTestVisible="False"
                Visibility="Collapsed" Opacity="0.0" />

        <!-- ============================================================== -->
        <!-- STATE B: QUEUE EXPANDED VIEW (UP NEXT 4-COLUMN LAYOUT)        -->
        <!-- ============================================================== -->
        <Grid x:Name="QueueExpandedContainer" Margin="48,46,48,20" RenderTransformOrigin="0.5,0.5"
              Visibility="Collapsed" Opacity="0.0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="QueueTranslate" Y="0" />
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Shifted Track Info & Full Controls -->
                <RowDefinition Height="Auto" /> <!-- Center Down Arrow (v) -->
                <RowDefinition Height="*" />    <!-- 4-Column Clean Queue List -->
            </Grid.RowDefinitions>

            <!-- Top Shifted Track Info Bar, Seekbar & Full Transport Controls -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Compact Album Art & Titles -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True" Background="#1C1C24" Margin="0,0,16,0">
                            <Image Source="{Binding NowPlaying.AlbumArt}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="360">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding DataContext.ViewCurrentAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Background="Transparent" BorderThickness="0" Padding="0"
                                        HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                        Cursor="Hand" ToolTip="Ver álbum de la canción">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="{Binding NowPlaying.Title}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                </Button>

                                <!-- Corazón ♥ junto al título en State B -->
                                <Button Command="{Binding ToggleCurrentTrackFavoriteCommand}"
                                        Cursor="Hand" Padding="0" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Marcar o quitar de Favoritos">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="StateBTitleFavBdr" CornerRadius="6" Padding="6,4" Background="Transparent">
                                                <ui:SymbolIcon x:Name="StateBTitleFavIcon" Symbol="Heart24" FontSize="16"
                                                               Foreground="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding CurrentTrack.IsFavorite}" Value="True">
                                                    <Setter TargetName="StateBTitleFavIcon" Property="Filled" Value="True" />
                                                    <Setter TargetName="StateBTitleFavIcon" Property="Foreground" Value="#FFE81123" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NowPlaying.CurrentTrack.IsFavorite}" Value="True">
                                                    <Setter TargetName="StateBTitleFavIcon" Property="Filled" Value="True" />
                                                    <Setter TargetName="StateBTitleFavIcon" Property="Foreground" Value="#FFE81123" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="StateBTitleFavBdr" Property="Background" Value="#33000000" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>

                            <Button Command="{Binding DataContext.ViewCurrentAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0"
                                    HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                    Cursor="Hand" ToolTip="Ver álbum de la canción">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="{Binding NowPlaying.ArtistAndAlbum}" FontSize="13" Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Full Transport Controls Center-Right in State B -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Shuffle Button -->
                        <Button Command="{Binding NowPlaying.ToggleShuffleCommand}" Cursor="Hand" Padding="0" Margin="0,0,3,0" ToolTip="Reproducción aleatoria">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="7,4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="ArrowShuffle24" FontSize="16" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.IsShuffleEnabled}" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <ui:Button Appearance="Transparent" Padding="7" Command="{Binding NowPlaying.PreviousCommand}">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="18" Foreground="#FFFFFF" />
                        </ui:Button>
                        <Button Style="{StaticResource CircularPlayPauseButtonStyle}"
                                Command="{Binding NowPlaying.PlayPauseCommand}"
                                Margin="4,0" />
                        <ui:Button Appearance="Transparent" Padding="7" Command="{Binding NowPlaying.NextCommand}">
                            <ui:SymbolIcon Symbol="Next24" FontSize="18" Foreground="#FFFFFF" />
                        </ui:Button>

                        <!-- Repeat Button -->
                        <Button Command="{Binding NowPlaying.CycleRepeatCommand}" Cursor="Hand" Padding="0" Margin="3,0,6,0" ToolTip="Modo de repetición">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnBorder" CornerRadius="8" Padding="7,4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ui:SymbolIcon x:Name="BtnIcon" Symbol="{Binding NowPlaying.RepeatMode, Converter={StaticResource RepeatModeToSymbolConverter}}" FontSize="16" Foreground="#D9FFFFFF" HorizontalAlignment="Center" />
                                            <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="All">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NowPlaying.RepeatMode}" Value="One">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                            <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                            <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                                            <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Volume Controls Group (Mute Button + Slider): aísla la rueda del mouse exclusivamente para el volumen e invalida la cola -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    PreviewMouseWheel="OnVolumeAreaPreviewMouseWheel">
                            <!-- Volume Mute Button -->
                            <Button Command="{Binding NowPlaying.ToggleMuteCommand}" Cursor="Hand" Width="32" Height="32" Padding="0" ToolTip="Silenciar / Activar sonido">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" CornerRadius="8" Padding="5,4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ui:SymbolIcon x:Name="BtnIcon" FontSize="15" Foreground="#D9FFFFFF" HorizontalAlignment="Center">
                                                    <ui:SymbolIcon.Symbol>
                                                        <MultiBinding Converter="{StaticResource VolumeToSymbolConverter}">
                                                            <Binding Path="NowPlaying.Volume" />
                                                            <Binding Path="NowPlaying.IsMuted" />
                                                        </MultiBinding>
                                                    </ui:SymbolIcon.Symbol>
                                                </ui:SymbolIcon>
                                                <Ellipse x:Name="ActiveDot" Width="4" Height="4" Fill="#FF4C4C" Margin="0,2,0,0" Visibility="Collapsed" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NowPlaying.IsMuted}" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#CC121216" />
                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#66FFFFFF" />
                                                <Setter TargetName="BtnIcon" Property="Foreground" Value="#FF6B6B" />
                                                <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BtnBorder" Property="Background" Value="#33000000" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Volume Slider with Wide Hitbox -->
                            <Border Background="Transparent" Padding="0,8" Margin="2,0,8,0" Cursor="Hand">
                                <Slider Width="90" Minimum="0" Maximum="1"
                                        IsMoveToPointEnabled="True"
                                        Value="{Binding NowPlaying.Volume, Mode=TwoWay}"
                                        PreviewMouseLeftButtonDown="OnVolumeSliderPreviewMouseDown"
                                        PreviewMouseMove="OnVolumeSliderPreviewMouseMove"
                                        PreviewMouseLeftButtonUp="OnVolumeSliderPreviewMouseUp"
                                        VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Fullscreen Button -->
                        <ui:Button Appearance="Transparent" Padding="7" Margin="0,0,4,0"
                                   Command="{Binding ToggleFullscreenCommand}"
                                   ToolTip="Pantalla completa (F11)">
                            <ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="16" Foreground="#E0FFFFFF" />
                        </ui:Button>

                        <!-- More Options (...) Button -->
                        <ui:Button Appearance="Transparent" Padding="7"
                                   Click="OnMoreOptionsButtonClick"
                                   ToolTip="Más opciones y Ecualizador">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Lista actual"
                                              Command="{Binding OpenCurrentQueueCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Añadir a lista de reproducción" SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="List24" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="+ Nueva lista de reproducción..." />
                                    </MenuItem>
                                    <MenuItem Header="Marcar / Desmarcar Favorito ♥"
                                              Command="{Binding ToggleCurrentTrackFavoriteCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Heart24" Foreground="#E81123" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ver álbum"
                                              Command="{Binding ViewCurrentAlbumCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Album24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Ver artista"
                                              Command="{Binding ViewCurrentArtistCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Person24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Añadir pistas relacionadas"
                                              Command="{Binding AddRelatedTracksCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Sparkle24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Ecualizador"
                                              Command="{Binding ToggleEqualizerCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Options24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Parar / Detener música"
                                              Command="{Binding StopMusicCommand, Source={x:Static vm:MainViewModel.Instance}}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Stop24" Foreground="#E81123" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                            <ui:SymbolIcon Symbol="MoreHorizontal24" FontSize="16" Foreground="#E0FFFFFF" />
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- State B Seekbar with Wide Single-Click Hitbox -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding NowPlaying.CurrentTimeText}" FontSize="11" FontWeight="SemiBold" Foreground="#B0FFFFFF" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="Transparent" Padding="0,6" Cursor="Hand">
                        <Slider Margin="8,0"
                                Minimum="0" Maximum="{Binding NowPlaying.TotalDurationSeconds}"
                                Value="{Binding NowPlaying.CurrentPositionSeconds, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                PreviewMouseLeftButtonDown="OnSeekSliderPreviewMouseDown"
                                PreviewMouseMove="OnSeekSliderPreviewMouseMove"
                                PreviewMouseLeftButtonUp="OnSeekSliderPreviewMouseUp"
                                ValueChanged="OnSeekSliderValueChanged" />
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding NowPlaying.TotalTimeText}" FontSize="11" FontWeight="SemiBold" Foreground="#B0FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>

            <!-- Center Down Arrow (v) to collapse back -->
            <Grid Grid.Row="1" Margin="0,2,0,8">
                <ui:Button Appearance="Transparent" Padding="14,4" HorizontalAlignment="Center"
                           Command="{Binding ToggleNowPlayingQueueCommand}"
                           ToolTip="Ocultar cola de reproducción">
                    <StackPanel Orientation="Vertical">
                        <ui:SymbolIcon Symbol="ChevronDown24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" />
                        <TextBlock Text="Ocultar cola" FontSize="10" FontWeight="SemiBold" Foreground="#99FFFFFF" HorizontalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <!-- Locate active track -->
                <ui:Button Appearance="Transparent" Padding="10,8" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Click="OnLocateCurrentTrackClick"
                           ToolTip="Ir a la canción actual">
                    <ui:SymbolIcon Symbol="Target24" FontSize="20" Foreground="{Binding Theme.CurrentAccentBrush}" />
                </ui:Button>
            </Grid>

            <!-- 4-Column Clean Queue List (Full Width, No heavy borders) -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Column Headers -->
                    <RowDefinition Height="*" />    <!-- Rows -->
                </Grid.RowDefinitions>

                <!-- 4 Columns Header -->
                <Grid Grid.Row="0" Margin="16,0,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" /> <!-- Canción -->
                        <ColumnDefinition Width="1.5*" /> <!-- Artista -->
                        <ColumnDefinition Width="1.8*" /> <!-- Álbum -->
                        <ColumnDefinition Width="80" />   <!-- Duración -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CANCIÓN" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" />
                    <TextBlock Grid.Column="1" Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" />
                    <TextBlock Grid.Column="2" Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" />
                    <TextBlock Grid.Column="3" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" HorizontalAlignment="Right" />
                </Grid>

                <!-- Queue ListView with Full Right-Click ContextMenu -->
                <ListView x:Name="QueueListView" Grid.Row="1" ItemsSource="{Binding Queue.Queue}"
                          SelectedItem="{Binding Queue.SelectedTrack, Mode=TwoWay}"
                          Background="Transparent" BorderThickness="0"
                          AlternationCount="2"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="OnQueueItemDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="OnQueueItemDoubleClick" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu Opened="OnTrackContextMenuOpened">
                                        <MenuItem Header="Reproducir ahora"
                                                  Command="{Binding PlayTrackNowCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Play24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Reproducir siguiente (Play Next)"
                                                  Command="{Binding PlayNextCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="ArrowRight24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Ir a artista"
                                                  Command="{Binding NavigateToArtistCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding Artist}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Person24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Ir a álbum"
                                                  Command="{Binding NavigateToAlbumCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding Album}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Album24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Agregar a lista de reproducción" SubmenuOpened="OnAddToPlaylistSubmenuOpened">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="List24" />
                                            </MenuItem.Icon>
                                            <MenuItem Header="+ Nueva lista de reproducción..." />
                                        </MenuItem>
                                        <MenuItem Header="Marcar / Desmarcar Favorito ♥"
                                                  Command="{Binding ToggleFavoriteCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Heart24" Foreground="#E81123" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Ver información de la pista"
                                                  Command="{Binding ShowTrackPropertiesCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Info24" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Eliminar pista"
                                                  Command="{Binding DeleteTrackCommand, Source={x:Static vm:MainViewModel.Instance}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" Foreground="#E81123" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Margin="0,1" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#15FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#25FFFFFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#10FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Track}">
                            <Border CornerRadius="6" Padding="16,10" Margin="0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Background" Value="#2A00D26A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.5*" /> <!-- Icon + Title -->
                                        <ColumnDefinition Width="1.5*" /> <!-- Artist -->
                                        <ColumnDefinition Width="1.8*" /> <!-- Album -->
                                        <ColumnDefinition Width="95" />   <!-- Favorite + Duration -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 1: Equalizer Icon + Song Title -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Active Equalizer Bars or Pause indicator Icon -->
                                        <ui:SymbolIcon Symbol="Speaker224" FontSize="15" Margin="0,0,10,0"
                                                       Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisConverter}}"
                                                       Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        <ui:SymbolIcon Symbol="Pause24" FontSize="15" Margin="0,0,10,0"
                                                       Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsCurrent}" Value="True" />
                                                                <Condition Binding="{Binding IsPlaying}" Value="False" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>

                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#E0FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Col 2: Artist -->
                                    <TextBlock Grid.Column="1" Text="{Binding Artist}" FontSize="12"
                                               Foreground="#B0FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <!-- Col 3: Album -->
                                    <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="12"
                                               Foreground="#88FFFFFF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />

                                    <!-- Col 4: Favorite ♥ & Duration -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Width="28" Height="28" Padding="0" Margin="0,0,8,0"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Agregar o quitar de Favoritos"
                                                Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleFavoriteCommand}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="FavBdr" CornerRadius="6" Background="Transparent">
                                                        <ui:SymbolIcon x:Name="FavIcon" Symbol="Heart24" FontSize="14"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="#88FFFFFF" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="FavBdr" Property="Background" Value="#22FFFFFF" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter TargetName="FavIcon" Property="Filled" Value="True" />
                                                            <Setter TargetName="FavIcon" Property="Foreground" Value="#FFE81123" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <TextBlock Text="{Binding DurationFormatted}" FontSize="12"
                                                   Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
