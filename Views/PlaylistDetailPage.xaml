<UserControl x:Class="BenyComes.Views.PlaylistDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:BenyComes.Models"
             xmlns:vm="clr-namespace:BenyComes.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1000">

    <ScrollViewer x:Name="PlaylistScrollViewer" VerticalScrollBarVisibility="Auto" Margin="32,20,32,20">
        <StackPanel Margin="0,0,0,30">

            <!-- ============================================================== -->
            <!-- 1. PLAYLIST HEADER                                             -->
            <!-- ============================================================== -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Big Playlist Cover Art Card (160x160) -->
                <Border Grid.Column="0" Width="160" Height="160" CornerRadius="14"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <!-- Fallback Music Note Icon -->
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="64"
                                       Foreground="{Binding Theme.CurrentAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                        <!-- Custom / Collage Cover Image -->
                        <Image Source="{Binding SelectedPlaylistForDetail.CoverImage}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>

                <!-- Info & Primary Actions -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock Text="LISTA DE REPRODUCCIÓN" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextTertiaryBrush}" />

                    <TextBlock Text="{Binding SelectedPlaylistForDetail.Name}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,2" />

                    <!-- Optional Description -->
                    <TextBlock Text="{Binding SelectedPlaylistForDetail.Description}"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="650" Margin="0,2,0,4"
                               Visibility="{Binding SelectedPlaylistForDetail.Description, Converter={StaticResource StringToVisibilityConverter}}" />

                    <!-- Track Count & Meta -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="{Binding SelectedPlaylistForDetail.TrackCount, StringFormat='{}{0} canciones'}"
                                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text=" • " FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0" />
                        <TextBlock Text="{Binding SelectedPlaylistForDetail.CreatedAtFormatted, StringFormat='Creada el {0}'}"
                                   FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal">
                        <!-- Play Playlist Button -->
                        <ui:Button Appearance="Primary" Padding="18,9" Margin="0,0,10,0"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding PlayAllPlaylistCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" FontSize="16" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Reproducir" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="13" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Edit Playlist Button -->
                        <ui:Button Appearance="Secondary" Padding="14,9" Margin="0,0,10,0"
                                   Command="{Binding OpenEditPlaylistDialogCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Edit24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Editar lista" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Export Playlist Button -->
                        <ui:Button Appearance="Secondary" Padding="14,9" Margin="0,0,10,0"
                                   ToolTip="Exportar como .m3u8 / .m3u"
                                   Command="{Binding ExportPlaylistCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Exportar lista" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Delete Playlist Button -->
                        <ui:Button Appearance="Danger" Padding="14,9"
                                   Command="{Binding DeletePlaylistWithNavigationCommand}"
                                   CommandParameter="{Binding SelectedPlaylistForDetail}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="15" Margin="0,0,6,0" />
                                <TextBlock Text="Eliminar Lista" FontSize="13" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============================================================== -->
            <!-- 2. COLUMN HEADERS                                              -->
            <!-- ============================================================== -->
            <Grid Margin="12,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />  <!-- Play / Hover # -->
                    <ColumnDefinition Width="46" />  <!-- Cover Thumbnail -->
                    <ColumnDefinition Width="3.5*" /> <!-- Title -->
                    <ColumnDefinition Width="2.5*" /> <!-- Artist -->
                    <ColumnDefinition Width="2.5*" /> <!-- Album -->
                    <ColumnDefinition Width="90" />  <!-- Reorder / Remove -->
                    <ColumnDefinition Width="65" />  <!-- Duration -->
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="" />
                <TextBlock Grid.Column="2" Text="TÍTULO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,0,0,0" />
                <TextBlock Grid.Column="3" Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Grid.Column="4" Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Grid.Column="5" Text="ORDEN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="6" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" />
            </Grid>

            <!-- ============================================================== -->
            <!-- 3. TRACKS LISTVIEW                                             -->
            <!-- ============================================================== -->
            <ListView x:Name="PlaylistTracksListView"
                      ItemsSource="{Binding SelectedPlaylistForDetail.Tracks}"
                      PreviewMouseWheel="OnListViewPreviewMouseWheel"
                      Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="ContextMenu" Value="{DynamicResource TrackContextMenu}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="ItemBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="6,4">
                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#250078D4" />
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Track}">
                        <Border CornerRadius="8" Padding="6,4" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="3.5*" />
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="65" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 0: Index / Hover Play Button / Speaker Icon -->
                                <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TrackIndexText" Text="{Binding TrackNumber}"
                                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ui:SymbolIcon Symbol="Speaker224" FontSize="14"
                                                   Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>

                                    <Button x:Name="PlHoverPlayBtn"
                                            Background="Transparent" BorderThickness="0"
                                            Width="32" Height="32" Cursor="Hand" Opacity="0"
                                            Command="{Binding DataContext.PlayPlaylistTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="16" Background="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <ui:SymbolIcon Symbol="Play24" FontSize="13" Foreground="{Binding DataContext.Theme.AccentForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Column 1: Album Art Thumbnail -->
                                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="6" ClipToBounds="True" Background="#1C1C24" HorizontalAlignment="Center">
                                    <Image Source="{Binding CoverImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>

                                <!-- Column 2: Track Title -->
                                <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,12,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Foreground" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Column 3: Artist -->
                                <TextBlock Grid.Column="3" Text="{Binding Artist}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />

                                <!-- Column 4: Album -->
                                <TextBlock Grid.Column="4" Text="{Binding Album}" FontSize="12"
                                           Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,12,0" />

                                <!-- Column 5: Reorder & Remove Actions -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Move Up -->
                                    <Button Width="26" Height="26" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,2,0"
                                            ToolTip="Mover arriba en la lista"
                                            Command="{Binding DataContext.MoveTrackUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBdr" CornerRadius="4" Background="Transparent">
                                                    <ui:SymbolIcon Symbol="ChevronUp24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Move Down -->
                                    <Button Width="26" Height="26" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0" Margin="0,0,2,0"
                                            ToolTip="Mover abajo en la lista"
                                            Command="{Binding DataContext.MoveTrackDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBdr" CornerRadius="4" Background="Transparent">
                                                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Remove Track from Playlist -->
                                    <Button Width="26" Height="26" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                            ToolTip="Eliminar de esta lista"
                                            Command="{Binding DataContext.RemoveTrackFromPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBdr" CornerRadius="4" Background="Transparent">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBdr" Property="Background" Value="#26E81123" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- Column 6: Duration -->
                                <TextBlock Grid.Column="6" Text="{Binding DurationFormatted}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                <Setter TargetName="TrackIndexText" Property="Opacity" Value="0" />
                                <Setter TargetName="PlHoverPlayBtn" Property="Opacity" Value="1.0" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- ============================================================== -->
            <!-- 4. EMPTY STATE WHEN PLAYLIST HAS NO TRACKS                     -->
            <!-- ============================================================== -->
            <Border Margin="0,20,0,10" CornerRadius="12" Padding="32,28"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedPlaylistForDetail.TrackCount}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="36" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Tu lista de reproducción está vacía" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Agrega canciones desde tu biblioteca o explora las sugerencias a continuación"
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ============================================================== -->
            <!-- 5. COLLAPSIBLE SUGGESTED TRACKS SECTION                        -->
            <!-- ============================================================== -->
            <Border Margin="0,28,0,0" CornerRadius="12"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                    BorderThickness="1" Padding="20">
                <StackPanel>
                    <!-- Header with Clickable Toggle -->
                    <Grid Cursor="Hand">
                        <Grid.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleSuggestedSectionCommand}" />
                        </Grid.InputBindings>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="18" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Canciones sugeridas para esta lista" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Recomendaciones basadas en los géneros y artistas de tus canciones añadidas"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="28,4,0,0" />
                        </StackPanel>

                        <!-- Expand / Collapse Indicator Button -->
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="8,4" Cursor="Hand"
                                Command="{Binding ToggleSuggestedSectionCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{DynamicResource SurfaceCardHoverBrush}" Padding="10,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Ocultar" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Visibility="{Binding IsSuggestedExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                            <TextBlock Text="Mostrar sugerencias" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Visibility="{Binding IsSuggestedExpanded, Converter={StaticResource InverseBoolToVisConverter}}" />
                                            <ui:SymbolIcon Symbol="ChevronUp24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSuggestedExpanded, Converter={StaticResource BoolToVisConverter}}" />
                                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSuggestedExpanded, Converter={StaticResource InverseBoolToVisConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Collapsible Suggested Tracks List -->
                    <StackPanel Visibility="{Binding IsSuggestedExpanded, Converter={StaticResource BoolToVisConverter}}" Margin="0,18,0,0">
                        <ItemsControl ItemsSource="{Binding SuggestedTracks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Track}">
                                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,0,6"
                                            Background="{DynamicResource SurfaceCardBrush}"
                                            BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                                            BorderThickness="1"
                                            ContextMenu="{DynamicResource TrackContextMenu}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="3*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Thumbnail -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" ClipToBounds="True" Background="#1C1C24" HorizontalAlignment="Left">
                                                <Image Source="{Binding CoverImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <!-- Title -->
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Margin="10,0,10,0" />

                                            <!-- Artist -->
                                            <TextBlock Grid.Column="2" Text="{Binding Artist}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <!-- Album -->
                                            <TextBlock Grid.Column="3" Text="{Binding Album}" FontSize="12"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />

                                            <!-- Duration -->
                                            <TextBlock Grid.Column="4" Text="{Binding DurationFormatted}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />

                                            <!-- + Add Button -->
                                            <ui:Button Grid.Column="5" Appearance="Secondary" Padding="12,5"
                                                       Command="{Binding DataContext.AddSuggestedTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Add24" FontSize="13" Foreground="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,6,0" />
                                                    <TextBlock Text="Añadir" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </ui:Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Fallback when no recommendations found -->
                        <TextBlock Text="No hay más sugerencias disponibles para esta lista."
                                   FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,4">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SuggestedTracks.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
