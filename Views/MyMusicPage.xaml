<UserControl x:Class="BenyComes.Views.MyMusicPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:models="clr-namespace:BenyComes.Models"
             xmlns:vm="clr-namespace:BenyComes.ViewModels"
             xmlns:views="clr-namespace:BenyComes.Views"
             xmlns:wpftk="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="980">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/ArtistSectionTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared ContextMenu for Album Cards (prevents instantiating 1000+ context menus) -->
            <ContextMenu x:Key="SharedAlbumCardContextMenu">
                <MenuItem Header="Reproducir álbum"
                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=PlayAlbumCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Agregar a la cola de reproducción"
                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=MyMusic.AddAlbumToQueueCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Ver detalles del álbum"
                          Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=MyMusic.OpenAlbumDetailCommand}"
                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Album24" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0,16,0,10" />
                <Style.Triggers>
                    <!-- When viewing artist or album detail, remove the top spacing so it sits directly under the titlebar -->
                    <DataTrigger Binding="{Binding MyMusic.IsInDetailView}" Value="True">
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0. Page Title -->
            <RowDefinition Height="Auto" /> <!-- 1. Sub-tabs Selector -->
            <RowDefinition Height="Auto" /> <!-- 2. Persistent Toolbar Across All Tabs -->
            <RowDefinition Height="*" />    <!-- 3. Tab Content Area -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: PAGE TITLE                                              -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Margin="28,0,28,14">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <!-- In Detail Views (Artist or Album), Row 0 is hidden (They have their own hero banners without duplicate title) -->
                        <DataTrigger Binding="{Binding MyMusic.IsInDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MyMusic.SelectedArtistDetail, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding MyMusic.SelectedAlbumDetail, Converter={StaticResource NullToVisibilityConverter}}" Value="Visible">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="Mi música" />
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 1: MODERN SUB-TABS SELECTOR                                -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Margin="28,0,28,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MyMusic.IsInDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <!-- Canciones Tab -->
                <Button Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Margin="0,0,12,0" Padding="0" Cursor="Hand"
                        PreviewMouseLeftButtonDown="OnSongsTabPreviewMouseDown" Click="OnSongsTabClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabHitBox" Background="Transparent" CornerRadius="8" Padding="14,8,14,6">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TabText" Text="Canciones" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                    <Border x:Name="Indicator" Height="3" CornerRadius="1.5" Margin="0,6,0,0"
                                            Background="{Binding Theme.CurrentAccentBrush}" Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.2" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabHitBox" Property="Background" Value="#0DFFFFFF" />
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding MyMusic.SelectedTabIndex}" Value="0">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.4" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.2" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Artistas Tab -->
                <Button Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Margin="0,0,12,0" Padding="0" Cursor="Hand"
                        PreviewMouseLeftButtonDown="OnArtistsTabPreviewMouseDown" Click="OnArtistsTabClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabHitBox" Background="Transparent" CornerRadius="8" Padding="14,8,14,6">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TabText" Text="Artistas" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                    <Border x:Name="Indicator" Height="3" CornerRadius="1.5" Margin="0,6,0,0"
                                            Background="{Binding Theme.CurrentAccentBrush}" Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.2" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabHitBox" Property="Background" Value="#0DFFFFFF" />
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding MyMusic.SelectedTabIndex}" Value="1">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.4" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.2" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Álbumes Tab -->
                <Button Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" Margin="0,0,12,0" Padding="0" Cursor="Hand"
                        PreviewMouseLeftButtonDown="OnAlbumsTabPreviewMouseDown" Click="OnAlbumsTabClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TabHitBox" Background="Transparent" CornerRadius="8" Padding="14,8,14,6">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock x:Name="TabText" Text="Álbumes" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Normal" />
                                    <Border x:Name="Indicator" Height="3" CornerRadius="1.5" Margin="0,6,0,0"
                                            Background="{Binding Theme.CurrentAccentBrush}" Opacity="0"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0.2" ScaleY="1.0" />
                                        </Border.RenderTransform>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabHitBox" Property="Background" Value="#0DFFFFFF" />
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding MyMusic.SelectedTabIndex}" Value="2">
                                    <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.4" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1.0" Duration="0:0:0.4">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.3" />
                                                <DoubleAnimation Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.2" Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2: PERSISTENT TOOLBAR (REPRODUCIR ALEATORIAMENTE + FILTROS) -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" Margin="28,0,28,14">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MyMusic.IsInDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Play All Shuffled Button -->
            <ui:Button Grid.Column="0" Appearance="Primary" Padding="14,8"
                       Background="{Binding Theme.CurrentAccentBrush}"
                       Command="{Binding MyMusic.PlayAllShuffledCommand}"
                       ToolTip="Reproducir toda la música en orden aleatorio">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="16" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding MyMusic.ShuffleButtonText}"
                                FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="13" />
                </StackPanel>
            </ui:Button>

            <!-- Artists Tab Quick Setting: Buscar artistas con Last.fm & Download Status -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MyMusic.SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Border Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Globe24" FontSize="14" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Buscar artistas con Last.fm" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ui:ToggleSwitch IsChecked="{Binding MyMusic.IsLastFmArtistSyncEnabled, Mode=TwoWay}"
                                         OffContent="" OnContent="" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Non-blocking Download notification chip -->
                <Border Background="{DynamicResource SurfaceCardHoverBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4"
                        Visibility="{Binding MyMusic.IsDownloadingArtistImages, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing Width="12" Height="12" IsIndeterminate="True" Margin="0,0,6,0" Foreground="{Binding Theme.CurrentAccentBrush}" />
                        <TextBlock Text="{Binding MyMusic.ArtistDownloadProgressText}" FontSize="11" Foreground="{Binding Theme.CurrentAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Filters (Right aligned) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <!-- Ocultar filtros en pestaña Artistas (SelectedTabIndex == 1) -->
                            <DataTrigger Binding="{Binding MyMusic.SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Ordenar por:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="160" ItemsSource="{Binding MyMusic.SortOptions}"
                          SelectedItem="{Binding MyMusic.SelectedSort, Mode=TwoWay}"
                          Margin="0,0,6,0" />

                <!-- Ascending / Descending Sort Toggle Button -->
                <ui:Button Appearance="Transparent" Width="32" Height="32" Padding="0" Margin="0,0,8,0"
                           Command="{Binding MyMusic.ToggleSortDirectionCommand}"
                           ToolTip="{Binding MyMusic.SortDirectionTooltip}">
                    <ui:SymbolIcon Symbol="{Binding MyMusic.SortDirectionIcon}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                </ui:Button>

                <!-- JumpList Index Button (A-Z) - Only visible when sorting alphabetically by name -->
                <ui:Button Appearance="Transparent" Padding="6,4" Margin="0,0,14,0"
                           Command="{Binding MyMusic.OpenJumpListCommand}"
                           Visibility="{Binding MyMusic.IsNameSortActive, Converter={StaticResource BoolToVisConverter}}"
                           ToolTip="Abrir selector alfabético (JumpList)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="16" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,4,0" />
                        <TextBlock Text="A-Z" FontSize="12" FontWeight="Bold" Foreground="{Binding Theme.CurrentAccentBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>

                <TextBlock Text="Género:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="150" ItemsSource="{Binding MyMusic.Genres}"
                          SelectedItem="{Binding MyMusic.SelectedGenre, Mode=TwoWay}" />
            </StackPanel>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 3: TAB CONTENT CONTAINER (ANIMATED 500ms EASING)          -->
        <!-- ============================================================== -->
        <Grid Grid.Row="3">

            <!-- ========================================================== -->
            <!-- 1. TAB 0: CANCIONES (TABULAR FULL-WIDTH LISTVIEW)          -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MyMusic.SelectedTabIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="15" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MyMusic.IsInDetailView}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Column Header -->
                    <RowDefinition Height="*" />    <!-- Virtualized ListView -->
                </Grid.RowDefinitions>

                <!-- Fixed Column Header Bar -->
                <Grid Grid.Row="0" Margin="28,0,28,8" Visibility="{Binding MyMusic.Songs.Count, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="TÍTULO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" />
                    <TextBlock Grid.Column="2" Text="ARTISTA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="ÁLBUM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="4" Text="GÉNERO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="5" Text="DURACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                </Grid>

                <!-- Full-Width Virtualized Songs ListView -->
                <ListView x:Name="SongsListView" Grid.Row="1" ItemsSource="{Binding MyMusic.Songs}"
                          Visibility="{Binding MyMusic.Songs.Count, Converter={StaticResource BoolToVisConverter}}"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          VirtualizingPanel.CacheLength="1,1"
                          ScrollViewer.CanContentScroll="True"
                          AlternationCount="2"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnSongsListViewPreviewMouseWheel"
                          MouseDoubleClick="OnSongItemDoubleClick">

                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <StackPanel Margin="28,12,28,6">
                                                    <Button Style="{StaticResource AlphaGroupHeaderButtonStyle}"
                                                            Content="{Binding Name}"
                                                            Click="OnAlphaHeaderClick" />
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="OnSongItemDoubleClick" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="28,2,28,2" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="ContextMenu" Value="{DynamicResource TrackContextMenu}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="ItemBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="6,4">
                                            <ContentPresenter HorizontalAlignment="Stretch" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#250078D4" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="{DynamicResource TableRowAlternateBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Track}">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.8*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <!-- Col 0: 40x40 Album Art with Hover Play Button & Playing Indicator -->
                                <Grid Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border CornerRadius="6" ClipToBounds="True" Background="#1C1C26">
                                        <Image Source="{Binding CoverImageSource}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <!-- Playing animated indicator / badge overlay -->
                                    <Border x:Name="PlayingBadge" Background="#B3000000" CornerRadius="6" Visibility="Collapsed">
                                        <ui:SymbolIcon Symbol="Speaker224" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Hover Play Overlay Button -->
                                    <Button x:Name="HoverPlayButton"
                                            Background="#99000000" BorderThickness="0"
                                            Width="40" Height="40" Cursor="Hand" Opacity="0"
                                            Command="{Binding DataContext.MyMusic.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                                    <Path Data="M 4,2 L 16,10 L 4,18 Z" Fill="White" Stroke="{x:Null}" Width="14" Height="14" Margin="2,0,0,0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <!-- Col 1: Song Title -->
                                <TextBlock x:Name="SongTitleText" Grid.Column="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,10,0" />

                                <!-- Col 2: Artist (Invisible Button to redirect to Artist Detail) -->
                                <Button Grid.Column="2"
                                        Background="Transparent" BorderThickness="0" Padding="0,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                                        Cursor="Hand"
                                        ToolTip="Ir al artista"
                                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=NavigateToArtistCommand}"
                                        CommandParameter="{Binding Artist}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock x:Name="ArtistCellTxt"
                                                           Text="{Binding Artist}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ArtistCellTxt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter TargetName="ArtistCellTxt" Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Col 3: Album (Invisible Button to redirect to Album Detail) -->
                                <Button Grid.Column="3"
                                        Background="Transparent" BorderThickness="0" Padding="0,2"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0"
                                        Cursor="Hand"
                                        ToolTip="Ir al álbum"
                                        Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=NavigateToAlbumCommand}"
                                        CommandParameter="{Binding Album}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock x:Name="AlbumCellTxt"
                                                           Text="{Binding Album}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="AlbumCellTxt" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter TargetName="AlbumCellTxt" Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Col 4: Genre Badge -->
                                <Border Grid.Column="4" Background="{DynamicResource SurfaceCardHoverBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Genre}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                </Border>

                                <!-- Col 5: Favorite Heart & Duration -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Button Width="26" Height="26" Padding="0" Margin="0,0,6,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Agregar o quitar de Favoritos"
                                            Command="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="FavBdr" CornerRadius="5" Background="Transparent">
                                                    <ui:SymbolIcon x:Name="FavIcon" Symbol="Heart24" FontSize="14"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="FavBdr" Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter TargetName="FavIcon" Property="Filled" Value="True" />
                                                        <Setter TargetName="FavIcon" Property="Foreground" Value="#FFE81123" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Text="{Binding DurationFormatted}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                    <Setter TargetName="HoverPlayButton" Property="Opacity" Value="1.0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="SongTitleText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="SongTitleText" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="PlayingBadge" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State for Songs Tab -->
                <Border Grid.Row="1" Visibility="{Binding MyMusic.Songs.Count, Converter={StaticResource InverseBoolToVisConverter}}"
                        Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28,36" Margin="10,20,10,20"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="520">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1AEAB308" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="28" Foreground="#FFEAB308" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No hay canciones por aquí todavía" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Tu biblioteca no tiene canciones cargadas con los filtros actuales. Prueba a indexar tus carpetas de música o restablecer los filtros."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />
                        <ui:Button Appearance="Primary" Padding="16,8" HorizontalAlignment="Center"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Indexar biblioteca en Configuración" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="13" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ========================================================== -->
            <!-- 2. TAB 1: ARTISTAS (GRID & DETAIL VIEW)                    -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MyMusic.SelectedTabIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="15" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 2.A ARTIST GRID CONTAINER (When no detail view is open) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MyMusic.IsInDetailView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Banner no bloqueante de descarga de fotos de artistas -->
                    <Border Grid.Row="0" Margin="28,0,28,12" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8"
                            Visibility="{Binding MyMusic.IsDownloadingArtistImages, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" Margin="0,0,10,0" Foreground="{Binding Theme.CurrentAccentBrush}" />
                            <TextBlock Text="{Binding MyMusic.ArtistDownloadProgressText}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <ListView Grid.Row="1" x:Name="ArtistsListView"
                              ItemsSource="{Binding MyMusic.ArtistSections}"
                              Tag="{Binding MyMusic}"
                              Background="Transparent" BorderThickness="0"
                              Padding="28,0,28,0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch"
                              PreviewMouseWheel="OnArtistsListViewPreviewMouseWheel"
                              ItemTemplate="{StaticResource SharedArtistLetterSectionTemplate}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Empty State for Artists Tab -->
                    <Border Visibility="{Binding MyMusic.Artists.Count, Converter={StaticResource InverseBoolToVisConverter}}"
                            Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="28,36" Margin="10,20,10,20"
                            HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="520">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#1A10B981" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <ui:SymbolIcon Symbol="Person24" FontSize="28" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No hay artistas por aquí todavía" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="No encontramos artistas en tu colección según los filtros activos. Añade carpetas de música para empezar a armar tu catálogo."
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />
                            <ui:Button Appearance="Primary" Padding="16,8" HorizontalAlignment="Center"
                                       Background="{Binding Theme.CurrentAccentBrush}"
                                       Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Indexar biblioteca en Configuración" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="13" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================== -->
            <!-- 3. TAB 2: ÁLBUMES (GRID & DETAIL VIEW)                     -->
            <!-- ========================================================== -->
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform Y="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MyMusic.SelectedTabIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible" />
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.0" To="1.0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             From="15" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 3.A ALBUM GRID (When no detail view is open) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MyMusic.IsInDetailView}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <ListView x:Name="AlbumsListView" ItemsSource="{Binding MyMusic.Albums}"
                              Visibility="{Binding MyMusic.Albums.Count, Converter={StaticResource BoolToVisConverter}}"
                              Background="Transparent" BorderThickness="0"
                              Padding="28,0,28,0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLengthUnit="Page"
                              VirtualizingPanel.CacheLength="1,1"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <wpftk:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="None" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AlbumModel}">
                            <Border Style="{StaticResource ScaleCardBorderStyle}" Width="176" Margin="0,0,20,24" CornerRadius="12"
                                    Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}" BorderThickness="1" Padding="8" Cursor="Hand"
                                    ContextMenu="{StaticResource SharedAlbumCardContextMenu}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.MyMusic.OpenAlbumDetailCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <!-- Square 160x160 Album Art Container with Hover Overlay -->
                                    <Grid Width="160" Height="160" HorizontalAlignment="Center">
                                        <!-- Album Cover Image -->
                                        <Border CornerRadius="6" ClipToBounds="True" Background="#1F1F28">
                                            <Image Source="{Binding CoverImageSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="LowQuality" />
                                        </Border>

                                        <!-- Hover Overlay with 0.2s Fade-In -->
                                        <Border x:Name="AlbumHoverOverlay" CornerRadius="6" Background="#66000000" Opacity="0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Left Button: Play -->
                                                <Button Width="44" Height="44" Cursor="Hand" ToolTip="Reproducir todo"
                                                        Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="BtnBg" Width="44" Height="44" CornerRadius="22"
                                                                    Background="#CC1E1E1E" BorderBrush="#40FFFFFF" BorderThickness="1"
                                                                    RenderTransformOrigin="0.5,0.5">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                                </Border.RenderTransform>
                                                                <Path Data="M 4,2 L 16,10 L 4,18 Z" Fill="White" Stroke="{x:Null}" Width="16" Height="16" Margin="2,0,0,0" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="BtnBg" Property="Background" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=ListView}}" />
                                                                    <Setter TargetName="BtnBg" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Right Button: Add (+) -->
                                                <Button Width="44" Height="44" Margin="10,0,0,0" Cursor="Hand" ToolTip="Agregar a..."
                                                        Click="OnAddMenuButtonClick">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Agregar a la cola de reproducción"
                                                                      Command="{Binding DataContext.MyMusic.AddAlbumToQueueCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                                      CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <ui:SymbolIcon Symbol="Add24" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="BtnBg" Width="44" Height="44" CornerRadius="22"
                                                                    Background="#CC1E1E1E" BorderBrush="#40FFFFFF" BorderThickness="1"
                                                                    RenderTransformOrigin="0.5,0.5">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                                                </Border.RenderTransform>
                                                                <ui:SymbolIcon Symbol="Add24" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="BtnBg" Property="Background" Value="#E62A2A2A" />
                                                                    <Setter TargetName="BtnBg" Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <ScaleTransform ScaleX="1.1" ScaleY="1.1" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Bottom Text -->
                                    <StackPanel Margin="0,8,0,0" Width="160">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock Text="{Binding Artist}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Artist}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="AlbumHoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1.0" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="AlbumHoverOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.0" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State for Albums Tab -->
                <Border Visibility="{Binding MyMusic.Albums.Count, Converter={StaticResource InverseBoolToVisConverter}}"
                        Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="28,36" Margin="10,20,10,20"
                        HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="520">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="32" Background="#1A8B5CF6" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <ui:SymbolIcon Symbol="Album24" FontSize="28" Foreground="#FF8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No hay álbumes por aquí todavía" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="No encontramos álbumes asociados a las pistas filtradas en tu biblioteca. Explora las carpetas agregadas en configuración para actualizar."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,20" />
                        <ui:Button Appearance="Primary" Padding="16,8" HorizontalAlignment="Center"
                                   Background="{Binding Theme.CurrentAccentBrush}"
                                   Command="{Binding DataContext.NavigateToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                   CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="16" Foreground="{Binding Theme.AccentForegroundBrush}" Margin="0,0,8,0" />
                                <TextBlock Text="Indexar biblioteca en Configuración" FontWeight="Bold" Foreground="{Binding Theme.AccentForegroundBrush}" FontSize="13" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Border>
                </Grid>
            </Grid>

            <!-- ========================================================== -->
            <!-- UNIFIED DETAIL VIEWS (Reusable InfoArtista & InfoAlbum)    -->
            <!-- Placed at root of Content Grid so opening an album inside  -->
            <!-- InfoArtista works regardless of SelectedTabIndex           -->
            <!-- ========================================================== -->
            <views:InfoArtista Margin="28,16,28,0"
                               Artist="{Binding MyMusic.SelectedArtistDetail}"
                               PlayArtistCommand="{Binding MyMusic.PlayArtistCommand}"
                               PlayTrackCommand="{Binding MyMusic.PlayTrackCommand}"
                               TrackContextMenu="{DynamicResource TrackContextMenu}" />

            <views:InfoAlbum Margin="28,16,28,0"
                             Album="{Binding MyMusic.SelectedAlbumDetail}"
                             OpenArtistByNameCommand="{Binding NavigateToArtistCommand}"
                             PlayTrackCommand="{Binding MyMusic.PlayTrackCommand}"
                             TrackContextMenu="{DynamicResource TrackContextMenu}" />

            <!-- ========================================================== -->
            <!-- CENTRAL LOADING OVERLAY                                    -->
            <!-- ========================================================== -->
            <Grid Visibility="{Binding MyMusic.IsLoading, Converter={StaticResource BoolToVisConverter}}"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="50" Height="50" HorizontalAlignment="Center">
                        <Path Data="M 25,5 A 20,20 0 1,1 5,25"
                              Stroke="{DynamicResource AccentBrush}"
                              StrokeThickness="4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Border>
                    <TextBlock Text="Cargando..."
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="18"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0.5" To="1.0" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- ============================================================== -->
        <!-- JUMPLIST WINDOWS-STYLE MODAL SELECTOR (29 LETTERS)             -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Margin="-28,-16,-28,-10"
              Visibility="{Binding MyMusic.IsJumpListOpen, Converter={StaticResource BoolToVisConverter}}"
              Background="#CC09090E" ClipToBounds="True">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding MyMusic.CloseJumpListCommand}" />
            </Grid.InputBindings>

            <Border Width="440" MaxWidth="500" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000" />
                </Border.Effect>
                <Border.InputBindings>
                    <!-- Stop click bubbling so clicking inside the card does not close it -->
                    <MouseBinding MouseAction="LeftClick" Command="{x:Null}" />
                </Border.InputBindings>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="TextBulletListSquare24" FontSize="18" Foreground="{Binding Theme.CurrentAccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Ir a letra o grupo" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Appearance="Transparent" HorizontalAlignment="Right" Padding="6"
                                   Command="{Binding MyMusic.CloseJumpListCommand}"
                                   ToolTip="Cerrar">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </ui:Button>
                    </Grid>

                    <!-- 29 Letter Grid (6 columns) -->
                    <ItemsControl ItemsSource="{Binding MyMusic.JumpListLetters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:JumpListLetterItem}">
                                <Button Margin="4" Width="48" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                                        Command="{Binding DataContext.MyMusic.SelectJumpLetterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Letter}"
                                        IsEnabled="{Binding HasItems}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBorder" Width="48" Height="44" CornerRadius="8" BorderThickness="1.5"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent">
                                                <TextBlock x:Name="BtnText" Text="{Binding Letter}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HasItems}" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="Transparent" />
                                                    <Setter TargetName="BtnText" Property="FontWeight" Value="SemiBold" />
                                                    <Setter TargetName="BtnText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                                    <Setter TargetName="BtnBorder" Property="Opacity" Value="0.25" />
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="Transparent" />
                                                    <Setter TargetName="BtnText" Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF" />
                                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{Binding DataContext.Theme.CurrentAccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    <Setter TargetName="BtnText" Property="Foreground" Value="#FFFFFF" />
                                                    <Setter TargetName="BtnText" Property="FontWeight" Value="Bold" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
