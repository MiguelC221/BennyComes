<Window x:Class="BenyComes.Views.LastFmWebLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:BenyComes.ViewModels"
        Title="Iniciar sesión con Last.fm"
        Width="560" Height="690"
        MinWidth="460" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Border Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="{DynamicResource SurfaceCardBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="14"
            ClipToBounds="True"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,12"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                            Background="#22E31B23" BorderBrush="#44E31B23" BorderThickness="1"
                            Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="18" Foreground="#FFE31B23"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Conectar cuenta de Last.fm"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SubtitleStatusText"
                                   Text="Inicia sesión con tu usuario de Last.fm para activar el Scrobbling"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Width="32" Height="32" Cursor="Hand"
                            Click="OnCancelClick" ToolTip="Cerrar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBdr" Background="Transparent" CornerRadius="6">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBdr" Property="Background" Value="#26FF4D4D" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Center WebView2 Container -->
            <Grid Grid.Row="1" Background="#14151C">
                <wv2:WebView2 x:Name="BrowserView" />

                <!-- Loading / Automating Overlay -->
                <Border x:Name="LoadingOverlay"
                        Background="#D812131A"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <ui:ProgressRing Width="38" Height="38" IsIndeterminate="True"
                                         Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}"
                                         HorizontalAlignment="Center" Margin="0,0,0,14" />
                        <TextBlock x:Name="OverlayStatusText"
                                   Text="Cargando inicio de sesión de Last.fm..."
                                   FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="OverlaySubStatusText"
                                   Text="Solo necesitas ingresar tu cuenta de Last.fm."
                                   FontSize="11.5"
                                   Foreground="#B0B8C8"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="15"
                                       Foreground="{Binding Source={x:Static vm:MainViewModel.Instance}, Path=Theme.CurrentAccentBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Autenticación directa con Last.fm (WebView seguro)"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ui:Button Grid.Column="1" Appearance="Secondary" Content="Cancelar"
                               Padding="14,5" Click="OnCancelClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
