<Application x:Class="BenyComes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:BenyComes.Converters"
             xmlns:local="clr-namespace:BenyComes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:PlayPauseSymbolConverter x:Key="PlayPauseSymbolConverter" />
            <converters:RepeatModeToSymbolConverter x:Key="RepeatModeToSymbolConverter" />
            <converters:VolumeToSymbolConverter x:Key="VolumeToSymbolConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <converters:ScrollBarMinThumbViewportConverter x:Key="ScrollBarMinThumbViewportConverter" MinThumbLength="56" />

            <!-- Theme Dynamic Palette Brushes -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F0F12" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#1C1C22" />
            <SolidColorBrush x:Key="CardSurfaceBrush" Color="#1C1C22" />
            <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SurfaceCardHoverBrush" Color="#2A2A34" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0FFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#70FFFFFF" />
            <SolidColorBrush x:Key="NavPaneBackgroundBrush" Color="#14141C" />
            <SolidColorBrush x:Key="DividerBrush" Color="#18FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="ScrollBarThumbDraggingBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="MiniPlayerBackgroundBrush" Color="#1C1D24" />
            <SolidColorBrush x:Key="AccentBrush" Color="#00D26A" />
            <SolidColorBrush x:Key="SystemAccentBrush" Color="#00D26A" />
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

            <!-- ToggleSwitch & Slider Theme Brushes -->
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#8E929B" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#282930" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#D0D0D5" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffHover" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffHover" Color="#383944" />
            <SolidColorBrush x:Key="SliderTrackUnfilledBrush" Color="#35FFFFFF" />

            <!-- Rank Badges Brushes -->
            <SolidColorBrush x:Key="Rank1BadgeBackgroundBrush" Color="#40FFD700" />
            <SolidColorBrush x:Key="Rank1BadgeBorderBrush" Color="#FFD700" />
            <SolidColorBrush x:Key="Rank1BadgeForegroundBrush" Color="#FFE066" />
            <SolidColorBrush x:Key="Rank2BadgeBackgroundBrush" Color="#40E0E0E0" />
            <SolidColorBrush x:Key="Rank2BadgeBorderBrush" Color="#E0E0E0" />
            <SolidColorBrush x:Key="Rank2BadgeForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Rank3BadgeBackgroundBrush" Color="#40CD7F32" />
            <SolidColorBrush x:Key="Rank3BadgeBorderBrush" Color="#CD7F32" />
            <SolidColorBrush x:Key="Rank3BadgeForegroundBrush" Color="#FFA07A" />
            <SolidColorBrush x:Key="RankDefaultBadgeBackgroundBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="RankDefaultBadgeBorderBrush" Color="Transparent" />

            <!-- Clean Circular Play/Pause Button Style -->
            <Style x:Key="CircularPlayPauseButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CircleBorder" Width="44" Height="44" CornerRadius="22"
                                    Background="{TemplateBinding Background}" BorderThickness="0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                </Border.RenderTransform>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Play Icon (Center aligned triangle) -->
                                    <Path x:Name="PlayPath"
                                          Data="M 0,0 L 0,16 L 14,8 Z"
                                          Fill="White" Stroke="{x:Null}"
                                          Width="14" Height="16"
                                          Margin="2,0,0,0"
                                          Stretch="Fill"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <!-- Pause Icon (Center aligned bars) -->
                                    <Path x:Name="PausePath"
                                          Data="M 6,4 L 10,4 L 10,20 L 6,20 Z M 14,4 L 18,4 L 18,20 L 14,20 Z"
                                          Fill="White" Stroke="{x:Null}"
                                          Width="14" Height="16"
                                          Stretch="Fill"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter TargetName="PlayPath" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="PausePath" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding NowPlaying.IsPlaying}" Value="True">
                                    <Setter TargetName="PlayPath" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="PausePath" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CircleBorder" Property="Opacity" Value="0.9" />
                                    <Setter TargetName="CircleBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CircleBorder" Property="Opacity" Value="0.8" />
                                    <Setter TargetName="CircleBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================== -->
            <!-- MODERN FILLED SLIDER STYLE (SEEKBAR & VOLUME)  -->
            <!-- ============================================== -->
            <Style x:Key="ModernSliderThumbStyle" TargetType="Thumb">
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbBorder" Width="14" Height="14" CornerRadius="7"
                                    Background="#FFFFFF"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Opacity="0.45" Color="#000000" />
                                </Border.Effect>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Width" Value="16" />
                                    <Setter TargetName="ThumbBorder" Property="Height" Value="16" />
                                    <Setter TargetName="ThumbBorder" Property="CornerRadius" Value="8" />
                                    <Setter TargetName="ThumbBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.55" Color="#000000" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#FFFFFF" />
                                    <Setter TargetName="ThumbBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.60" Color="#000000" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernSliderDecreaseRepeatButtonStyle" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Grid Background="Transparent" Height="22" VerticalAlignment="Center">
                                <Border Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Color="#000000" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernSliderIncreaseRepeatButtonStyle" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Grid Background="Transparent" Height="22" VerticalAlignment="Center">
                                <Border Height="6" CornerRadius="3" Background="{DynamicResource SliderTrackUnfilledBrush}" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.15" Color="#000000" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Slider">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
                <Setter Property="IsMoveToPointEnabled" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Border Background="Transparent" Padding="0,3" VerticalAlignment="Center">
                                <Grid Background="Transparent" Height="22" VerticalAlignment="Center">
                                    <!-- Full background track with shadow underneath so unfilled portion is always visible with depth -->
                                    <Border Height="6" CornerRadius="3" Background="{DynamicResource SliderTrackUnfilledBrush}" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.20" Color="#000000" />
                                        </Border.Effect>
                                    </Border>
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource ModernSliderDecreaseRepeatButtonStyle}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernSliderThumbStyle}" VerticalAlignment="Center" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource ModernSliderIncreaseRepeatButtonStyle}" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Technical Pill Badge Style -->
            <Style x:Key="TechBadgeStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Background" Value="#33FFFFFF" />
                <Setter Property="BorderBrush" Value="#44FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="TechBadgeHighlightStyle" TargetType="Border" BasedOn="{StaticResource TechBadgeStyle}">
                <Setter Property="Background" Value="#4D00D26A" />
                <Setter Property="BorderBrush" Value="#8000FF85" />
            </Style>

            <!-- Glass Panel Style -->
            <Style x:Key="GlassPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="#E612131A" />
                <Setter Property="BorderBrush" Value="#2AFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.5" ShadowDepth="6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================== -->
            <!-- MODERN FLUENT SCROLLBAR STYLE (MATCHING USER SCREENSHOT)       -->
            <!-- ============================================================== -->

            <!-- Transparent Track RepeatButton for PageUp / PageDown -->
            <Style x:Key="ScrollBarTrackPageButtonStyle" TargetType="{x:Type RepeatButton}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Rectangle Fill="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Line Arrow Button Style (Top/Bottom/Left/Right subtle triangles) -->
            <Style x:Key="ScrollBarLineArrowButtonStyle" TargetType="{x:Type RepeatButton}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#66FFFFFF" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#D0FFFFFF" />
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#15FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Vertical Thumb Pill Style -->
            <Style x:Key="ScrollBarVerticalThumbStyle" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid Background="Transparent" MinHeight="56">
                                <Border x:Name="ThumbPill"
                                        Width="6"
                                        MinHeight="56"
                                        HorizontalAlignment="Center"
                                        CornerRadius="3"
                                        Background="{DynamicResource ScrollBarThumbBrush}"
                                        Margin="0,1" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbPill" Property="Width" Value="8" />
                                    <Setter TargetName="ThumbPill" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbPill" Property="Width" Value="8" />
                                    <Setter TargetName="ThumbPill" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource ScrollBarThumbDraggingBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Horizontal Thumb Pill Style -->
            <Style x:Key="ScrollBarHorizontalThumbStyle" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid Background="Transparent" MinWidth="56">
                                <Border x:Name="ThumbPill"
                                        Height="6"
                                        MinWidth="56"
                                        VerticalAlignment="Center"
                                        CornerRadius="3"
                                        Background="{DynamicResource ScrollBarThumbBrush}"
                                        Margin="1,0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbPill" Property="Height" Value="8" />
                                    <Setter TargetName="ThumbPill" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbPill" Property="Height" Value="8" />
                                    <Setter TargetName="ThumbPill" Property="CornerRadius" Value="4" />
                                    <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource ScrollBarThumbDraggingBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Global Universal ScrollBar Style -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="ContextMenu" Value="{x:Null}" />
                <Style.Triggers>
                    <!-- Vertical ScrollBar -->
                    <Trigger Property="Orientation" Value="Vertical">
                        <Setter Property="Width" Value="14" />
                        <Setter Property="MinWidth" Value="14" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" SnapsToDevicePixels="True" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top LineUp Button (▲) -->
                                        <RepeatButton Grid.Row="0"
                                                      Height="14"
                                                      Style="{StaticResource ScrollBarLineArrowButtonStyle}"
                                                      Command="{x:Static ScrollBar.LineUpCommand}">
                                            <Path Data="M 1,5 L 4.5,1.5 L 8,5 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                                  Width="9" Height="6" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </RepeatButton>

                                        <!-- Track with PageUp, Thumb, PageDown -->
                                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                            <Track.ViewportSize>
                                                <MultiBinding Converter="{StaticResource ScrollBarMinThumbViewportConverter}">
                                                    <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Track.ViewportSize>
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarTrackPageButtonStyle}"
                                                              Command="{x:Static ScrollBar.PageUpCommand}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollBarVerticalThumbStyle}" MinHeight="56" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarTrackPageButtonStyle}"
                                                              Command="{x:Static ScrollBar.PageDownCommand}" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>

                                        <!-- Bottom LineDown Button (▼) -->
                                        <RepeatButton Grid.Row="2"
                                                      Height="14"
                                                      Style="{StaticResource ScrollBarLineArrowButtonStyle}"
                                                      Command="{x:Static ScrollBar.LineDownCommand}">
                                            <Path Data="M 1,1 L 4.5,4.5 L 8,1 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                                  Width="9" Height="6" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </RepeatButton>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#0AFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>

                    <!-- Horizontal ScrollBar -->
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Height" Value="14" />
                        <Setter Property="MinHeight" Value="14" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" SnapsToDevicePixels="True" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left LineLeft Button (◀) -->
                                        <RepeatButton Grid.Column="0"
                                                      Width="14"
                                                      Style="{StaticResource ScrollBarLineArrowButtonStyle}"
                                                      Command="{x:Static ScrollBar.LineLeftCommand}">
                                            <Path Data="M 5,1 L 1.5,4.5 L 5,8 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                                  Width="6" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </RepeatButton>

                                        <!-- Track with PageLeft, Thumb, PageRight -->
                                        <Track x:Name="PART_Track" Grid.Column="1">
                                            <Track.ViewportSize>
                                                <MultiBinding Converter="{StaticResource ScrollBarMinThumbViewportConverter}">
                                                    <Binding Path="ViewportSize" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Track.ViewportSize>
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarTrackPageButtonStyle}"
                                                              Command="{x:Static ScrollBar.PageLeftCommand}" />
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollBarHorizontalThumbStyle}" MinWidth="56" />
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Style="{StaticResource ScrollBarTrackPageButtonStyle}"
                                                              Command="{x:Static ScrollBar.PageRightCommand}" />
                                            </Track.IncreaseRepeatButton>
                                        </Track>

                                        <!-- Right LineRight Button (▶) -->
                                        <RepeatButton Grid.Column="2"
                                                      Width="14"
                                                      Style="{StaticResource ScrollBarLineArrowButtonStyle}"
                                                      Command="{x:Static ScrollBar.LineRightCommand}">
                                            <Path Data="M 1,1 L 4.5,4.5 L 1,8 Z"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}"
                                                  Width="6" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </RepeatButton>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#0AFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
